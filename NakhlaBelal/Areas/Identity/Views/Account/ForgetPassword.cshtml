@model NakhlaBelal.ViewModels.ForgetPasswordVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = @SharedLocalizer["Forget Password"];
}

<div class="container w-50">

    <h1>@SharedLocalizer["Forget Password"]</h1>

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ForgetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="UserNameOREmail" class="control-label fs-4">@SharedLocalizer["Enter Your Username or Email"]</label>
                    <input asp-for="UserNameOREmail" class="form-control text-muted mt-3" style="background-color: var(--jade-color) !important;" placeholder="@SharedLocalizer["Username or Email"]" />
                    <span asp-validation-for="UserNameOREmail" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="@SharedLocalizer["Submit"]" style="background-color: var(--evergreen-color) !important; border: none; color:var(--cotton-color);" class="btn btn-primary my-3" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="Login">@SharedLocalizer["Back to Login"]</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}