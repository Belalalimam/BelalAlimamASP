@model NakhlaBelal.ViewModels.RegisterVM
@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer


<div class="Samebody">
    <div class="container2" id="container2 border1">
        <div class="form-container sign-up">

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <h1>@SharedLocalizer["CreateAccount"]</h1>

                <div class="social-icons">
                    <a href="#" class="icon"><i class="ri-google-line"></i></a>
                    <a href="#" class="icon"><i class="ri-facebook-line"></i></a>
                    <a href="#" class="icon"><i class="ri-github-line"></i></a>
                    <a href="#" class="icon"><i class="ri-linkedin-line"></i></a>
                </div>

                <span>@SharedLocalizer["OrUseEmailForRegistration"]</span>

                <!-- Validation summary -->
                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="FirstName" placeholder="@SharedLocalizer["First Name"]" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

                <input asp-for="LastName" placeholder="@SharedLocalizer["Last Name"]" />
                <span asp-validation-for="LastName" class="text-danger"></span>

                <input asp-for="Email" placeholder="@SharedLocalizer["Email"]" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <input asp-for="UserName" placeholder="@SharedLocalizer["UserName"]" />
                <span asp-validation-for="UserName" class="text-danger"></span>

                <input asp-for="Password" placeholder="@SharedLocalizer["Password"]" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <input asp-for="ConfirmPassword" placeholder="@SharedLocalizer["ConfirmPassword"]" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                <button type="submit">@SharedLocalizer["Sign Up"]</button>

                <p class="mt-3">
                    @SharedLocalizer["AlreadyHaveAnAccount"]
                    <a asp-action="Login" asp-controller="Account">@SharedLocalizer["Login"]</a>
                </p>
            </form>

        </div>
    </div>
</div>

@if (TempData["RegistrationSuccess"] != null)
{
    <script>
        Swal.fire({
            title: '@SharedLocalizer["SuccessTitle"]',
            text: '@SharedLocalizer["RegistrationSuccess"]', // نادِ المفتاح مباشرة كنص ثابت
            icon: 'success',
            confirmButtonColor: '#013220',
            confirmButtonText: '@SharedLocalizer["GreatText"]',
            customClass: { popup: 'swal-rtl' }
        });
    </script>
    TempData["RegistrationSuccess"] = null;
}