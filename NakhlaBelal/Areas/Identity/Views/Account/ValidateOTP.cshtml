@model NakhlaBelal.ViewModels.ValidateOTPVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = "ValidateOTPVM";
}

<div class="container w-50">
    <h1>@SharedLocalizer["ValidateOTP"]</h1>

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ValidateOTP">
                <input type="hidden" name="ApplicationUserId" value="@Model.ApplicationUserId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="OTP" class="control-label">@SharedLocalizer["OTP Number"]</label>
                    <input asp-for="OTP" class="form-control tetext-muted mt-3" style="background-color: var(--jade-color) !important;" placeholder="@SharedLocalizer["Enter Your OTP Number"]" />
                    <span asp-validation-for="OTP" class="text-danger"></span>
                </div>
                <div class="form-group mt-3"> 
                    <input type="submit" value=@SharedLocalizer["Submit"] style="background-color: var(--evergreen-color) !important; border: none; color:var(--cotton-color);" class="btn btn-primary my-3" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}