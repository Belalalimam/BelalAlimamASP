@model NakhlaBelal.ViewModels.NewPasswordVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NewPassword"];
}

<div class="container w-50">
    <h1>@SharedLocalizer["NewPassword"]</h1>

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="NewPassword">
                <input type="hidden" name="ApplicationUserId" value="@Model.ApplicationUserId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Password" class="control-label">@SharedLocalizer["Password"]</label>
                    <input asp-for="Password" class="form-control tetext-muted mt-3" style="background-color: var(--jade-color) !important;" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="control-label">@SharedLocalizer["ConfirmPassword"]</label>
                    <input asp-for="ConfirmPassword" class="form-control text-muted mt-3" style="background-color: var(--jade-color) !important;" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="@SharedLocalizer["Submit"]" style="background-color: var(--evergreen-color) !important; border: none; color:var(--cotton-color);" class="btn btn-primary my-3" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}