@model NakhlaBelal.ViewModels.LoginVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer


<div class="Samebody">
    <div class="container2">
        <div class="form-container sign-in">

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <h1>@SharedLocalizer["Login"]</h1>

                <div class="social-icons">
                    <a href="#" class="icon"><i class="ri-google-line"></i></a>
                    <a href="#" class="icon"><i class="ri-facebook-line"></i></a>
                    <a href="#" class="icon"><i class="ri-github-line"></i></a>
                    <a href="#" class="icon"><i class="ri-linkedin-line"></i></a>
                </div>

                <span class="LoginSpanEdited">@SharedLocalizer["or use your account"]</span>

                <!-- Validation summary -->
                <div asp-validation-summary="All" class="text-danger"></div>

                <input asp-for="UserNameOREmail" placeholder="@SharedLocalizer["Username or Email"]" />
                <span asp-validation-for="UserNameOREmail" class="text-danger"></span>

                <input asp-for="Password" type="password" placeholder="@SharedLocalizer["Password"]" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <button class="LoginButton" type="submit">@SharedLocalizer["Login"]</button>

                <p class="mt-3 LoginSpanEdited">
                    @SharedLocalizer["Don't have an account?"]
                    <a asp-action="Register" asp-controller="Account">@SharedLocalizer["Sign Up"]</a>
                </p>
                <p class="mt-3 LoginSpanEdited">                    
                    <a asp-action="ResendEmailConfirmation">@SharedLocalizer["Resend Email Confirmation"]</a>
                </p>
                <p class="mt-3 LoginSpanEdited">                    
                    <a asp-action="ForgetPassword">@SharedLocalizer["Forget Password"]</a>
                </p>
            </form>

        </div>
    </div>
</div>
