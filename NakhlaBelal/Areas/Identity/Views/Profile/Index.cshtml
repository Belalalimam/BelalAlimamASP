@model ApplicationUserVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
@section Scripts {
    <partial name="_NotificationPartial" />
}

<div class="container">
    <div class="row gutters my-3">
        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
            <div class="card h-100">
                <div class="card-body BodyOfProfial">
                    <div class="account-settings ">
                        <div class="user-profile">
                            <div class="user-avatar">
                                <img src="https://bootdey.com/img/Content/avatar/avatar7.png" alt="Maxwell Admin" style="width: 90px">
                            </div>
                            <h5 class="user-name">@Model.FullName</h5>
                            <h6 class="user-email">@Model.Email</h6>
                        </div>
                        <div class="about">
                            <h5>@SharedLocalizer["ABOUT"]</h5>
                            <p>I'm Yuki. Full Stack Designer I enjoy creating user-centric, delightful and human experiences.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12  ">
            <form asp-action="UpdateProfile" class="my-3 ">
                <div class="card-body BodyOfProfial py-5 px-4">
                    <div class="row gutters">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 DetailsContainer">
                            <h3 class="mb-2 ">@SharedLocalizer["Personal Details"]</h3>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label for="firstName">@SharedLocalizer["First Name"]</label>
                                <input class="form-control" asp-for="FirstName" id="firstName" placeholder="@SharedLocalizer["Enter First Name"]">
                            </div>
                            <div class="form-group">
                                <label for="lastName">@SharedLocalizer["Last Name"]</label>
                                <input class="form-control" asp-for="LastName" id="lastName" placeholder="@SharedLocalizer["Enter Last Name"]">
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label for="eMail">@SharedLocalizer["Email"]</label>
                                <input disabled asp-for="Email" class="form-control" placeholder="@SharedLocalizer["Enter email ID"]">
                            </div>
                            <div class="form-group">
                                <label for="phone">@SharedLocalizer["Phone"]</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="@SharedLocalizer["Enter phone number"]">
                            </div>
                        </div>

                    </div>

                    <div class="row gutters">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 DetailsContainer">
                            <h3 class="mt-3 mb-2">@SharedLocalizer["Address"]</h3>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label for="Address">@SharedLocalizer["Street Address"]</label>
                                <input class="form-control" asp-for="Address" id="Address" placeholder="@SharedLocalizer["Enter full Street Address"]">
                            </div>
                            <div class="form-group">
                                <label for="City">@SharedLocalizer["Town / City"]</label>
                                <input class="form-control" asp-for="City" id="City" placeholder="@SharedLocalizer["Enter your Town / City"]">
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">    
                                <label for="State">@SharedLocalizer["State"]</label>
                                <input class="form-control" asp-for="State" id="State" placeholder="@SharedLocalizer["Enter your State"]">
                            </div>
                            <div class="form-group">
                                <label for="ZipCode">@SharedLocalizer["Postcode / ZIP"]</label>
                                <input class="form-control" asp-for="ZipCode" id="ZipCode" placeholder="@SharedLocalizer["Enter ZipCode"]   ">
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label for="Country">@SharedLocalizer["Country"]</label>
                                <input class="form-control" asp-for="Country" id="Country" placeholder="@SharedLocalizer["Enter your Country"]">
                            </div>
                        </div>
                    </div>

                    <div class="row gutters my-3">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="text-right">
                                <button type="reset" id="submit" name="submit" class="Cancel-link">@SharedLocalizer["Cancel"]</button>
                                <button type="submit" id="submit" name="submit" class="Update-link">@SharedLocalizer["Update"]</button>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
            <form asp-action="UpdatePassword" class="my-3">
                <div class="card h-100">
                    <div class="card-body BodyOfProfial">
                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 DetailsContainer">
                                <h3 class="mb-2">@SharedLocalizer["Update Password"]</h3>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="CurrentPassword">@SharedLocalizer["Current Password"]</label>
                                    <input asp-for="CurrentPassword" class="form-control" placeholder="@SharedLocalizer["Enter Current Password"]">
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="NewPassword">@SharedLocalizer["NewPassword"]</label>
                                    <input asp-for="NewPassword" class="form-control" placeholder="@SharedLocalizer["Enter New Password"]">
                                </div>
                            </div>
                        </div>
                        <div class="row gutters my-3">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="text-right">
                                    <button type="submit" id="submit" name="submit" class="Update-link">@SharedLocalizer["Update Password"] </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
