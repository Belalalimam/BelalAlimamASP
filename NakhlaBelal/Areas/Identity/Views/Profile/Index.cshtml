@model ApplicationUserVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewBag.Title = "My Profile";
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var totalSpent = (decimal)(ViewBag.TotalSpent ?? 0m);
    var deliveredOrders = (int)(ViewBag.DeliveredOrders ?? 0);
    var pendingOrders = (int)(ViewBag.PendingOrders ?? 0);
    var memberSince = (DateTime)(ViewBag.MemberSince ?? DateTime.Now);
    var emailConfirmed = (bool)(ViewBag.EmailConfirmed ?? false);
    var recentOrders = ViewBag.RecentOrders as List<NakhlaBelal.Models.Order> ?? new List<NakhlaBelal.Models.Order>();

    var initials = string.IsNullOrEmpty(Model.FullName) ? "?" :
        string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
}

@section Scripts {
    <partial name="_NotificationPartial" />
}

<style>
/* ═══════════════════════════════════════════
   Egypt Profile Dashboard
   ═══════════════════════════════════════════ */
:root {
    --eg-blue:    #003B6F;
    --eg-gold:    #D4A017;
    --eg-papyrus: #FDF5E6;
    --eg-dark:    #001B35;
}

.profile-page {
    background: #F4F0E8;
    min-height: 100vh;
    padding: 40px 0;
}

/* ── Header card ── */
.profile-header-card {
    background: linear-gradient(135deg, #003B6F 0%, #0052A4 60%, #001B35 100%);
    color: #fff;
    border-radius: 16px;
    padding: 44px 40px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 36px rgba(0,59,111,.28);
}
/* Gold cover strip at top */
.profile-header-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, #D4A017, #F0C040, #D4A017);
}
/* Deco circles */
.profile-header-card::after {
    content: '';
    position: absolute;
    bottom: -80px; right: -40px;
    width: 260px; height: 260px;
    background: rgba(255,255,255,.05);
    border-radius: 50%;
    z-index: 0;
}
.profile-header-deco {
    position: absolute;
    top: -60px; left: -60px;
    width: 220px; height: 220px;
    background: rgba(212,160,23,.1);
    border-radius: 50%;
    z-index: 0;
}
.profile-header-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
}
.avatar-circle {
    width: 96px; height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, #D4A017, #F0C040);
    color: #003B6F;
    font-size: 34px; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    border: 4px solid rgba(255,255,255,.3);
    box-shadow: 0 4px 18px rgba(0,0,0,.25);
    font-family: 'Cairo', sans-serif;
    flex-shrink: 0;
}
.profile-header-info h1 {
    font-family: 'Cairo', sans-serif;
    font-size: 26px; font-weight: 800; margin: 0 0 6px;
}
.profile-header-info .email {
    opacity: .88; font-size: 14px; margin: 0 0 10px;
    display: flex; align-items: center; gap: 5px;
}
.profile-header-badges { display: flex; gap: 8px; flex-wrap: wrap; }
.badge-item {
    background: rgba(255,255,255,.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.18);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'Cairo', sans-serif;
}
.badge-verified   { background: rgba(42,125,79,.35); border-color: rgba(42,125,79,.5); }
.badge-unverified { background: rgba(212,122,0,.35);  border-color: rgba(212,122,0,.5); }

/* ── Stats grid ── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}
.stat-box {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,59,111,.07);
    border: 1px solid rgba(212,160,23,.15);
    transition: transform .2s, box-shadow .2s;
}
.stat-box:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,59,111,.14); }
.stat-icon {
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    margin-bottom: 12px;
}
.stat-label { font-size: 12px; color: #888; margin-bottom: 4px; font-family: 'Cairo', sans-serif; }
.stat-value { font-size: 22px; font-weight: 800; color: #1A2B3C; font-family: 'Cairo', sans-serif; }

.icon-orders   { background: rgba(0,59,111,.12);  color: #003B6F; }
.icon-spent    { background: rgba(212,160,23,.15); color: #B8860B; }
.icon-delivered{ background: rgba(42,125,79,.15);  color: #2a7d4f; }
.icon-pending  { background: rgba(212,122,0,.12);  color: #d47a00; }

/* ── Tabs ── */
.tab-nav {
    display: flex; gap: 4px;
    background: #fff;
    border-radius: 12px;
    padding: 6px;
    margin-bottom: 20px;
    border: 1px solid rgba(212,160,23,.2);
    box-shadow: 0 1px 4px rgba(0,59,111,.06);
    flex-wrap: wrap;
}
.tab-btn {
    flex: 1;
    padding: 11px 18px;
    background: transparent; border: none;
    border-radius: 8px;
    font-family: 'Cairo', sans-serif;
    font-size: 14px; font-weight: 700;
    color: #777;
    cursor: pointer;
    transition: all .2s;
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    min-width: 130px;
    position: relative;
}
.tab-btn:hover { background: #F4F0E8; color: #003B6F; }
.tab-btn.active {
    background: #003B6F;
    color: #fff;
    box-shadow: 0 3px 10px rgba(0,59,111,.3);
}
/* Gold underline on active tab */
.tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -2px; left: 20%; right: 20%;
    height: 2px;
    background: #D4A017;
    border-radius: 2px;
}

/* ── Panels ── */
.panel {
    background: #fff;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 2px 8px rgba(0,59,111,.06);
    border: 1px solid rgba(212,160,23,.15);
    display: none;
}
.panel.active { display: block; }
.panel-title   { font-family: 'Cairo', sans-serif; font-size: 20px; font-weight: 800; color: #1A2B3C; margin: 0 0 4px; }
.panel-subtitle{ color: #888; font-size: 14px; margin: 0 0 22px; }

/* ── Form fields ── */
.field-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-bottom: 24px;
}
.field { display: flex; flex-direction: column; }
.field label { font-size: 12px; font-weight: 700; color: #555; letter-spacing: .4px; margin-bottom: 6px; font-family: 'Cairo', sans-serif; }
.field input, .field select {
    padding: 11px 14px;
    border: 1.5px solid #e0dbd0;
    border-radius: 8px;
    font-size: 14px;
    font-family: 'Cairo', sans-serif;
    transition: border-color .2s, box-shadow .2s;
    background: #fafaf7;
}
.field input:focus {
    outline: none;
    border-color: #003B6F;
    box-shadow: 0 0 0 3px rgba(0,59,111,.1);
    background: #fff;
}
.field input:disabled { background: #f4f4f0; color: #aaa; cursor: not-allowed; }

.section-divider { border: 0; border-top: 1px solid rgba(212,160,23,.15); margin: 28px 0 20px; }
.section-label {
    font-size: 15px; font-weight: 800; color: #003B6F;
    margin: 0 0 16px;
    display: flex; align-items: center; gap: 8px;
    font-family: 'Cairo', sans-serif;
}

.action-bar {
    display: flex; gap: 12px; justify-content: flex-end;
    padding-top: 20px;
    border-top: 1px solid rgba(212,160,23,.15);
    margin-top: 12px;
    flex-wrap: wrap;
}
.btn-profile {
    padding: 11px 24px; border-radius: 8px;
    font-size: 14px; font-weight: 700; border: none; cursor: pointer;
    transition: all .2s;
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'Cairo', sans-serif;
    text-decoration: none;
}
.btn-save   { background: #003B6F; color: #fff; }
.btn-save:hover { background: #002a52; transform: translateY(-1px); }
.btn-cancel { background: #F4F0E8; color: #555; }
.btn-cancel:hover { background: #e8e2d8; }

/* ── Orders list ── */
.orders-list { display: flex; flex-direction: column; gap: 12px; }
.order-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px;
    border: 1px solid rgba(212,160,23,.18);
    border-radius: 10px;
    transition: all .2s;
    flex-wrap: wrap; gap: 10px;
}
.order-item:hover { border-color: #003B6F; background: #f8f5ef; }
.order-info .order-num { font-weight: 800; color: #003B6F; font-size: 15px; font-family: 'Cairo', sans-serif; }
.order-info .order-date { font-size: 12px; color: #aaa; margin-top: 2px; }
.order-amount { font-weight: 800; color: #1A2B3C; font-family: 'Cairo', sans-serif; }

.status-badge {
    display: inline-block; padding: 4px 10px;
    border-radius: 999px; font-size: 11px; font-weight: 700;
    font-family: 'Cairo', sans-serif;
}
.status-Pending    { background: rgba(212,122,0,.12);  color: #d47a00; }
.status-Processing { background: rgba(0,59,111,.1);    color: #003B6F; }
.status-Shipped    { background: rgba(0,85,164,.1);    color: #0055A4; }
.status-Delivered  { background: rgba(42,125,79,.12);  color: #2a7d4f; }
.status-Cancelled  { background: rgba(192,57,43,.1);   color: #c0392b; }

.empty-state { text-align: center; padding: 60px 20px; color: #bbb; }
.empty-state i { font-size: 56px; margin-bottom: 14px; opacity: .4; display: block; }

.security-tip {
    background: rgba(212,160,23,.08);
    border: 1px solid rgba(212,160,23,.3);
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 13px;
    color: #8a6500;
    margin-bottom: 20px;
    display: flex; align-items: flex-start; gap: 10px;
    font-family: 'Cairo', sans-serif;
}
</style>

<div class="profile-page">
    <div class="container">

        <!-- Header Card -->
        <div class="profile-header-card">
            <div class="profile-header-deco"></div>
            <div class="profile-header-content">
                <div class="avatar-circle">@initials</div>
                <div class="profile-header-info" style="flex:1;">
                    <h1>@(string.IsNullOrWhiteSpace(Model.FullName?.Trim()) ? "مرحباً بك" : Model.FullName)</h1>
                    <p class="email"><i class="ri-mail-line"></i> @Model.Email</p>
                    <div class="profile-header-badges">
                        @if (emailConfirmed)
                        {
                            <span class="badge-item badge-verified">
                                <i class="ri-checkbox-circle-fill"></i> بريد مُؤكد
                            </span>
                        }
                        else
                        {
                            <span class="badge-item badge-unverified">
                                <i class="ri-error-warning-fill"></i> بريد غير مؤكد
                            </span>
                        }
                        <span class="badge-item">
                            <i class="ri-calendar-line"></i> عضو منذ @memberSince.ToString("MM/yyyy")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span class="badge-item">
                                <i class="ri-phone-line"></i> @Model.PhoneNumber
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-icon icon-orders"><i class="ri-shopping-bag-line"></i></div>
                <div class="stat-label">إجمالي الطلبات</div>
                <div class="stat-value">@totalOrders</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon icon-spent"><i class="ri-money-dollar-circle-line"></i></div>
                <div class="stat-label">إجمالي المشتريات</div>
                <div class="stat-value">@totalSpent.ToString("N0") ج.م</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon icon-delivered"><i class="ri-checkbox-circle-line"></i></div>
                <div class="stat-label">تم التوصيل</div>
                <div class="stat-value">@deliveredOrders</div>
            </div>
            <div class="stat-box">
                <div class="stat-icon icon-pending"><i class="ri-time-line"></i></div>
                <div class="stat-label">قيد التنفيذ</div>
                <div class="stat-value">@pendingOrders</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tab-nav">
            <button type="button" class="tab-btn active" data-tab="personal">
                <i class="ri-user-line"></i> البيانات الشخصية
            </button>
            <button type="button" class="tab-btn" data-tab="address">
                <i class="ri-map-pin-line"></i> العنوان
            </button>
            <button type="button" class="tab-btn" data-tab="orders">
                <i class="ri-shopping-bag-line"></i> آخر الطلبات
            </button>
            <button type="button" class="tab-btn" data-tab="security">
                <i class="ri-lock-line"></i> الأمان
            </button>
        </div>

        <!-- Personal Details Panel -->
        <div class="panel active" id="panel-personal">
            <h2 class="panel-title">البيانات الشخصية</h2>
            <p class="panel-subtitle">قم بتحديث معلومات حسابك الشخصية</p>

            <form asp-action="UpdateProfile">
                <div class="field-group">
                    <div class="field">
                        <label>الاسم الأول</label>
                        <input asp-for="FirstName" placeholder="أدخل الاسم الأول" />
                    </div>
                    <div class="field">
                        <label>الاسم الأخير</label>
                        <input asp-for="LastName" placeholder="أدخل الاسم الأخير" />
                    </div>
                    <div class="field">
                        <label>البريد الإلكتروني</label>
                        <input asp-for="Email" disabled />
                    </div>
                    <div class="field">
                        <label>رقم الهاتف</label>
                        <input asp-for="PhoneNumber" placeholder="+20 1XX XXX XXXX" />
                    </div>
                </div>

                <div class="action-bar">
                    <button type="reset" class="btn-profile btn-cancel">
                        <i class="ri-close-line"></i> إلغاء
                    </button>
                    <button type="submit" class="btn-profile btn-save">
                        <i class="ri-save-line"></i> حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>

        <!-- Address Panel -->
        <div class="panel" id="panel-address">
            <h2 class="panel-title">عنوان الشحن</h2>
            <p class="panel-subtitle">هذا العنوان سيُستخدم كعنوان افتراضي لطلباتك</p>

            <form asp-action="UpdateProfile">
                <input type="hidden" asp-for="FirstName" />
                <input type="hidden" asp-for="LastName" />
                <input type="hidden" asp-for="PhoneNumber" />

                <div class="field-group">
                    <div class="field" style="grid-column: 1 / -1;">
                        <label>العنوان بالتفصيل</label>
                        <input asp-for="Address" placeholder="اسم الشارع، رقم المنزل، الحي..." />
                    </div>
                    <div class="field">
                        <label>المدينة</label>
                        <input asp-for="City" placeholder="مثال: القاهرة" />
                    </div>
                    <div class="field">
                        <label>المحافظة</label>
                        <input asp-for="State" placeholder="مثال: القاهرة" />
                    </div>
                    <div class="field">
                        <label>الرمز البريدي</label>
                        <input asp-for="ZipCode" placeholder="12345" />
                    </div>
                    <div class="field">
                        <label>الدولة</label>
                        <input asp-for="Country" placeholder="مصر" />
                    </div>
                </div>

                <div class="action-bar">
                    <button type="reset" class="btn-profile btn-cancel">
                        <i class="ri-close-line"></i> إلغاء
                    </button>
                    <button type="submit" class="btn-profile btn-save">
                        <i class="ri-save-line"></i> حفظ العنوان
                    </button>
                </div>
            </form>
        </div>

        <!-- Orders Panel -->
        <div class="panel" id="panel-orders">
            <h2 class="panel-title">آخر الطلبات</h2>
            <p class="panel-subtitle">آخر 5 طلبات قمت بها</p>

            @if (!recentOrders.Any())
            {
                <div class="empty-state">
                    <i class="ri-shopping-bag-line"></i>
                    <div>لم تقم بأي طلب بعد</div>
                    <a href="/Customer/home/product" class="btn-profile btn-save" style="margin-top:16px; display:inline-flex;">
                        <i class="ri-store-2-line"></i> تصفّح المنتجات
                    </a>
                </div>
            }
            else
            {
                <div class="orders-list">
                    @foreach (var order in recentOrders)
                    {
                        <div class="order-item">
                            <div class="order-info">
                                <div class="order-num">@order.OrderNumber</div>
                                <div class="order-date">
                                    @order.CreatedAt.ToString("dd MMM yyyy, HH:mm") — @order.OrderItems.Count منتج
                                </div>
                            </div>
                            <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
                                <span class="status-badge status-@order.OrderStatus">@order.OrderStatus</span>
                                <span class="order-amount">@order.TotalAmount.ToString("N2") ج.م</span>
                            </div>
                        </div>
                    }
                </div>

                <div style="text-align:center; margin-top:20px;">
                    <a href="/Identity/Profile/MyOrders" class="btn-profile btn-cancel">
                        عرض كل الطلبات <i class="ri-arrow-left-line"></i>
                    </a>
                </div>
            }
        </div>

        <!-- Security Panel -->
        <div class="panel" id="panel-security">
            <h2 class="panel-title">تغيير كلمة المرور</h2>
            <p class="panel-subtitle">اختر كلمة مرور قوية وآمنة لحماية حسابك</p>

            <div class="security-tip">
                <i class="ri-shield-keyhole-line" style="font-size:18px;"></i>
                <div>
                    <strong>نصائح للأمان:</strong>
                    استخدم كلمة مرور من 8 أحرف على الأقل، تحتوي على حروف كبيرة وصغيرة وأرقام ورموز.
                    لا تشاركها مع أي شخص.
                </div>
            </div>

            <form asp-action="UpdatePassword">
                <div class="field-group">
                    <div class="field">
                        <label>كلمة المرور الحالية</label>
                        <input asp-for="CurrentPassword" type="password" placeholder="••••••••" />
                    </div>
                    <div class="field">
                        <label>كلمة المرور الجديدة</label>
                        <input asp-for="NewPassword" type="password" placeholder="••••••••" />
                    </div>
                </div>

                <div class="action-bar">
                    <button type="submit" class="btn-profile btn-save">
                        <i class="ri-shield-check-line"></i> تحديث كلمة المرور
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('panel-' + tab).classList.add('active');
        });
    });
</script>
