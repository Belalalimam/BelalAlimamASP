@model IEnumerable<NakhlaBelal.Models.Notification>
@{
    ViewBag.Title = "Notifications";
    ViewBag.PageTitle = "Notifications";
    var unreadOnly = ViewBag.UnreadOnly as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group">
        <a href="@Url.Action("Index", new { unreadOnly = false })"
           class="btn @(!unreadOnly ? "btn-primary" : "btn-outline-primary")">All</a>
        <a href="@Url.Action("Index", new { unreadOnly = true })"
           class="btn @(unreadOnly ? "btn-primary" : "btn-outline-primary")">Unread</a>
    </div>
    <form asp-action="MarkAllRead" method="post" class="m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-success">
            <i class="fas fa-check-double"></i> Mark all as read
        </button>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">No notifications.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <li class="list-group-item @(n.IsRead ? "" : "bg-light")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div style="flex:1">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!n.IsRead)
                                    {
                                        <span class="badge bg-primary">New</span>
                                    }
                                    <strong>@n.Title</strong>
                                </div>
                                <div class="text-muted small mt-1">@n.Message</div>
                                <div class="text-muted small mt-1">
                                    <i class="far fa-clock"></i> @n.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </div>
                            </div>
                            <div class="ms-3">
                                @if (!string.IsNullOrEmpty(n.Url))
                                {
                                    <a href="@Url.Action("Open", new { id = n.Id })" class="btn btn-sm btn-primary">
                                        Open
                                    </a>
                                }
                                else if (!n.IsRead)
                                {
                                    <form asp-action="MarkRead" method="post" class="m-0 d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-check"></i> Read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
