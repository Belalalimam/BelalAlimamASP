@model IEnumerable<NakhlaBelal.Models.Order>
@{
    ViewBag.Title = "Orders Management";
    var stats = ViewBag.Stats;
}

<div class="mobile-scroll-hint">
    <i class="fas fa-arrows-left-right"></i> اسحب يميناً أو يساراً لعرض كافة التفاصيل
</div>

<div class="page-header">
    <div>
        <h2>Orders</h2>
        <p>Manage and track all customer orders (@Model.Count() orders in this view)</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-secondary" onclick="location.reload()">
            <i class="fas fa-sync"></i>
            <span class="btn-text">Refresh</span>
        </button>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            <span class="btn-text">New Order</span>
        </a>
    </div>
</div>

<div class="orders-stats-container">
    <div class="orders-stat-card">
        <div class="orders-stat-title">Total Orders</div>
        <div class="orders-stat-value">@stats.Total</div>
        <div class="orders-stat-desc">Active orders in system</div>
    </div>
    <div class="orders-stat-card">
        <div class="orders-stat-title">Revenue</div>
        <div class="orders-stat-value">@stats.Revenue.ToString("N2") EGP</div>
        <div class="orders-stat-desc">Excluding cancelled</div>
    </div>
    <div class="orders-stat-card">
        <div class="orders-stat-title">Pending Orders</div>
        <div class="orders-stat-value">@stats.Pending</div>
        <div class="orders-stat-desc badge-warning-text">Require attention</div>
    </div>
    <div class="orders-stat-card">
        <div class="orders-stat-title">Shipped</div>
        <div class="orders-stat-value">@stats.Shipped</div>
        <div class="orders-stat-desc">On the way to customers</div>
    </div>
</div>

<div class="filters">
    <div class="filter-group">
        <a href="@Url.Action("Index", new { status = "" })"
               class="filter-btn @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active" : "")">
            <span>All Orders</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Pending" })"
               class="filter-btn @(ViewBag.CurrentStatus == "Pending" ? "active" : "")">
            <span>Pending</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Processing" })"
               class="filter-btn @(ViewBag.CurrentStatus == "Processing" ? "active" : "")">
            <span>Processing</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Shipped" })"
               class="filter-btn @(ViewBag.CurrentStatus == "Shipped" ? "active" : "")">
            <span>Shipped</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Delivered" })"
               class="filter-btn @(ViewBag.CurrentStatus == "Delivered" ? "active" : "")">
            <span>Delivered</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Cancelled" })"
               class="filter-btn @(ViewBag.CurrentStatus == "Cancelled" ? "active" : "")">
            <span>Cancelled</span>
        </a>
    </div>
    <div class="action-buttons">
        <button class="btn btn-secondary" onclick="window.print()">
            <i class="fas fa-download"></i>
            <span class="btn-text">Print Report</span>
        </button>
    </div>
</div>

<div class="data-table-container">
    <div class="table-header">
        <h2>Recent Orders</h2>
        <div class="table-actions" id="bulkActions" style="display:none;">
            <button class="table-action text-danger" onclick="deleteSelected()">
                <i class="fas fa-trash"></i>
                <span class="btn-text">Delete Selected</span>
            </button>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 40px;">
                    <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)">
                </th>
                <th>Order Number</th>
                <th>Customer</th>
                <th>Products</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-order-id="@item.Id">
                    <td>
                        <input type="checkbox" class="order-select" value="@item.Id" onchange="updateSelection()">
                    </td>
                    <td>
                        <div class="order-id">#@item.OrderNumber</div>
                        <small class="text-muted">@item.PaymentMethod</small>
                    </td>
                    <td>
                        <div class="customer-name">@item.FullName</div>
                        <div class="text-muted" style="font-size: 0.8rem;">@item.ShippingEmail</div>
                    </td>
                    <td>
                        <div class="order-product-info">
                            @if (item.OrderItems != null && item.OrderItems.Any())
                            {
                                <div class="order-product-name">@item.OrderItems.First().Product?.Name</div>
                                @if (item.OrderItems.Count > 1)
                                {
                                    <div class="order-product-desc">+ @(item.OrderItems.Count - 1) other items</div>
                                }
                            }
                            else
                            {
                                <div class="text-muted">No items</div>
                            }
                        </div>
                    </td>
                    <td>
                        <div class="order-date">@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                        <small class="text-muted">@item.CreatedAt.ToString("hh:mm tt")</small>
                    </td>
                    <td>
                        <div class="order-total-amount">@item.TotalAmount.ToString("N2") EGP</div>
                    </td>
                    <td>
                        @{
                            var statusClass = item.OrderStatus.ToLower() switch
                            {
                                "pending" => "order-status-pending",
                                "paid" => "order-status-paid",
                                "shipped" => "order-status-shipping", // مابينج مع كلاسات الـ CSS تبعك
                                "delivered" => "order-status-paid",
                                "cancelled" => "order-status-cancelled",
                                _ => "order-status-pending"
                            };
                        }
                        <span class="order-status-badge @statusClass">@item.OrderStatus</span>
                    </td>
                    <td>
                        <div class="row-actions">
                            @* عرض سريع بالـ Modal *@
                            <button class="row-action view" onclick="openOrderModal('@item.Id')">
                                <i class="fas fa-eye"></i>
                            </button>
                            @* انتقال لصفحة التفاصيل الكاملة *@
                            <a asp-action="Details" asp-route-id="@item.Id" class="row-action edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button class="row-action delete" onclick="deleteOrder('@item.Id')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* مودل ال التعديل او الفيو *@
<div id="orderModalContainer" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-loading">Loading order details...</div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ==========================================
        // INITIALIZATION
        // ==========================================
        document.addEventListener('DOMContentLoaded', function() {
            setupModalEvents();
        });

        // ==========================================
        // 1. وظيفة حفظ التعديلات من المودال (AJAX)
        // ==========================================
        function saveOrderUpdate() {
            var form = $('#editOrderForm');
            if (form.length === 0) return;

            var formData = form.serialize();
            
            // تغيير النص في زر الحفظ لإظهار حالة التحميل
            var btn = event.target;
            var originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
            btn.disabled = true;

            $.post('/Admin/Orders/UpdateStatus', formData, function(response) {
                if (response.success) {
                    alert("تم التحديث بنجاح!");
                    location.reload();
                } else {
                    alert("خطأ: " + response.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            }).fail(function() {
                alert("حدث خطأ في الاتصال بالسيرفر");
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }

        // ==========================================
        // 2. MODAL FUNCTIONS (VIEW/EDIT)
        // ==========================================
        function openOrderModal(orderId) {
            const modalContainer = document.getElementById('orderModalContainer');
            const modalContent = modalContainer.querySelector('.modal-content');
        
            modalContent.innerHTML = '<div class="modal-loading"><i class="fas fa-spinner fa-spin"></i> Loading order info...</div>';
            modalContainer.style.display = 'flex';
            document.body.style.overflow = 'hidden';

            $.ajax({
                url: '/Admin/Orders/GetDetails/' + orderId,
                type: 'GET',
                success: function(response) {
                    modalContent.innerHTML = response;
                    setupModalEvents();
                },
                error: function(xhr) {
                    modalContent.innerHTML = `<div class="modal-error p-4 text-center">
                        <h4>Error Loading Details</h4>
                        <button class="btn btn-primary mt-3" onclick="closeModal()">Close</button>
                    </div>`;
                }
            });
        }

        function closeModal() {
            const modalContainer = document.getElementById('orderModalContainer');
            if (modalContainer) {
                modalContainer.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        function setupModalEvents() {
            const modalContainer = document.getElementById('orderModalContainer');
            if (!modalContainer) return;

            modalContainer.onclick = function(e) {
                if (e.target === this || e.target.closest('.modal-close')) {
                    closeModal();
                }
            };
        }

        // ==========================================
        // 3. DELETE FUNCTION (تصحيح البراميترز)
        // ==========================================
        function deleteOrder(orderId) {
            if (!confirm(`هل أنت متأكد من حذف الطلب رقم ${orderId}؟`)) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Admin/Orders/Delete/' + orderId,
                type: 'POST',
                data: { __RequestVerificationToken: token },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                }
            });
        }

        // ==========================================
        // 4. BULK SELECTION
        // ==========================================
        function toggleSelectAll(source) {
            const checkboxes = document.querySelectorAll('.order-select');
            checkboxes.forEach(cb => {
                cb.checked = source.checked;
                cb.closest('tr').classList.toggle('selected', source.checked);
            });
            updateSelectionUI();
        }

        function updateSelection() {
            updateSelectionUI();
        }

        function updateSelectionUI() {
            const selectedCount = document.querySelectorAll('.order-select:checked').length;
            const actionsBar = document.getElementById('bulkActions');
            if (actionsBar) {
                actionsBar.style.display = selectedCount > 0 ? 'flex' : 'none';
            }
        }
    </script>
}