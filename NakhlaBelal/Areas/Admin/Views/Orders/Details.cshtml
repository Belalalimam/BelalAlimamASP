@model NakhlaBelal.Models.Order
@{
    ViewBag.Title = "Order Details";
    ViewBag.PageTitle = "Order #" + Model.OrderNumber;
    ViewBag.Subtitle = "View and manage order fulfillment";
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Admin/Orders" class="btn btn-secondary btn-sm" style="padding: 5px 10px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="mb-0">Order #@Model.OrderNumber</h2>
        </div>
        <p class="page-subtitle">Placed on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-secondary" onclick="window.print()">
            <i class="fas fa-print"></i> Print Invoice
        </button>
        <button class="btn btn-primary" onclick="openOrderModal('@Model.Id')">
            <i class="fas fa-edit"></i> Update Status
        </button>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-8">
        <div class="data-table-container mb-4">
            <div class="table-header">
                <h2>Order Items (@Model.OrderItems.Count)</h2>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-center">Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="customer-name">@item.Product?.Name</div>
                                </div>
                            </td>
                            <td class="text-center">@item.UnitPrice.ToString("N2") EGP</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("N2")) EGP</td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <div class="p-4 border-top">
                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span>@Model.TotalAmount.ToString("N2") EGP</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping:</span>
                            <span class="text-success">Free</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Total Amount:</h4>
                            <h3 class="mb-0 text-primary">@Model.TotalAmount.ToString("N2") EGP</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="data-table-container">
            <div class="table-header">
                <h2>Admin Notes</h2>
            </div>
            <div class="p-4">
                <p class="mb-0 text-muted">@(string.IsNullOrEmpty(Model.AdminNotes) ? "No internal notes added." : Model.AdminNotes)</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="stat-card mb-4" style="height: auto; padding: 20px;">
            <div class="stat-header">
                <div class="stat-title">Order Status</div>
                <div class="stat-icon"><i class="fas fa-info-circle"></i></div>
            </div>
            <div class="mt-3">
                @{
                    var statusClass = Model.OrderStatus.ToLower() switch
                    {
                        "pending" => "dot-inactive",
                        "shipped" => "dot-draft",
                        "delivered" => "dot-active",
                        "cancelled" => "dot-archived",
                        _ => "dot-inactive"
                    };
                }
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="status-dot @statusClass"></span>
                    <span class="fw-bold">@Model.OrderStatus</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-top">
                    <small class="text-muted">Payment:</small>
                    <span class="badge bg-light text-dark">@Model.PaymentStatus</span>
                </div>
            </div>
        </div>

        <div class="data-table-container p-4 mb-4" style="box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
            <h5 class="mb-3 fw-bold"><i class="fas fa-user-circle me-2"></i> Customer Info</h5>
            <div class="mb-2">
                <div class="customer-name">@Model.FullName</div>
                <div class="text-muted small">@Model.ShippingEmail</div>
                <div class="text-muted small">@Model.ShippingPhone</div>
            </div>
        </div>

        <div class="data-table-container p-4" style="box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
            <h5 class="mb-3 fw-bold"><i class="fas fa-shipping-fast me-2"></i> Shipping Address</h5>
            <address class="mb-0 text-muted small" style="line-height: 1.6;">
                @Model.ShippingAddress<br>
                @Model.ShippingCity, @Model.ShippingState<br>
                @Model.ShippingZipCode
            </address>
        </div>
    </div>
</div>

<div id="orderModalContainer" class="modal" style="display: none;">
    <div class="modal-content"></div>
</div>

@section Scripts {
    <script>
        function openOrderModal(id) {
            const modalContainer = document.getElementById('orderModalContainer');
            const modalContent = modalContainer.querySelector('.modal-content');
            modalContent.innerHTML = '<div class="modal-loading">Loading...</div>';
            modalContainer.style.display = 'flex';
            
            $.get('/Admin/Orders/GetDetails/' + id, function(data) {
                modalContent.innerHTML = data;
            });
        }

        function closeModal() {
            document.getElementById('orderModalContainer').style.display = 'none';
        }
    </script>
}