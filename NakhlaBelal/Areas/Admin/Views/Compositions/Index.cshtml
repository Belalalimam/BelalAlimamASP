@model List<NakhlaBelal.Models.Composition>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Compositions";
    var usage = ViewBag.Usage as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="content-card">
    <div class="content-card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">Compositions</h2>
            <p class="text-muted mb-0">@ViewBag.Subtitle</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#compCreate">
            <i class="fas fa-plus me-1"></i> New composition
        </button>
    </div>

    @if (TempData["success-notification"] != null)
    { <div class="alert alert-success m-3">@TempData["success-notification"]</div> }
    @if (TempData["error-notification"] != null)
    { <div class="alert alert-danger m-3">@TempData["error-notification"]</div> }

    <div class="p-3">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5"><i class="fas fa-flask fa-3x mb-3"></i><p>No compositions yet.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Description</th><th>Used in</th><th class="text-end" style="width:160px">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var count = usage.TryGetValue(c.Id, out var n) ? n : 0;
                            <tr>
                                <td class="fw-semibold">@c.Name</td>
                                <td class="text-muted">@(c.Description ?? "-")</td>
                                <td><span class="badge bg-light text-dark">@count product(s)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#compEdit"
                                            data-id="@c.Id" data-name="@c.Name"
                                            data-desc="@c.Description" data-img="@c.ImageUrl">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this composition?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="compCreate" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">New composition</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" required placeholder="Cotton" /></div>
                <div class="mb-3"><label class="form-label">Image URL</label><input class="form-control" name="ImageUrl" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<div class="modal fade" id="compEdit" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="cmp-id" />
            <div class="modal-header"><h5 class="modal-title">Edit composition</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" id="cmp-name" required /></div>
                <div class="mb-3"><label class="form-label">Image URL</label><input class="form-control" name="ImageUrl" id="cmp-img" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" id="cmp-desc" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('compEdit').addEventListener('show.bs.modal', function (ev) {
        var b = ev.relatedTarget;
        document.getElementById('cmp-id').value   = b.getAttribute('data-id');
        document.getElementById('cmp-name').value = b.getAttribute('data-name');
        document.getElementById('cmp-img').value  = b.getAttribute('data-img') || '';
        document.getElementById('cmp-desc').value = b.getAttribute('data-desc') || '';
    });
</script>
}
