@model List<NakhlaBelal.Models.FabricType>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Fabric Types";
}

<div class="content-card">
    <div class="content-card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">Fabric Types</h2>
            <p class="text-muted mb-0">@ViewBag.Subtitle</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ftCreate">
            <i class="fas fa-plus me-1"></i> New fabric type
        </button>
    </div>

    @if (TempData["success-notification"] != null)
    { <div class="alert alert-success m-3">@TempData["success-notification"]</div> }
    @if (TempData["error-notification"] != null)
    { <div class="alert alert-danger m-3">@TempData["error-notification"]</div> }

    <div class="p-3">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5"><i class="fas fa-layer-group fa-3x mb-3"></i><p>No fabric types yet.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th style="width:70px">Image</th><th>Name</th><th>Slug</th><th>Products</th><th class="text-end" style="width:160px">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(f.ImageUrl))
                                    { <img src="~/images/@f.ImageUrl" style="width:48px;height:48px;object-fit:cover;border-radius:8px" /> }
                                    else
                                    { <div style="width:48px;height:48px;background:#f1f3f5;border-radius:8px;display:flex;align-items:center;justify-content:center"><i class="fas fa-image text-muted"></i></div> }
                                </td>
                                <td class="fw-semibold">@f.Name</td>
                                <td><code>@f.Slug</code></td>
                                <td><span class="badge bg-light text-dark">@(f.Products?.Count ?? 0)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#ftEdit"
                                            data-id="@f.Id" data-name="@f.Name" data-slug="@f.Slug"
                                            data-desc="@f.Description" data-img="@f.ImageUrl">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this fabric type?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="ftCreate" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">New fabric type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" required /></div>
                <div class="mb-3"><label class="form-label">Slug <small class="text-muted">(leave empty to auto-generate)</small></label><input class="form-control" name="Slug" /></div>
                <div class="mb-3"><label class="form-label">Image filename <small class="text-muted">(from /images)</small></label><input class="form-control" name="ImageUrl" placeholder="cotton.webp" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

<div class="modal fade" id="ftEdit" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="ft-id" />
            <div class="modal-header"><h5 class="modal-title">Edit fabric type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" id="ft-name" required /></div>
                <div class="mb-3"><label class="form-label">Slug</label><input class="form-control" name="Slug" id="ft-slug" /></div>
                <div class="mb-3"><label class="form-label">Image filename</label><input class="form-control" name="ImageUrl" id="ft-img" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" id="ft-desc" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('ftEdit').addEventListener('show.bs.modal', function (ev) {
        var b = ev.relatedTarget;
        document.getElementById('ft-id').value   = b.getAttribute('data-id');
        document.getElementById('ft-name').value = b.getAttribute('data-name');
        document.getElementById('ft-slug').value = b.getAttribute('data-slug') || '';
        document.getElementById('ft-img').value  = b.getAttribute('data-img') || '';
        document.getElementById('ft-desc').value = b.getAttribute('data-desc') || '';
    });
</script>
}
