@model NakhlaBelal.Models.Product
@{
    ViewBag.Title = "Add New Product";
    ViewBag.PageTitle = "Add Product";

    var categories = ViewBag.Categories as List<NakhlaBelal.Models.Category> ?? new List<NakhlaBelal.Models.Category>();
    var brands = ViewBag.Brands as List<NakhlaBelal.Models.Brand> ?? new List<NakhlaBelal.Models.Brand>();
    var validationErrors = ViewBag.ValidationErrors as List<string> ?? new List<string>();
}

@if (validationErrors.Any())
{
    <div class="alert alert-danger">
        <h5>Validation Errors:</h5>
        <ul>
            @foreach (var error in validationErrors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="page-header">
    <div>
        <h2>إضافة منتج جديد</h2>
        <p class="page-subtitle">أضف منتجاً جديداً إلى الكتالوج</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="createProductForm">
            @Html.AntiForgeryToken()

            @* {{!-- هذه يتكفل بها الكنترولر تلقائياً --}}
            {{!-- CreatedAt, CreatedBy, IsDeleted, SKU, ViewsCount, Traffic, Rate, ReviewCount, AverageRating --}} *@

            <!-- ===== SECTION 1: BASIC INFO ===== -->
            <h6 class="text-muted border-bottom pb-2 mb-3">
                <i class="fas fa-info-circle"></i> المعلومات الأساسية
            </h6>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label">اسم المنتج *</label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم المنتج" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SKU" class="form-label">SKU</label>
                            <div class="input-group">
                                <input asp-for="SKU" class="form-control" placeholder="يتولد تلقائياً إذا تركته فارغاً">
                                    <button type="button" class="btn btn-outline-secondary" onclick="generateSKU()">
                                        <i class="fas fa-sync-alt"></i> توليد
                                    </button>
                                </div>
                                <small class="text-muted">اتركه فارغاً ليتولد تلقائياً</small>
                                <span asp-validation-for="SKU" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Barcode" class="form-label">الباركود</label>
                                <input asp-for="Barcode" class="form-control" placeholder="أدخل الباركود أو امسحه">
                                    <span asp-validation-for="Barcode" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Slug" class="form-label">URL Slug</label>
                                    <input asp-for="Slug" class="form-control" placeholder="product-name">
                                        <span asp-validation-for="Slug" class="text-danger"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="ShortDescription" class="form-label">وصف مختصر</label>
                                        <textarea asp-for="ShortDescription" class="form-control" rows="2" placeholder="وصف مختصر للمنتج"></textarea>
                                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label asp-for="CategoryId" class="form-label">التصنيف *</label>
                                        <select asp-for="CategoryId" class="form-control" required>
                                            <option value="">اختر التصنيف</option>
                                            @foreach (var category in categories)
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="BrandId" class="form-label">العلامة التجارية</label>
                                        <select asp-for="BrandId" class="form-control">
                                            <option value="">اختر العلامة التجارية</option>
                                            @foreach (var brand in brands)
                                            {
                                                <option value="@brand.Id">@brand.Name</option>
                                            }
                                        </select>
                                        <span asp-validation-for="BrandId" class="text-danger"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="StockQuantity" class="form-label">الكمية المتوفرة *</label>
                                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" required>
                                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label asp-for="LowStockThreshold" class="form-label">حد تنبيه المخزون</label>
                                            <input asp-for="LowStockThreshold" type="number" class="form-control" placeholder="10" value="10">
                                                <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="Description" class="form-label">الوصف الكامل</label>
                                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف تفصيلي للمنتج"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>

                                    <!-- ===== SECTION 2: PRICING ===== -->
                                    <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                        <i class="fas fa-tag"></i> التسعير
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group mb-3">
                                                <label asp-for="Price" class="form-label">سعر البيع *</label>
                                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required>
                                                    <span asp-validation-for="Price" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group mb-3">
                                                    <label asp-for="CostPrice" class="form-label">سعر التكلفة</label>
                                                    <input asp-for="CostPrice" type="number" step="0.01" class="form-control" placeholder="0.00">
                                                        <span asp-validation-for="CostPrice" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group mb-3">
                                                        <label asp-for="UnitPrice" class="form-label">وحدة السعر *</label>
                                                        <select asp-for="UnitPrice" class="form-control" required>
                                                            <option value="">اختر الوحدة</option>
                                                            <option value="متر">متر</option>
                                                            <option value="قطعة">قطعة</option>
                                                            <option value="كيلو">كيلو</option>
                                                            <option value="ياردة">ياردة</option>
                                                        </select>
                                                        <span asp-validation-for="UnitPrice" class="text-danger"></span>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group mb-3">
                                                        <label asp-for="Discount" class="form-label">نسبة الخصم (%)</label>
                                                        <input asp-for="Discount" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0" value="0">
                                                            <span asp-validation-for="Discount" class="text-danger"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="form-group mb-3">
                                                            <label asp-for="SpecialPrice" class="form-label">سعر العرض الخاص</label>
                                                            <input asp-for="SpecialPrice" type="number" step="0.01" class="form-control" placeholder="0.00">
                                                                <span asp-validation-for="SpecialPrice" class="text-danger"></span>
                                                                <small class="text-muted">اتركه فارغاً إذا لا يوجد عرض</small>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="form-group mb-3">
                                                                <label asp-for="SpecialPriceStart" class="form-label">بداية العرض</label>
                                                                <input asp-for="SpecialPriceStart" type="datetime-local" class="form-control">
                                                                    <span asp-validation-for="SpecialPriceStart" class="text-danger"></span>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-group mb-3">
                                                                    <label asp-for="SpecialPriceEnd" class="form-label">نهاية العرض</label>
                                                                    <input asp-for="SpecialPriceEnd" type="datetime-local" class="form-control">
                                                                        <span asp-validation-for="SpecialPriceEnd" class="text-danger"></span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- ===== SECTION 3: FABRIC SPECS ===== -->
                                                            <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                <i class="fas fa-ruler-combined"></i> مواصفات القماش
                                                            </h6>
                                                            <div class="row">
                                                                <div class="col-md-4">
                                                                    <div class="form-group mb-3">
                                                                        <label asp-for="Weight" class="form-label">وزن القطعة (جم/م²)</label>
                                                                        <input asp-for="Weight" type="number" step="0.01" class="form-control" placeholder="مثال: 250">
                                                                            <span asp-validation-for="Weight" class="text-danger"></span>
                                                                            <small class="text-muted">وزن متر مربع من القماش</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="form-group mb-3">
                                                                            <label asp-for="Width" class="form-label">عرض القماش (سم)</label>
                                                                            <input asp-for="Width" type="number" step="0.1" class="form-control" placeholder="مثال: 150">
                                                                                <span asp-validation-for="Width" class="text-danger"></span>
                                                                                <small class="text-muted">العرض الثابت للقماشة</small>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-4">
                                                                            <div class="form-group mb-3">
                                                                                <label asp-for="Height" class="form-label">حد تنبيه الطول (متر)</label>
                                                                                <input asp-for="Height" type="number" step="0.5" class="form-control" placeholder="مثال: 5">
                                                                                    <span asp-validation-for="Height" class="text-danger"></span>
                                                                                    <small class="text-muted">تنبيه عند انخفاض الطول عن هذه القيمة</small>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- ===== SECTION 4: FABRIC TYPE & COMPOSITION ===== -->
                                                                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                            <i class="fas fa-layer-group"></i> نوع وتركيب القماش
                                                                        </h6>
                                                                        <div class="row">
                                                                            <div class="col-md-6">
                                                                                <div class="form-group mb-3">
                                                                                    <label class="form-label font-weight-bold">تركيب القماش (%)</label>
                                                                                    <div id="composition-container">
                                                                                        <div class="composition-row row mb-2 g-2 align-items-center">
                                                                                            <div class="col-7">
                                                                                                <select name="ProductCompositions[0].CompositionId" class="form-select form-control" required>
                                                                                                    <option value="">اختر المادة</option>
                                                                                                    @if (ViewBag.Compositions != null)
                                                                                                    {
                                                                                                        foreach (var comp in ViewBag.Compositions as List<NakhlaBelal.Models.Composition>)
                                                                                                        {
                                                                                                            <option value="@comp.Id">@comp.Name</option>
                                                                                                        }
                                                                                                    }
                                                                                                </select>
                                                                                            </div>
                                                                                            <div class="col-3">
                                                                                                <input type="number" name="ProductCompositions[0].Percentage" class="form-control" placeholder="%" min="1" max="100" required>
                                                                                            </div>
                                                                                            <div class="col-2">
                                                                                                <button type="button" class="btn btn-outline-danger btn-sm remove-composition">×</button>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                    <button type="button" id="add-composition" class="btn btn-sm btn-outline-primary mt-2">
                                                                                        <i class="fas fa-plus"></i> إضافة مادة
                                                                                    </button>
                                                                                    <small class="text-muted d-block mt-1">مثال: 60% قطن، 40% بوليستر</small>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <div class="form-group mb-3">
                                                                                    <label asp-for="FabricTypeId" class="form-label">نوع القماش</label>
                                                                                    <select asp-for="FabricTypeId" class="form-control">
                                                                                        <option value="">اختر نوع القماش</option>
                                                                                        @{
                                                                                            var fabricTypes = ViewBag.FabricTypes as List<NakhlaBelal.Models.FabricType> ?? new List<NakhlaBelal.Models.FabricType>();
                                                                                        }
                                                                                        @foreach (var fabric in fabricTypes)
                                                                                        {
                                                                                            <option value="@fabric.Id">@fabric.Name</option>
                                                                                        }
                                                                                    </select>
                                                                                    <span asp-validation-for="FabricTypeId" class="text-danger"></span>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- ===== SECTION 5: COLOR, TAGS, PROJECT CATEGORIES ===== -->
                                                                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                            <i class="fas fa-palette"></i> اللون والتصنيفات
                                                                        </h6>
                                                                        <div class="row">
                                                                            <div class="col-md-4">
                                                                                <div class="form-group mb-3">
                                                                                    <label class="form-label">لون المنتج</label>
                                                                                    <select asp-for="ColorId" class="form-select form-control" asp-items="@(new SelectList(ViewBag.Colors, "Id", "Name"))">
                                                                                        <option value="">اختر اللون</option>
                                                                                    </select>
                                                                                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="forceOpenModal()">
                                                                                        <i class="fas fa-plus"></i> إضافة لون جديد
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <div class="form-group mb-3">
                                                                                    <label class="form-label">التاغات</label>
                                                                                    <select name="SelectedTagIds" multiple class="form-control">
                                                                                        @foreach (var tag in ViewBag.ProductTags)
                                                                                        {
                                                                                            <option value="@tag.Id">@tag.Name</option>
                                                                                        }
                                                                                    </select>
                                                                                    <small class="text-muted">Ctrl+Click لتحديد أكثر من واحد</small>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-4">
                                                                                <div class="form-group mb-3">
                                                                                    <label>تصنيفات المشاريع</label>
                                                                                    <select name="SelectedProjectCategoryIds" class="form-control" multiple>
                                                                                        @foreach (var category in ViewBag.ProjectCategories as List<NakhlaBelal.Models.ProjectCategory>)
                                                                                        {
                                                                                            <option value="@category.Id">@category.Name</option>
                                                                                        }
                                                                                    </select>
                                                                                    <small class="text-muted">Ctrl+Click لتحديد أكثر من واحد</small>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- ===== SECTION 6: MEDIA ===== -->
                                                                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                            <i class="fas fa-images"></i> الوسائط
                                                                        </h6>
                                                                        <div class="row">
                                                                            <div class="col-md-6">
                                                                                @* <div class="form-group mb-3">
                                                                                    <label asp-for="MainImage" class="form-label">رابط الصورة الرئيسية</label>
                                                                                    <input asp-for="MainImage" class="form-control" placeholder="https://example.com/image.jpg">
                                                                                        <span asp-validation-for="MainImage" class="text-danger"></span>
                                                                                    </div> *@
                                                                                    <div class="form-group mb-3">
                                                                                        <label asp-for="MainImage" class="form-label">رفع الصورة الرئيسية</label>
                                                                                        <input asp-for="MainImage" class="form-control" type="file" name="img" accept="image/*">
                                                                                        <span asp-validation-for="MainImage" class="text-muted"></span>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-md-6">
                                                                                    <div class="form-group mb-3">
                                                                                        <label class="form-label">صور إضافية (معرض الصور)</label>
                                                                                        <input class="form-control" type="file" name="galleryImages" multiple accept="image/*">
                                                                                        <small class="text-muted">يمكنك اختيار أكثر من صورة دفعة واحدة</small>
                                                                                    </div>
                                                                                    <div class="form-group mb-3">
                                                                                        <label asp-for="VideoUrl" class="form-label">رابط فيديو المنتج</label>
                                                                                        <input asp-for="VideoUrl" class="form-control" placeholder="https://youtube.com/...">
                                                                                            <span asp-validation-for="VideoUrl" class="text-danger"></span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- ===== SECTION 7: SEO ===== -->
                                                                                <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                                    <i class="fas fa-search"></i> تحسين محركات البحث (SEO)
                                                                                </h6>
                                                                                <div class="row">
                                                                                    <div class="col-md-4">
                                                                                        <div class="form-group mb-3">
                                                                                            <label asp-for="MetaTitle" class="form-label">Meta Title</label>
                                                                                            <input asp-for="MetaTitle" class="form-control" placeholder="عنوان SEO">
                                                                                                <span asp-validation-for="MetaTitle" class="text-danger"></span>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group mb-3">
                                                                                                <label asp-for="MetaDescription" class="form-label">Meta Description</label>
                                                                                                <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="وصف SEO"></textarea>
                                                                                                <span asp-validation-for="MetaDescription" class="text-danger"></span>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <div class="form-group mb-3">
                                                                                                <label asp-for="MetaKeywords" class="form-label">Meta Keywords</label>
                                                                                                <input asp-for="MetaKeywords" class="form-control" placeholder="كلمة1, كلمة2">
                                                                                                    <span asp-validation-for="MetaKeywords" class="text-danger"></span>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                        <!-- ===== SECTION 8: ADMIN SETTINGS ===== -->
                                                                                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                                                                                            <i class="fas fa-cogs"></i> إعدادات الأدمن
                                                                                        </h6>
                                                                                        <div class="row">
                                                                                            <!-- Display Options -->
                                                                                            <div class="col-md-4">
                                                                                                <p class="fw-bold mb-2 text-secondary small">خيارات العرض</p>
                                                                                                <div class="form-check mb-2">
                                                                                                    <input asp-for="Status" class="form-check-input" type="checkbox" checked>
                                                                                                        <label asp-for="Status" class="form-check-label">نشط (يظهر للعملاء)</label>
                                                                                                    </div>
                                                                                                    <div class="form-check mb-2">
                                                                                                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                                                                                                            <label asp-for="IsFeatured" class="form-check-label">منتج مميز</label>
                                                                                                        </div>
                                                                                                        <div class="form-check mb-2">
                                                                                                            <input asp-for="IsBestSeller" class="form-check-input" type="checkbox">
                                                                                                                <label asp-for="IsBestSeller" class="form-check-label">الأكثر مبيعاً</label>
                                                                                                            </div>
                                                                                                            <div class="form-check mb-2">
                                                                                                                <input asp-for="IsNew" class="form-check-input" type="checkbox" checked>
                                                                                                                    <label asp-for="IsNew" class="form-check-label">منتج جديد</label>
                                                                                                                </div>
                                                                                                            </div>

                                                                                                            <!-- Stock Options -->
                                                                                                            <div class="col-md-4">
                                                                                                                <p class="fw-bold mb-2 text-secondary small">إعدادات المخزون</p>
                                                                                                                <div class="form-check mb-2">
                                                                                                                    <input asp-for="ManageStock" class="form-check-input" type="checkbox" checked>
                                                                                                                        <label asp-for="ManageStock" class="form-check-label">تتبع المخزون</label>
                                                                                                                    </div>
                                                                                                                    <div class="form-check mb-2">
                                                                                                                        <input asp-for="IsInStock" class="form-check-input" type="checkbox" checked>
                                                                                                                            <label asp-for="IsInStock" class="form-check-label">متوفر في المخزون</label>
                                                                                                                        </div>
                                                                                                                        <div class="form-check mb-2">
                                                                                                                            <input asp-for="BackordersAllowed" class="form-check-input" type="checkbox">
                                                                                                                                <label asp-for="BackordersAllowed" class="form-check-label">السماح بالطلب المسبق</label>
                                                                                                                            </div>
                                                                                                                            <div class="form-check mb-2">
                                                                                                                                <input asp-for="HasVariations" class="form-check-input" type="checkbox">
                                                                                                                                    <label asp-for="HasVariations" class="form-check-label">لديه متغيرات (ألوان/أحجام)</label>
                                                                                                                                </div>
                                                                                                                            </div>

                                                                                                                            <!-- Shipping & Tax -->
                                                                                                                            <div class="col-md-4">
                                                                                                                                <p class="fw-bold mb-2 text-secondary small">الشحن والضريبة</p>
                                                                                                                                <div class="form-check mb-2">
                                                                                                                                    <input asp-for="RequiresShipping" class="form-check-input" type="checkbox" checked>
                                                                                                                                        <label asp-for="RequiresShipping" class="form-check-label">يحتاج شحن</label>
                                                                                                                                    </div>
                                                                                                                                    <div class="form-check mb-2">
                                                                                                                                        <input asp-for="Taxable" class="form-check-input" type="checkbox" checked>
                                                                                                                                            <label asp-for="Taxable" class="form-check-label">خاضع للضريبة</label>
                                                                                                                                        </div>
                                                                                                                                        <div class="form-check mb-2">
                                                                                                                                            <input asp-for="IsDownloadable" class="form-check-input" type="checkbox">
                                                                                                                                                <label asp-for="IsDownloadable" class="form-check-label">منتج رقمي (قابل للتحميل)</label>
                                                                                                                                            </div>
                                                                                                                                            <div class="form-check mb-2">
                                                                                                                                                <input asp-for="IsVirtual" class="form-check-input" type="checkbox">
                                                                                                                                                    <label asp-for="IsVirtual" class="form-check-label">منتج افتراضي (خدمة)</label>
                                                                                                                                                </div>

                                                                                                                                                <div class="form-group mt-3">
                                                                                                                                                    <label asp-for="TaxClass" class="form-label">فئة الضريبة</label>
                                                                                                                                                    <select asp-for="TaxClass" class="form-control">
                                                                                                                                                        <option value="">الافتراضي</option>
                                                                                                                                                        <option value="standard">Standard</option>
                                                                                                                                                        <option value="reduced">Reduced</option>
                                                                                                                                                        <option value="zero">Zero Rate</option>
                                                                                                                                                        <option value="exempt">Exempt</option>
                                                                                                                                                    </select>
                                                                                                                                                </div>
                                                                                                                                            </div>
                                                                                                                                        </div>

                                                                                                                                        <!-- Submit -->
                                                                                                                                        <div class="form-actions mt-4 pt-4 border-top">
                                                                                                                                            <button type="submit" class="btn btn-primary">
                                                                                                                                                <i class="fas fa-save"></i> إنشاء المنتج
                                                                                                                                            </button>
                                                                                                                                            <a asp-action="Index" class="btn btn-secondary ms-2">إلغاء</a>
                                                                                                                                        </div>
                                                                                                                                    </form>
                                                                                                                                </div>
                                                                                                                            </div>

                                                                                                                            <!-- Modal: Add New Color -->
                                                                                                                            <div class="modal fade" id="addColorModal" tabindex="-1" aria-hidden="true">
                                                                                                                                <div class="modal-dialog modal-dialog-centered">
                                                                                                                                    <div class="modal-content border-0 shadow">
                                                                                                                                        <div class="modal-header bg-primary text-white">
                                                                                                                                            <h5 class="modal-title">إضافة لون منتج جديد</h5>
                                                                                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                                                                                                        </div>
                                                                                                                                        <div class="modal-body">
                                                                                                                                            <div class="mb-3">
                                                                                                                                                <label class="form-label fw-bold">اسم اللون</label>
                                                                                                                                                <input type="text" id="newColorName" class="form-control" placeholder="مثلاً: أبيض لؤلؤي">
                                                                                                                                            </div>
                                                                                                                                            <div class="mb-3">
                                                                                                                                                <label class="form-label fw-bold">درجة اللون</label>
                                                                                                                                                <input type="color" id="newColorHex" class="form-control form-control-color w-100" value="#000000">
                                                                                                                                            </div>
                                                                                                                                        </div>
                                                                                                                                        <div class="modal-footer bg-light">
                                                                                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                                                                                                            <button type="button" class="btn btn-primary" onclick="saveNewColor()">حفظ اللون</button>
                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                </div>
                                                                                                                            </div>

                                                                                                                            @section Scripts {
                                                                                                                                <script>
                                                                                                                                    $(document).ready(function () {

                                                                                                                                        // Auto Slug from Name
                                                                                                                                        $('#Name').on('blur', function () {
                                                                                                                                            const name = $(this).val();
                                                                                                                                            if (name && !$('#Slug').val()) {
                                                                                                                                                const slug = name.toLowerCase().trim()
                                                                                                                                                    .replace(/[^\w\s-]/g, '')
                                                                                                                                                    .replace(/[\s_-]+/g, '-');
                                                                                                                                                $('#Slug').val(slug);
                                                                                                                                            }
                                                                                                                                        });

                                                                                                                                        // Add Composition Row
                                                                                                                                        let compIndex = $('.composition-row').length;
                                                                                                                                        $('#add-composition').click(function () {
                                                                                                                                            const html = `
                                                                                                                                            <div class="composition-row row mb-2 g-2 align-items-center">
                                                                                                                                                <div class="col-7">
                                                                                                                                                    <select name="ProductCompositions[${compIndex}].CompositionId" class="form-select form-control" required>
                                                                                                                                                        ${buildCompositionOptions()}
                                                                                                                                                    </select>
                                                                                                                                                </div>
                                                                                                                                                <div class="col-3">
                                                                                                                                                    <input type="number" name="ProductCompositions[${compIndex}].Percentage"
                                                                                                                                                           class="form-control" placeholder="%" min="1" max="100" required>
                                                                                                                                                </div>
                                                                                                                                                <div class="col-2">
                                                                                                                                                    <button type="button" class="btn btn-outline-danger btn-sm remove-composition">×</button>
                                                                                                                                                </div>
                                                                                                                                            </div>`;
                                                                                                                                            $('#composition-container').append(html);
                                                                                                                                            compIndex++;
                                                                                                                                        });

                                                                                                                                        $(document).on('click', '.remove-composition', function () {
                                                                                                                                            $(this).closest('.composition-row').remove();
                                                                                                                                        });
                                                                                                                                    });

                                                                                                                                    function buildCompositionOptions() {
                                                                                                                                        let options = '<option value="">اختر المادة</option>';
                                                                                                                                        $('#composition-container select').first().find('option').each(function () {
                                                                                                                                            if ($(this).val())
                                                                                                                                                options += `<option value="${$(this).val()}">${$(this).text()}</option>`;
                                                                                                                                        });
                                                                                                                                        return options;
                                                                                                                                    }

                                                                                                                                    function generateSKU() {
                                                                                                                                        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
                                                                                                                                        let sku = 'PROD-';
                                                                                                                                        for (let i = 0; i < 8; i++)
                                                                                                                                            sku += chars.charAt(Math.floor(Math.random() * chars.length));
                                                                                                                                        $('#SKU').val(sku);
                                                                                                                                    }

                                                                                                                                    function forceOpenModal() {
                                                                                                                                        $('.modal-backdrop').remove();
                                                                                                                                        $('.modal').hide().removeClass('show');
                                                                                                                                        $('body').removeClass('modal-open').css('overflow', '');

                                                                                                                                        var modalEl = document.getElementById('addColorModal');
                                                                                                                                        document.body.appendChild(modalEl);

                                                                                                                                        var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                                                                                                                                        modal.show();
                                                                                                                                    }

                                                                                                                                    function saveNewColor() {
                                                                                                                                        const name = $('#newColorName').val().trim();
                                                                                                                                        const hex = $('#newColorHex').val();

                                                                                                                                        if (!name) { alert("اكتب اسم اللون"); return; }

                                                                                                                                        $.post('/Admin/Products/AddNewColor', { name: name, hexCode: hex }, function (res) {
                                                                                                                                            if (res.success) {
                                                                                                                                                const newOption = new Option(res.name, res.id, true, true);
                                                                                                                                                $('#ColorId').append(newOption).trigger('change');

                                                                                                                                                $('.modal').hide().removeClass('show');
                                                                                                                                                $('.modal-backdrop').remove();
                                                                                                                                                $('body').removeClass('modal-open');
                                                                                                                                                $('#newColorName').val('');
                                                                                                                                            } else {
                                                                                                                                                alert(res.message);
                                                                                                                                            }
                                                                                                                                        });
                                                                                                                                    }
                                                                                                                                </script>
                                                                                                                            }