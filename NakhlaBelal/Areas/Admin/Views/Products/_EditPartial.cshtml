@model NakhlaBelal.Models.Product
@{
    var categories  = ViewBag.Categories      as List<NakhlaBelal.Models.Category>         ?? new List<NakhlaBelal.Models.Category>();
    var brands      = ViewBag.Brands          as List<NakhlaBelal.Models.Brand>            ?? new List<NakhlaBelal.Models.Brand>();
    var fabricTypes = ViewBag.FabricTypes     as List<NakhlaBelal.Models.FabricType>       ?? new List<NakhlaBelal.Models.FabricType>();
    var colors      = ViewBag.Colors          as List<NakhlaBelal.Models.Color>            ?? new List<NakhlaBelal.Models.Color>();
    var allTags     = ViewBag.ProductTags     as List<NakhlaBelal.Models.ProductTag>       ?? new List<NakhlaBelal.Models.ProductTag>();
    var allComps    = ViewBag.Compositions    as List<NakhlaBelal.Models.Composition>      ?? new List<NakhlaBelal.Models.Composition>();
    var allProjCats = ViewBag.ProjectCategories as List<NakhlaBelal.Models.ProjectCategory> ?? new List<NakhlaBelal.Models.ProjectCategory>();
    int compIndex   = 0;
}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="fas fa-edit me-2"></i>Edit: @Model.Name
    </h5>
    <button type="button" class="btn-close btn-close-white" onclick="closeModal()"></button>
</div>

<form id="editProductForm" method="post"
      action="/Admin/Products/Edit/@Model.Id"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id"            value="@Model.Id" />
    <input type="hidden" name="CreatedAt"     value="@Model.CreatedAt" />
    <input type="hidden" name="CreatedBy"     value="@Model.CreatedBy" />
    <input type="hidden" name="AverageRating" value="@Model.AverageRating" />

    <div class="modal-body" style="max-height: 72vh; overflow-y: auto;">

        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        @* ===== TABS ===== *@
        <ul class="nav nav-tabs mb-3" id="editModalTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#etab-basic" type="button">
                    <i class="fas fa-tag"></i> Basic
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#etab-pricing" type="button">
                    <i class="fas fa-dollar-sign"></i> Pricing
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#etab-fabric" type="button">
                    <i class="fas fa-ruler-combined"></i> Fabric
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#etab-media" type="button">
                    <i class="fas fa-images"></i> Media
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#etab-settings" type="button">
                    <i class="fas fa-cog"></i> Settings
                </button>
            </li>
        </ul>

        <div class="tab-content">

            @* ===== TAB: BASIC ===== *@
            <div class="tab-pane fade show active" id="etab-basic" role="tabpanel">
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label fw-bold">
                            Product Name <span class="text-danger">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.Name, new {
                            @class = "form-control",
                            required = "required",
                            placeholder = "Product name"
                        })
                        @Html.ValidationMessageFor(m => m.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">SKU</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.SKU, new { @class = "form-control", placeholder = "PROD-001" })
                            <button type="button" class="btn btn-outline-secondary" onclick="peditGenSKU()">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.SKU, null, new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Category <span class="text-danger">*</span>
                        </label>
                        <select name="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId ? "selected" : "")">
                                    @cat.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Brand</label>
                        <select name="BrandId" class="form-select">
                            <option value="">-- Select Brand --</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id" selected="@(brand.Id == Model.BrandId ? "selected" : "")">
                                    @brand.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Short Description</label>
                    @Html.TextAreaFor(m => m.ShortDescription, new {
                        @class = "form-control",
                        rows = "2",
                        placeholder = "Brief summary for product listings"
                    })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Full Description</label>
                    @Html.TextAreaFor(m => m.Description, new {
                        @class = "form-control",
                        rows = "3",
                        placeholder = "Detailed product description"
                    })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Tags</label>
                        <select name="SelectedTagIds" multiple class="form-select" style="height: 100px;">
                            @foreach (var tag in allTags)
                            {
                                bool sel = Model.ProductTags != null && Model.ProductTags.Any(t => t.Id == tag.Id);
                                <option value="@tag.Id" selected="@(sel ? "selected" : "")">@tag.Name</option>
                            }
                        </select>
                        <small class="text-muted">Hold Ctrl to select multiple</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Project Categories</label>
                        <div class="border rounded p-2" style="max-height: 100px; overflow-y: auto;">
                            @foreach (var pc in allProjCats)
                            {
                                bool sel = Model.ProjectCategories != null && Model.ProjectCategories.Any(p => p.Id == pc.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedProjectCategoryIds"
                                           value="@pc.Id"
                                           id="epcat_@pc.Id"
                                           @(sel ? "checked" : "") />
                                    <label class="form-check-label" for="epcat_@pc.Id">@pc.Name</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Barcode</label>
                        @Html.TextBoxFor(m => m.Barcode, new {
                            @class = "form-control",
                            placeholder = "6281234567890"
                        })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">URL Slug</label>
                        <div class="input-group">
                            <span class="input-group-text">/product/</span>
                            @Html.TextBoxFor(m => m.Slug, new { @class = "form-control", placeholder = "product-slug" })
                        </div>
                    </div>
                </div>
            </div>

            @* ===== TAB: PRICING ===== *@
            <div class="tab-pane fade" id="etab-pricing" role="tabpanel">
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">
                            Selling Price <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            @Html.TextBoxFor(m => m.Price, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                required = "required"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Price, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Cost Price</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            @Html.TextBoxFor(m => m.CostPrice, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0"
                            })
                        </div>
                    </div>           

                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label class="form-label">Unit Price</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.UnitPrice, new
                                {
                                    @class = "form-control",
                                    type = "text"
                                })
                            </div>
                        </div>
                    </div>

                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Discount %</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Discount, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                max = "100"
                            })
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 bg-light mb-3">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-tag me-1"></i> Special Price (Optional)
                    </h6>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Special Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                @Html.TextBoxFor(m => m.SpecialPrice, new {
                                    @class = "form-control",
                                    type = "number",
                                    step = "0.01",
                                    min = "0"
                                })
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Start Date</label>
                            @Html.TextBoxFor(m => m.SpecialPriceStart, new {
                                @class = "form-control",
                                type = "date"
                            })
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">End Date</label>
                            @Html.TextBoxFor(m => m.SpecialPriceEnd, new {
                                @class = "form-control",
                                type = "date"
                            })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">
                            Stock Quantity <span class="text-danger">*</span>
                        </label>
                        @Html.TextBoxFor(m => m.StockQuantity, new {
                            @class = "form-control",
                            type = "number",
                            min = "0",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.StockQuantity, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Low Stock Alert</label>
                        @Html.TextBoxFor(m => m.LowStockThreshold, new {
                            @class = "form-control",
                            type = "number",
                            min = "0",
                            placeholder = "10"
                        })
                        <small class="text-muted">Alert when stock falls below this</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Unit" class="form-label fw-bold">Sales Unit</label>
                        <select asp-for="Unit" class="form-select"
                                asp-items="Html.GetEnumSelectList<NakhlaBelal.Models.ProductUnit>()"></select>
                        @Html.ValidationMessageFor(m => m.Unit, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="MinimumQuantity" class="form-label fw-bold">Minimum Quantity</label>
                        @Html.TextBoxFor(m => m.MinimumQuantity, new { @class = "form-control", type = "number", min = "1" })
                        @Html.ValidationMessageFor(m => m.MinimumQuantity, null, new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="QuantityStep" class="form-label fw-bold">Quantity Step</label>
                        @Html.TextBoxFor(m => m.QuantityStep, new { @class = "form-control", type = "number", min = "1" })
                        @Html.ValidationMessageFor(m => m.QuantityStep, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            @* ===== TAB: FABRIC ===== *@
            <div class="tab-pane fade" id="etab-fabric" role="tabpanel">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Weight (g/m²)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Weight, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                placeholder = "e.g. 180"
                            })
                            <span class="input-group-text">g/m²</span>
                        </div>
                        <small class="text-muted">Fabric weight per square meter</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Width (cm)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Width, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                placeholder = "e.g. 150"
                            })
                            <span class="input-group-text">cm</span>
                        </div>
                        <small class="text-muted">Fabric roll width</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Height / Alert (m)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Height, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                placeholder = "e.g. 50"
                            })
                            <span class="input-group-text">m</span>
                        </div>
                        <small class="text-muted">Min roll length threshold</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Roll Length (m)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Length, new {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0",
                                placeholder = "e.g. 100"
                            })
                            <span class="input-group-text">m</span>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Fabric Type</label>
                        <select name="FabricTypeId" class="form-select">
                            <option value="">-- Select --</option>
                            @foreach (var ft in fabricTypes)
                            {
                                <option value="@ft.Id" selected="@(ft.Id == Model.FabricTypeId ? "selected" : "")">
                                    @ft.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Color</label>
                        <select name="ColorId" class="form-select">
                            <option value="">-- Select Color --</option>
                            @foreach (var c in colors)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.ColorId ? "selected" : "")">
                                    @c.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>

                @* COMPOSITION *@
                <div class="border-top pt-3 mt-2">
                    <label class="form-label fw-bold">
                        <i class="fas fa-percentage me-1"></i>Fabric Composition
                    </label>
                    <div id="pedit-comp-container">
                        @foreach (var pc in (Model.ProductCompositions ?? new List<NakhlaBelal.Models.ProductComposition>()))
                        {
                            <div class="composition-row row mb-2 g-2 align-items-center">
                                <div class="col-7">
                                    <select name="ProductCompositions[@compIndex].CompositionId"
                                            class="form-select" required>
                                        <option value="">Select Material</option>
                                        @foreach (var comp in allComps)
                                        {
                                            if (pc.CompositionId == comp.Id)
                                            {
                                                <option value="@comp.Id" selected>@comp.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@comp.Id">@comp.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-3">
                                    <div class="input-group">
                                        <input type="number"
                                               name="ProductCompositions[@compIndex].Percentage"
                                               class="form-control"
                                               value="@pc.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               min="1" max="100" step="0.01" required />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-2">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm w-100 remove-comp-btn">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            compIndex++;
                        }
                    </div>
                    <button type="button" id="pedit-add-comp"
                            class="btn btn-sm btn-outline-primary mt-2">
                        <i class="fas fa-plus"></i> Add Material
                    </button>
                </div>
            </div>

            @* ===== TAB: MEDIA ===== *@
            <div class="tab-pane fade" id="etab-media" role="tabpanel">
                <div class="mb-3">
                    <label class="form-label fw-bold">Main Image</label>
                    <div class="text-center mb-2">
                        <img id="peditMainPreview"
                             src="@(string.IsNullOrEmpty(Model.MainImage) ? "/images/no-image.png" : "/images/" + Model.MainImage)"
                             class="img-thumbnail"
                             style="max-height: 150px; object-fit: cover;" />
                    </div>
                    <input type="file" name="img" class="form-control" accept="image/*"
                           onchange="peditPreviewImg(this, 'peditMainPreview')" />
                    <small class="text-muted">Leave empty to keep current image</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Add Gallery Images</label>
                    <input type="file" name="galleryImages" class="form-control"
                           multiple accept="image/*" />
                    <small class="text-muted">Select multiple images at once</small>
                </div>

                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Current Gallery</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.ProductImages.OrderBy(i => i.DisplayOrder))
                            {
                                <div id="pedit-gimg-@img.Id" class="text-center">
                                    <img src="~/images/product_images/@img.ImageUrl"
                                         class="img-thumbnail"
                                         style="width: 80px; height: 80px; object-fit: cover;" />
                                    <div>
                                        <button type="button"
                                                class="btn btn-danger btn-sm mt-1"
                                                onclick="peditDeleteGallery(@img.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold">Video URL</label>
                    @Html.TextBoxFor(m => m.VideoUrl, new {
                        @class = "form-control",
                        placeholder = "https://youtube.com/..."
                    })
                </div>
            </div>

            @* ===== TAB: SETTINGS ===== *@
            <div class="tab-pane fade" id="etab-settings" role="tabpanel">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2 mb-3">
                            <i class="fas fa-eye me-1"></i>Display
                        </h6>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.Status, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.Status, "Active (Visible on site)", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsFeatured, new { @class = "form-check-input", role = "switch" })
                            <label class="form-check-label">
                                <i class="fas fa-star text-warning"></i> Featured
                            </label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsBestSeller, new { @class = "form-check-input", role = "switch" })
                            <label class="form-check-label">
                                <i class="fas fa-fire text-danger"></i> Best Seller
                            </label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsNew, new { @class = "form-check-input", role = "switch" })
                            <label class="form-check-label">
                                <i class="fas fa-certificate text-success"></i> New Arrival
                            </label>
                        </div>

                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                            <i class="fas fa-search me-1"></i>SEO
                        </h6>
                        <div class="mb-3">
                            <label class="form-label">Meta Title</label>
                            @Html.TextBoxFor(m => m.MetaTitle, new {
                                @class = "form-control",
                                placeholder = "SEO title (max 60 chars)"
                            })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Meta Description</label>
                            @Html.TextAreaFor(m => m.MetaDescription, new {
                                @class = "form-control",
                                rows = "2",
                                placeholder = "SEO description (max 160 chars)"
                            })
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Meta Keywords</label>
                            @Html.TextBoxFor(m => m.MetaKeywords, new {
                                @class = "form-control",
                                placeholder = "keyword1, keyword2, ..."
                            })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2 mb-3">
                            <i class="fas fa-warehouse me-1"></i>Stock
                        </h6>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.ManageStock, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.ManageStock, "Manage Stock", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsInStock, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsInStock, "In Stock", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.BackordersAllowed, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.BackordersAllowed, "Allow Backorders", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.HasVariations, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.HasVariations, "Has Variations", new { @class = "form-check-label" })
                        </div>

                        <h6 class="text-muted border-bottom pb-2 mb-3 mt-4">
                            <i class="fas fa-truck me-1"></i>Shipping & Tax
                        </h6>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.RequiresShipping, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.RequiresShipping, "Requires Shipping", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.Taxable, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.Taxable, "Taxable", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsVirtual, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsVirtual, "Virtual Product", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-switch mb-3">
                            @Html.CheckBoxFor(m => m.IsDownloadable, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsDownloadable, "Downloadable", new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
            </div>

        </div>@* end tab-content *@
    </div>@* end modal-body *@

    <div class="modal-footer">
        <small class="text-muted me-auto">
            <a href="/Admin/Products/Edit/@Model.Id" target="_blank">
                <i class="fas fa-external-link-alt"></i> Open full edit page
            </a>
        </small>
        <button type="button" class="btn btn-secondary" onclick="closeModal()">
            <i class="fas fa-times"></i> Cancel
        </button>
        <button type="submit" class="btn btn-primary" id="peditSubmitBtn">
            <i class="fas fa-save"></i> Save Changes
        </button>
    </div>
</form>

<script>
(function () {
    let peditCompIndex = @compIndex;

    // ===== COMPOSITION: ADD =====
    document.getElementById('pedit-add-comp').addEventListener('click', function () {
        let options = '<option value="">Select Material</option>';
        @foreach (var comp in allComps)
        {
            <text>options += '<option value="@comp.Id">@comp.Name</option>';</text>
        }

        const row = document.createElement('div');
        row.className = 'composition-row row mb-2 g-2 align-items-center';
        row.innerHTML = `
            <div class="col-7">
                <select name="ProductCompositions[${peditCompIndex}].CompositionId"
                        class="form-select" required>
                    ${options}
                </select>
            </div>
            <div class="col-3">
                <div class="input-group">
                    <input type="number"
                           name="ProductCompositions[${peditCompIndex}].Percentage"
                           class="form-control" placeholder="%" min="1" max="100" required />
                    <span class="input-group-text">%</span>
                </div>
            </div>
            <div class="col-2">
                <button type="button"
                        class="btn btn-outline-danger btn-sm w-100 remove-comp-btn">
                    <i class="fas fa-times"></i>
                </button>
            </div>`;
        document.getElementById('pedit-comp-container').appendChild(row);
        peditCompIndex++;
    });

    // ===== COMPOSITION: REMOVE =====
    document.getElementById('pedit-comp-container').addEventListener('click', function (e) {
        const btn = e.target.closest('.remove-comp-btn');
        if (btn) btn.closest('.composition-row').remove();
    });

    // ===== AJAX SUBMIT with FormData (supports file uploads) =====
    document.getElementById('editProductForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const btn = document.getElementById('peditSubmitBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        btn.disabled = true;

        fetch(this.action, {
            method: 'POST',
            body: new FormData(this)
        })
        .then(r => r.json())
        .then(function (res) {
            if (res.success) {
                if (typeof closeModal === 'function') closeModal();
                location.reload();
            } else {
                alert(res.error || 'Error saving product');
                btn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
                btn.disabled = false;
            }
        })
        .catch(function () {
            alert('Server error. Please try again.');
            btn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
            btn.disabled = false;
        });
    });

    // ===== DELETE GALLERY IMAGE =====
    window.peditDeleteGallery = function (imageId) {
        if (!confirm('Delete this image permanently?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Admin/Products/DeleteImage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `imageId=${imageId}&__RequestVerificationToken=${encodeURIComponent(token)}`
        })
        .then(r => r.json())
        .then(function (res) {
            if (res.success) {
                const el = document.getElementById('pedit-gimg-' + imageId);
                if (el) el.remove();
            } else {
                alert(res.message || 'Error deleting image');
            }
        })
        .catch(() => alert('Server error'));
    };

    // ===== IMAGE PREVIEW =====
    window.peditPreviewImg = function (input, previewId) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById(previewId).src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    };

    // ===== SKU GENERATOR =====
    window.peditGenSKU = function () {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let sku = 'PROD-';
        for (let i = 0; i < 8; i++) {
            sku += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        document.getElementById('SKU').value = sku;
    };
})();
</script>