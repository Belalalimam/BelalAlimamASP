@model List<NakhlaBelal.Models.Color>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Colors";
}

<div class="content-card">
    <div class="content-card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">Colors</h2>
            <p class="text-muted mb-0">@ViewBag.Subtitle</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#colorCreate">
            <i class="fas fa-plus me-1"></i> New color
        </button>
    </div>

    @if (TempData["success-notification"] != null)
    {
        <div class="alert alert-success m-3">@TempData["success-notification"]</div>
    }
    @if (TempData["error-notification"] != null)
    {
        <div class="alert alert-danger m-3">@TempData["error-notification"]</div>
    }

    <div class="p-3">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-palette fa-3x mb-3"></i>
                <p>No colors yet. Create your first one to let customers filter by color.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px">Swatch</th>
                            <th>Name</th>
                            <th>Hex</th>
                            <th>Products</th>
                            <th class="text-end" style="width:160px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <span style="display:inline-block;width:34px;height:34px;border-radius:50%;border:1px solid #ddd;background:@c.HexCode"></span>
                                </td>
                                <td class="fw-semibold">@c.Name</td>
                                <td><code>@c.HexCode</code></td>
                                <td><span class="badge bg-light text-dark">@(c.Products?.Count ?? 0)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#colorEdit"
                                            data-id="@c.Id" data-name="@c.Name" data-hex="@c.HexCode"
                                            data-desc="@c.Description" data-img="@c.ImageUrl">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this color?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Create modal *@
<div class="modal fade" id="colorCreate" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">New color</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" required /></div>
                <div class="mb-3"><label class="form-label">Hex code *</label><input class="form-control" name="HexCode" placeholder="#ff00aa" required /></div>
                <div class="mb-3"><label class="form-label">Image URL</label><input class="form-control" name="ImageUrl" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
        </form>
    </div>
</div>

@* Edit modal *@
<div class="modal fade" id="colorEdit" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Edit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="ed-id" />
            <div class="modal-header"><h5 class="modal-title">Edit color</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Name *</label><input class="form-control" name="Name" id="ed-name" required /></div>
                <div class="mb-3"><label class="form-label">Hex code *</label><input class="form-control" name="HexCode" id="ed-hex" required /></div>
                <div class="mb-3"><label class="form-label">Image URL</label><input class="form-control" name="ImageUrl" id="ed-img" /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Description" id="ed-desc" rows="2"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('colorEdit').addEventListener('show.bs.modal', function (ev) {
        var b = ev.relatedTarget;
        document.getElementById('ed-id').value   = b.getAttribute('data-id');
        document.getElementById('ed-name').value = b.getAttribute('data-name');
        document.getElementById('ed-hex').value  = b.getAttribute('data-hex');
        document.getElementById('ed-img').value  = b.getAttribute('data-img') || '';
        document.getElementById('ed-desc').value = b.getAttribute('data-desc') || '';
    });
</script>
}
