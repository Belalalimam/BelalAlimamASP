@model List<NakhlaBelal.Models.Wishlist>
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["My Wishlist"].Value;
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0"><i class="ri-heart-fill text-danger me-2"></i>@L["My Wishlist"]</h2>
        <span class="badge bg-dark rounded-pill">@Model.Count</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="ri-heart-line" style="font-size:64px;color:#ccc;"></i>
            <h4 class="mt-3">@L["Your wishlist is empty"]</h4>
            <p class="text-muted">@L["Browse fabrics and tap the heart to save them here."]</p>
            <a class="btn btn-dark rounded-pill px-4" href="/Customer/Home/Product">@L["Browse fabrics"]</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var w in Model)
            {
                if (w.Product == null) { continue; }
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <a href="@Url.Action("Details","Home", new { id = w.ProductId, area="Customer" })">
                            <img src="~/images/@w.Product.MainImage" class="w-100" style="height:180px;object-fit:cover;" />
                        </a>
                        <div class="p-3">
                            <small class="text-muted">@w.Product.Category?.Name</small>
                            <h6 class="fw-bold mb-2"><a class="text-dark text-decoration-none" href="@Url.Action("Details","Home", new { id = w.ProductId, area="Customer" })">@w.Product.Name</a></h6>
                            <div class="fw-bold mb-2">€ @w.Product.Price.ToString("N2")</div>
                            <form asp-action="Remove" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@w.Id" />
                                <button class="btn btn-sm btn-outline-danger w-100 rounded-pill"><i class="ri-delete-bin-line me-1"></i>@L["Remove"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
