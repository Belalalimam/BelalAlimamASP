@model List<NakhlaBelal.Models.Wishlist>
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["My Wishlist"].Value;
}

<div class="eg-wl-root">

    @* ── Page Header ── *@
    <div class="eg-wl-header">
        <h1 class="eg-wl-heading">
            <i class="ri-heart-fill"></i>
            @L["My Wishlist"]
            <span class="eg-wl-count-badge">@Model.Count</span>
        </h1>
        @if (Model.Any())
        {
            <a class="eg-wl-clear-btn"
               href="@Url.Action("ClearAll", "Wishlist", new { area = "Customer" })"
               onclick="return confirm('@L["Are you sure you want to clear your wishlist?"]')">
                <i class="ri-delete-bin-line"></i> @L["Clear All"]
            </a>
        }
    </div>

    @* ── Empty State ── *@
    @if (!Model.Any())
    {
        <div class="eg-wl-empty">
            <div class="eg-wl-empty-icon">
                <i class="ri-heart-line"></i>
            </div>
            <h4>@L["Your wishlist is empty"]</h4>
            <p>@L["Browse fabrics and tap the heart to save them here."]</p>
            <a class="eg-wl-browse-btn" href="/Customer/Home/Product">
                <i class="ri-layout-grid-line"></i> @L["Browse fabrics"]
            </a>
        </div>
    }
    else
    {
        @* ── Product Grid ── *@
        <div class="eg-wl-grid" id="wlGrid">
            @foreach (var w in Model)
            {
                if (w.Product == null) { continue; }

                var detailUrl = Url.Action("Details", "Home", new { id = w.ProductId, area = "Customer" });
                var hasDiscount = w.Product.IsOnSale;
                var displayPrice = w.Product.FinalPrice;
                var discountPct = hasDiscount && w.Product.Price > 0
                    ? (int)Math.Round((1 - (double)w.Product.FinalPrice / (double)w.Product.Price) * 100)
                    : 0;

                <div class="eg-wl-card" data-wl-id="@w.Id">

                    @* Image wrap *@
                    <a href="@detailUrl" class="eg-wl-imgwrap">
                        <img src="~/images/@w.Product.MainImage"
                             alt="@w.Product.Name"
                             loading="lazy" />
                        <div class="eg-wl-quickview">
                            <i class="ri-eye-line"></i>
                        </div>
                        @if (hasDiscount)
                        {
                            <span class="eg-wl-badge">-@discountPct%</span>
                        }
                    </a>

                    @* Card body *@
                    <div class="eg-wl-body">
                        <span class="eg-wl-cat">@w.Product.Category?.Name</span>
                        <h6 class="eg-wl-name">
                            <a href="@detailUrl">@w.Product.Name</a>
                        </h6>
                        <div class="eg-wl-price">
                            € @displayPrice.ToString("N2")
                            @if (hasDiscount)
                            {
                                <span class="eg-wl-price-old">€ @w.Product.Price.ToString("N2")</span>
                            }
                        </div>

                        @* Actions *@
                        <div class="eg-wl-actions">
                            <a href="@detailUrl" class="eg-wl-btn eg-wl-cart">
                                <i class="ri-shopping-basket-line"></i> @L["Add to Cart"]
                            </a>
                            <form asp-action="Remove" method="post" class="eg-wl-remove-form"
                                  onsubmit="return animateRemove(event, this)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@w.Id" />
                                <button type="submit" class="eg-wl-btn eg-wl-remove" title="@L["Remove"]">
                                    <i class="ri-delete-bin-line"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@section Scripts {
<script>
    /* Animate card out before form submit */
    function animateRemove(e, form) {
        e.preventDefault();
        var card = form.closest('.eg-wl-card');
        if (card) card.classList.add('removing');
        setTimeout(function () { form.submit(); }, 300);
        return false;
    }
</script>
}
