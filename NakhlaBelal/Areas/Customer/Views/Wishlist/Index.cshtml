@model List<NakhlaBelal.Models.Wishlist>
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> L

@{
    ViewData["Title"] = L["My Wishlist"].Value;
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0"><i class="ri-heart-fill text-danger me-2"></i>@L["My Wishlist"]</h2>
        <span class="badge bg-dark rounded-pill">@Model.Count</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="ri-heart-line" style="font-size:64px;color:#ccc;"></i>
            <h4 class="mt-3">@L["Your wishlist is empty"]</h4>
            <p class="text-muted">@L["Browse fabrics and tap the heart to save them here."]</p>
            <a class="btn btn-dark rounded-pill px-4" href="/Customer/Home/Product">@L["Browse fabrics"]</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var w in Model)
            {
                if (w.Product == null) { continue; }
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="eg-wl-card">
                        @* Image *@
                        <a href="@Url.Action("Details","Home", new { id = w.ProductId, area="Customer" })" class="eg-wl-imgwrap">
                            <img src="~/images/@w.Product.MainImage" alt="@w.Product.Name" />
                            <div class="eg-wl-quickview"><i class="ri-eye-line"></i></div>
                        </a>
                        @* Body *@
                        <div class="eg-wl-body">
                            <small class="eg-wl-cat">@w.Product.Category?.Name</small>
                            <h6 class="eg-wl-name">
                                <a href="@Url.Action("Details","Home", new { id = w.ProductId, area="Customer" })">@w.Product.Name</a>
                            </h6>
                            <div class="eg-wl-price">€ @w.Product.Price.ToString("N2")</div>
                            <div class="eg-wl-actions">
                                @* Add to Cart *@
                                <a href="@Url.Action("Details","Home", new { id = w.ProductId, area="Customer" })"
                                   class="eg-wl-btn eg-wl-cart">
                                    <i class="ri-shopping-basket-line"></i> @L["Add to Cart"]
                                </a>
                                @* Remove *@
                                <form asp-action="Remove" method="post" class="eg-wl-remove-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@w.Id" />
                                    <button type="submit" class="eg-wl-btn eg-wl-remove" title="@L["Remove"]">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
        .eg-wl-card {
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
            border: 1px solid rgba(212,160,23,.18);
            box-shadow: 0 2px 10px rgba(0,59,111,.07);
            transition: transform .25s, box-shadow .25s;
            height: 100%;
            display: flex; flex-direction: column;
        }
        .eg-wl-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(0,59,111,.14);
        }
        .eg-wl-imgwrap {
            position: relative; display: block; overflow: hidden;
            aspect-ratio: 4/3; background: #F0E6C8;
        }
        .eg-wl-imgwrap img { width:100%; height:100%; object-fit:cover; display:block; transition: transform .4s; }
        .eg-wl-card:hover .eg-wl-imgwrap img { transform: scale(1.05); }
        .eg-wl-quickview {
            position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            background: rgba(0,27,53,.4);
            color: #fff; font-size: 22px;
            opacity: 0; transition: opacity .25s;
        }
        .eg-wl-card:hover .eg-wl-quickview { opacity: 1; }
        .eg-wl-body { padding: 12px 14px 14px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
        .eg-wl-cat  { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #B8860B; }
        .eg-wl-name a { font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 700; color: #1A2B3C; text-decoration: none; }
        .eg-wl-name a:hover { color: #003B6F; }
        .eg-wl-price { font-size: 14px; font-weight: 800; color: #003B6F; font-family: 'Cairo', sans-serif; }
        .eg-wl-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 8px; }
        .eg-wl-btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 7px 10px; border-radius: 6px;
            font-size: 12px; font-weight: 700; font-family: 'Cairo', sans-serif;
            cursor: pointer; border: none; text-decoration: none;
            transition: background .15s, transform .15s;
        }
        .eg-wl-cart { background: #003B6F; color: #fff; flex: 1; justify-content: center; }
        .eg-wl-cart:hover { background: #D4A017; color: #1A2B3C; }
        .eg-wl-remove { background: #fdf0ee; color: #c0392b; flex-shrink: 0; }
        .eg-wl-remove:hover { background: #c0392b; color: #fff; }
        .eg-wl-remove-form { display: contents; }
        </style>
    }
</div>
