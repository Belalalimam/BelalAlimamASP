@{
    ViewData["Title"] = "تتبع الطلب";
    var prefilled = ViewBag.PrefilledOrderNumber as string;
}

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="text-center mb-5">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#002211" viewBox="0 0 16 16">
                        <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7zm1.294 7.456A1.999 1.999 0 0 1 4.732 11h5.536a2.01 2.01 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456zM12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12v4zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                    </svg>
                </div>
                <h1 class="display-5 fw-bold mb-2" style="color:#002211;">تتبع طلبك</h1>
                <p class="text-muted">أدخل رقم الطلب والبريد الإلكتروني للاطلاع على حالة الشحن</p>
            </div>

            @if (TempData["error-notification"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["error-notification"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Track" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="orderNumber" class="form-label fw-bold">
                                <i class="fas fa-hashtag me-1 text-muted"></i> رقم الطلب
                            </label>
                            <input type="text"
                                   id="orderNumber"
                                   name="orderNumber"
                                   value="@prefilled"
                                   class="form-control form-control-lg"
                                   placeholder="ORD-20260417-XXXXXX"
                                   required />
                            <small class="text-muted">ستجده في رسالة تأكيد الطلب المُرسلة إليك</small>
                        </div>

                        <div class="mb-4">
                            <label for="email" class="form-label fw-bold">
                                <i class="fas fa-envelope me-1 text-muted"></i> البريد الإلكتروني
                            </label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control form-control-lg"
                                   placeholder="you@example.com"
                                   required />
                            <small class="text-muted">نفس البريد الذي استخدمته عند إتمام الطلب</small>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg fw-bold py-3 text-white eg-track-btn">
                                <i class="ri-search-line me-2"></i> تتبع الطلب
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">
                    تحتاج مساعدة؟
                    <a href="/" class="text-decoration-none fw-bold" style="color:#002211;">تواصل معنا</a>
                </small>
            </div>

        </div>
    </div>
</div>

<style>
/* Egypt tracking theme */
body { background-color: #F4F0E8; }
.form-control:focus {
    border-color: #003B6F;
    box-shadow: 0 0 0 0.2rem rgba(0,59,111,.15);
}
.card { border-radius: 14px !important; }

/* Tracking page header icon color */
.container svg { fill: #003B6F !important; }

/* Track button */
.eg-track-btn {
    background: #003B6F !important;
    border-color: #003B6F !important;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
}
.eg-track-btn:hover { background: #002a52 !important; transform: translateY(-2px); }
.display-5 { color: #003B6F !important; }

/* ── Order tracking timeline (shown after result is found) ── */
.eg-track-timeline {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    margin: 32px auto 0;
    max-width: 560px;
    padding: 24px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(212,160,23,.18);
    box-shadow: 0 4px 18px rgba(0,59,111,.08);
}
.eg-tr-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
.eg-tr-dot {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 2.5px solid #e0dbd0;
    background: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #ccc;
    z-index: 2; position: relative;
}
.eg-tr-label { font-size: 11px; font-weight: 700; color: #bbb; font-family: 'Cairo', sans-serif; text-align: center; }
.eg-tr-bar { flex: 1; height: 2px; background: #e0dbd0; align-self: center; min-width: 20px; max-width: 60px; margin-bottom: 26px; }
.eg-tr-step.done .eg-tr-dot { background: #2a7d4f; border-color: #2a7d4f; color: #fff; }
.eg-tr-step.done .eg-tr-label { color: #2a7d4f; }
.eg-tr-step.current .eg-tr-dot {
    background: #003B6F; border-color: #003B6F; color: #fff;
    box-shadow: 0 0 0 5px rgba(0,59,111,.15);
}
.eg-tr-step.current .eg-tr-label { color: #003B6F; }
.eg-tr-bar.done { background: #2a7d4f; }
</style>
