@{ ViewBag.Title = "اختصارات الألياف"; }
<partial name="_InfoPageStyles" />

<div class="info-page" dir="rtl">
    <div class="info-hero">
        <span class="icon-big">🔤</span>
        <h1>اختصارات ألياف الأقمشة</h1>
        <p>دليل فهم ملصقات تركيب القماش (Composition Label)</p>
    </div>

    <div class="info-container">
        <div class="info-card">
            <h2>الألياف الطبيعية</h2>
            <table class="info-table">
                <thead><tr><th>الاختصار</th><th>المعنى الكامل</th><th>الاسم العربي</th></tr></thead>
                <tbody>
                    <tr><td><strong>CO</strong></td><td>Cotton</td><td>قطن</td></tr>
                    <tr><td><strong>WO</strong></td><td>Wool</td><td>صوف</td></tr>
                    <tr><td><strong>LI</strong></td><td>Linen / Flax</td><td>كتان</td></tr>
                    <tr><td><strong>SE</strong></td><td>Silk</td><td>حرير</td></tr>
                    <tr><td><strong>CA</strong></td><td>Cashmere</td><td>كشمير</td></tr>
                    <tr><td><strong>WM</strong></td><td>Mohair</td><td>موهير (صوف ماعز أنجورا)</td></tr>
                    <tr><td><strong>HA</strong></td><td>Hemp</td><td>قنّب</td></tr>
                    <tr><td><strong>AL</strong></td><td>Alpaca</td><td>صوف الألبكة</td></tr>
                </tbody>
            </table>
        </div>

        <div class="info-card">
            <h2>الألياف شبه الصناعية</h2>
            <table class="info-table">
                <thead><tr><th>الاختصار</th><th>المعنى الكامل</th><th>الاسم العربي</th></tr></thead>
                <tbody>
                    <tr><td><strong>VI</strong></td><td>Viscose / Rayon</td><td>فيسكوز / رايون</td></tr>
                    <tr><td><strong>MD</strong></td><td>Modal</td><td>مودال</td></tr>
                    <tr><td><strong>CV</strong></td><td>Rayon</td><td>رايون</td></tr>
                    <tr><td><strong>LY</strong></td><td>Lyocell / Tencel</td><td>ليوسيل / تنسل</td></tr>
                    <tr><td><strong>CUP</strong></td><td>Cupro</td><td>كوبرو</td></tr>
                    <tr><td><strong>BAM</strong></td><td>Bamboo</td><td>بامبو</td></tr>
                </tbody>
            </table>
        </div>

        <div class="info-card">
            <h2>الألياف الصناعية</h2>
            <table class="info-table">
                <thead><tr><th>الاختصار</th><th>المعنى الكامل</th><th>الاسم العربي</th></tr></thead>
                <tbody>
                    <tr><td><strong>PL / PES</strong></td><td>Polyester</td><td>بوليستر</td></tr>
                    <tr><td><strong>PA</strong></td><td>Polyamide / Nylon</td><td>نايلون</td></tr>
                    <tr><td><strong>EA / EL</strong></td><td>Elastane / Spandex / Lycra</td><td>ليكرا (مطاط)</td></tr>
                    <tr><td><strong>AC</strong></td><td>Acrylic</td><td>أكريليك</td></tr>
                    <tr><td><strong>PU</strong></td><td>Polyurethane</td><td>بولي يوريثين</td></tr>
                    <tr><td><strong>PP</strong></td><td>Polypropylene</td><td>بولي بروبيلين</td></tr>
                </tbody>
            </table>
        </div>

        <div class="info-card">
            <h2>كيف تقرأ الملصق؟</h2>
            <p>مثال: <strong>"95% CO, 5% EA"</strong> يعني:</p>
            <ul>
                <li>95% قطن</li>
                <li>5% ليكرا (مطاط لإعطاء القماش مرونة)</li>
            </ul>
            <p>مثال: <strong>"70% VI, 25% PL, 5% EA"</strong>:</p>
            <ul>
                <li>70% فيسكوز (ناعم وانسدال جميل)</li>
                <li>25% بوليستر (متانة ومقاومة تجعّد)</li>
                <li>5% ليكرا (مرونة)</li>
            </ul>
            <div class="callout">
                💡 الأقمشة المختلطة عادة تجمع مزايا كل ليف — ناعم + متين + مرن.
            </div>
        </div>
    </div>
</div>
