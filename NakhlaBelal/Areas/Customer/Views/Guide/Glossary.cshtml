@{ ViewBag.Title = "قاموس مصطلحات الأقمشة"; }
<partial name="_InfoPageStyles" />

<div class="info-page" dir="rtl">
    <div class="info-hero">
        <span class="icon-big">📖</span>
        <h1>قاموس مصطلحات الأقمشة</h1>
        <p>دليلك الشامل لفهم مصطلحات عالم النسيج</p>
    </div>

    <div class="info-container">
        <div class="info-card">
            <h2><i class="ri-book-line"></i> المصطلحات الشائعة</h2>
            <div class="term-grid">
                <div class="term-item"><strong>الوزن (GSM)</strong><span>جرامات لكل متر مربع — كلما زاد الرقم زادت سماكة القماش.</span></div>
                <div class="term-item"><strong>عرض القماش (Width)</strong><span>عرض اللفة، غالباً 140 أو 150 أو 280 سم.</span></div>
                <div class="term-item"><strong>الخامة الطبيعية</strong><span>ألياف من الطبيعة كالقطن، الحرير، الصوف، الكتان.</span></div>
                <div class="term-item"><strong>الخامة الصناعية</strong><span>ألياف من البترول كالبوليستر والنايلون.</span></div>
                <div class="term-item"><strong>الانسدال (Drape)</strong><span>طريقة سقوط القماش على الجسم — ناعم، متوسط، ثقيل.</span></div>
                <div class="term-item"><strong>الشفافية</strong><span>درجة نفاذ الضوء عبر القماش.</span></div>
                <div class="term-item"><strong>الرجعة (Stretch)</strong><span>قابلية القماش للتمدد، يُقاس بنسبة مئوية.</span></div>
                <div class="term-item"><strong>الكثافة (Thread Count)</strong><span>عدد الخيوط في البوصة المربعة — مؤشر للجودة.</span></div>
                <div class="term-item"><strong>الكراش (Crease)</strong><span>ميل القماش للتجعّد.</span></div>
                <div class="term-item"><strong>الخط المتعرّج (Herringbone)</strong><span>نسيج على شكل هيكل سمكة.</span></div>
                <div class="term-item"><strong>الساتان</strong><span>نسيج لامع ناعم، الجهة الخارجية أكثر لمعاناً.</span></div>
                <div class="term-item"><strong>البرتقالي (Twill)</strong><span>نسيج بخطوط مائلة متميّزة، قوي ومتين.</span></div>
            </div>
        </div>

        <div class="info-card">
            <h2><i class="ri-color-filter-line"></i> مصطلحات الألوان والطباعة</h2>
            <div class="term-grid">
                <div class="term-item"><strong>الصباغة الثابتة</strong><span>ألوان لا تبهت بالغسيل المتكرر.</span></div>
                <div class="term-item"><strong>Ombré</strong><span>تدرّج لوني من فاتح لغامق أو العكس.</span></div>
                <div class="term-item"><strong>Jacquard</strong><span>نقش مُنسّج في القماش (مش مطبوع عليه).</span></div>
                <div class="term-item"><strong>Prints</strong><span>طباعة على سطح القماش بألوان متعددة.</span></div>
            </div>
        </div>
    </div>
</div>
