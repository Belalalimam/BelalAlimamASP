@model NakhlaBelal.ViewModels.CheckoutVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer

<div class="container py-5">
    <h2 class="text-center mb-5">@SharedLocalizer["Checkout"]</h2>
    <form asp-action="ProcessOrder" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" name="CartData.Total" value="@Model.CartData.Total.ToString("0.00")" />
        <input type="hidden" name="CartData.Subtotal" value="@Model.CartData.Subtotal.ToString("0.00")" />
        <input type="hidden" name="CartData.Tax" value="@Model.CartData.Tax.ToString("0.00")" />
        <input type="hidden" name="CartData.Shipping" value="@Model.CartData.Shipping.ToString("0.00")" />
        <input type="hidden" name="CartData.Discount" value="@Model.CartData.Discount.ToString("0.00")" />
    
        @* أضف هذه الحقول للتأكد من اكتمال الـ ModelState *@
        <input type="hidden" asp-for="ShippingEmail" />
        <input type="hidden" asp-for="ShippingCountry" />

        @* لاحظ هنا سنرسل البيانات لـ Pay *@
        <div class="row">
            <div class="col-md-7">
                <div class="card p-4 shadow-sm TableContainerCheck">
                    <h4>@SharedLocalizer["Billing Details"]</h4>
                    <hr />
                    <div class="row">
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingFirstName">@SharedLocalizer["First Name"] *</label>
                            <input asp-for="ShippingFirstName" class="form-control" />
                            <span asp-validation-for="ShippingFirstName" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingLastName">@SharedLocalizer["Last Name"] *</label>
                            <input asp-for="ShippingLastName" class="form-control" />
                            <span asp-validation-for="ShippingLastName" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingAddress">@SharedLocalizer["Street Address"] *</label>
                            <input asp-for="ShippingAddress" class="form-control" />
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingCity">@SharedLocalizer["Town / City"] *</label>
                            <input asp-for="ShippingCity" class="form-control" />
                            <span asp-validation-for="ShippingCity" class="text-danger"></span>
                        </div>

                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingZipCode">@SharedLocalizer["Postcode / ZIP"] *</label>
                            <input asp-for="ShippingZipCode" class="form-control" />
                            <span asp-validation-for="ShippingZipCode" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingPhone">@SharedLocalizer["Phone"] *</label>
                            <input asp-for="ShippingPhone" class="form-control" />
                            <span asp-validation-for="ShippingPhone" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-6 mb-3">
                            <label asp-for="ShippingEmail">@SharedLocalizer["Email"] *</label>
                            <input asp-for="ShippingEmail" class="form-control" />
                            <span asp-validation-for="ShippingEmail" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card p-4 shadow-sm TableContainerCheck">
                    <h4>@SharedLocalizer["Your Order"]</h4>
                    <table class="table mt-3">
                        <thead>
                            <tr>
                                <th class="TableContainerCheck">@SharedLocalizer["Product"]</th>
                                <th class="text-end TableContainerCheck">@SharedLocalizer["Subtotal"]</th>
                            </tr>
                        </thead>
                        <tbody class="">
                            @if (Model.CartData != null && Model.CartData.CartItems.Any())
                            {
                                @foreach (var item in Model.CartData.CartItems)
                                {
                                    <tr class="">
                                        <td class="TableContainerCheck">@item.Product.Name × @item.Count</td>
                                        <td class="text-end TableContainerCheck">€ @((item.Product.Price * item.Count).ToString("N2"))</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="2">@SharedLocalizer["Your cart is empty"]</td></tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr class="">
                                <td class="TableContainerCheck">@SharedLocalizer["Subtotal"]</td>
                                <td class="text-end TableContainerCheck">€ @Model.CartData.Subtotal.ToString("N2")</td>
                            </tr>
                        </tr>
                        @if (Model.CartData.Discount > 0)
                        {
                            <tr class="text-danger ">
                                <td class="TableContainerCheck">Discount (@Model.CartData.PromotionCode)</td>
                                <td class="text-end TableContainerCheck">- € @Model.CartData.Discount.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.CartData.Tax > 0)
                        {
                            <tr>
                                <td class="TableContainerCheck">@SharedLocalizer["VAT"] (19%)</td>
                                <td class="text-end TableContainerCheck">€ @Model.CartData.Tax.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <tr>
                                <td class="TableContainerCheck">@SharedLocalizer["Shipping"]</td>
                                <td class="text-end TableContainerCheck">€ @Model.CartData.Shipping.ToString("N2")</td>
                            </tr>
                            <tr class="text-primary h5 ">
                                <td class="TableContainerCheck">@SharedLocalizer["Total"]</td>
                                <td class="text-end TableContainerCheck">€ @Model.CartData.Total.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="mt-4">
                        <button type="submit" class="checkout-btn">@SharedLocalizer["Place Order"]</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>