@model NakhlaBelal.ViewModels.CartVM
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = "Shopping Cart";
}
@* ── Egypt: Step Progress Bar ── *@
<div class="eg-cart-steps">
    <div class="eg-step active">
        <div class="eg-step-num"><i class="ri-shopping-cart-2-line"></i></div>
        <span>@SharedLocalizer["Cart"]</span>
    </div>
    <div class="eg-step-connector"></div>
    <div class="eg-step">
        <div class="eg-step-num"><i class="ri-secure-payment-line"></i></div>
        <span>@SharedLocalizer["Checkout"]</span>
    </div>
    <div class="eg-step-connector"></div>
    <div class="eg-step">
        <div class="eg-step-num"><i class="ri-checkbox-circle-line"></i></div>
        <span>@SharedLocalizer["Confirmation"]</span>
    </div>
</div>

<style>
.eg-cart-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 24px 16px 0;
    max-width: 420px;
    margin: 0 auto;
}
.eg-step {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    flex-shrink: 0;
}
.eg-step-num {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 2px solid #ddd;
    background: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: #bbb;
    transition: all .3s;
}
.eg-step span {
    font-size: 11px; font-weight: 700;
    color: #bbb; font-family: 'Cairo', sans-serif;
    letter-spacing: .5px;
}
.eg-step.active .eg-step-num {
    background: #003B6F; border-color: #003B6F; color: #fff;
    box-shadow: 0 4px 14px rgba(0,59,111,.3);
}
.eg-step.active span { color: #003B6F; }
.eg-step.done .eg-step-num  { background: #2a7d4f; border-color: #2a7d4f; color: #fff; }
.eg-step.done span { color: #2a7d4f; }
.eg-step-connector {
    flex: 1;
    height: 2px;
    background: #ddd;
    margin-bottom: 22px;
    min-width: 40px;
    max-width: 80px;
}
</style>

<div class="cart-page ">

    <div class="container-cart ">
        <div class="basket-section">
            <h1>@SharedLocalizer["Basket"]</h1>

            @if (!Model.CartItems.Any())
            {
                <div class="empty-cart">
                    <h3>@SharedLocalizer["Your cart is empty"]</h3>
                    <p>@SharedLocalizer["Add some products to your cart to see them here!"]</p>
                    <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="continue-shopping-btn">
                        @SharedLocalizer["Continue Shopping"]
                    </a>
                </div>
            }
            else
            {
                <div class="cart-table">
                    <div class="cart-header">
                        <div class="header-product">@SharedLocalizer["Product"]</div>
                        <div class="header-price">@SharedLocalizer["Price"]</div>
                        <div class="header-quantity">@SharedLocalizer["Quantity"]</div>
                        <div class="header-subtotal">@SharedLocalizer["Subtotal"]</div>
                        <div class="header-remove"></div>
                    </div>

                    @foreach (var item in Model.CartItems)
                    {
                        var itemSubtotal = item.Price * item.Count;

                        <div class="cart-item" id="cart-item-@item.ProductId">
                            <div class="product-info1">
                                <img src="~/images/@item.Product.MainImage" alt="@item.Product.Name" class="product-image1">
                                <div class="product-details1">
                                    <a href="@Url.Action("Details", "Home", new { id = item.ProductId, area = "Customer" })"
                                       class="product-name1">@item.Product.Name</a>
                                    @if (!string.IsNullOrEmpty(item.Product.SKU))
                                    {
                                        <div class="product-sku1">SKU: @item.Product.SKU</div>
                                    }
                                </div>
                            </div>

                            <div class="price-col">
                                <div class="price-amount">€ @item.Price.ToString("N2")</div>
                                @if (item.Price < item.Product.Price)
                                {
                                    <div class="original-price">€ @item.Product.Price.ToString("N2")</div>
                                }
                            </div>

                                

                            <div class="quantity-col">
                                <div class="quantity-control">
                                    <a class="qty-btn" asp-action="DecrementProduct" asp-route-productId="@item.ProductId">-</a>

                                    <form method="post" asp-action="UpdateQuantity" class="quantity-form">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="number" name="quantity" value="@item.Count"
                                               min="1" max="@(item.Product.ManageStock? item.Product.StockQuantity : 999)"
                                               class="qty-input"
                                               onchange="this.form.submit()"
                                               title="@(item.Product.ManageStock ? $"Max available: {item.Product.StockQuantity}" : "")" />
                                    </form>

                                    <a class="qty-btn" asp-action="IncrementProduct" asp-route-productId="@item.ProductId">+</a>
                                </div>
                            </div>

                            <div class="subtotal-col">
                                <div class="item-subtotal">€ @itemSubtotal.ToString("N2")</div>
                            </div>

                            <div class="remove-col">
                                <a class="remove-btn" asp-action="DeleteProduct" asp-route-productId="@item.ProductId"
                                   onclick="return confirm('@SharedLocalizer["Are you sure you want to remove this item from your cart?"]')">
                                    ×
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="cart-actions">
                        <div class="coupon-section">
                            @if (!string.IsNullOrEmpty(Model.PromotionCode))
                            {
                                <div class="applied-promotion">
                                    <span>@SharedLocalizer["Applied Promotion"]: <strong>@Model.PromotionName (@Model.PromotionCode)</strong></span>
                                    @* التصحيح هنا: جعلنا الپارامتر removePromo ليطابق الكنترولر *@
                                    <a href="@Url.Action("Index", "Cart", new { removePromo = true })" class="remove-promo">@SharedLocalizer["Remove"]</a>
                                </div>
                            }
                            else
                            {
                                <form asp-action="Index" asp-controller="Cart" method="get" class="coupon-form">
                                    <input type="text" name="code" class="coupon-input" placeholder="@SharedLocalizer["Enter coupon code"]">
                                    <button type="submit" class="apply-btn">@SharedLocalizer["Apply Coupon"]</button>
                                </form>
                            }
                        </div>

                    <a asp-action="ClearCart" class="clear-cart-btn"
                       onclick="return confirm('@SharedLocalizer["Are you sure you want to clear your entire cart?"]')">
                        @SharedLocalizer["Clear Cart"]
                    </a>
                </div>

                @if (Model.SuggestedProducts.Any())
                {
                    <div class="recommendations">
                        <h2>@SharedLocalizer["You may also be interested in..."]</h2>


                        <swiper-container class="mySwiper" pagination="true" pagination-clickable="true" space-between="30" slides-per-view="3">




                            @* <div class="product-grid"> *@
                                @foreach (var product in Model.SuggestedProducts.Take(10))
                                {
                                    <swiper-slide class="">
                                        <a href="@Url.Action("Details", "Home", new { id = product.Id, area = "Customer" })" class="col mb-5 ">
                                            <div class="product-card m-1">
                                                <img src="~/images/@product.MainImage" alt="@product.Name" />

                                                <div class="product-info">
                                                    <h3>@product.Name</h3>

                                                    @{
                                                        var cartSuggUnit = UnitHelper.GetShortLabel(product.UnitPrice);
                                                    }
                                                    <div class="rowProduct split bottom px-3">
                                                        <span class="price">€ @product.Price / @cartSuggUnit</span>
                                                        <span class="stock">@product.StockQuantity @cartSuggUnit</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </swiper-slide>
                                }
                            @* </div> *@
                        </swiper-container>

                    </div>
                }
            }
        </div>

        @if (Model.CartItems.Any())
        {
            <div class="totals-section">
                <h2>@SharedLocalizer["Basket Totals"]</h2>

                <div class="total-row subtotal">
                        <span>@SharedLocalizer["Subtotal"]</span>
                    <span>€ @Model.FormattedSubtotal</span>
                </div>
                @if (Model.Discount > 0)
                {
                    <div class="total-row discount">
                        <span>@SharedLocalizer["DISCOUNT"]</span>
                        @* فورمات العملة مباشرة لضمان الظهور *@
                            <span>-€ @Model.FormattedDiscount</span>
                    </div>
                }
                    @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                    {
                        <div class="shipping-info">
                            <div class="shipping-label">
                                @SharedLocalizer["SHIPPING"]
                                <span class="shipping-price">€ @Model.Shipping</span>
                            </div>
                            <div class="shipping-address">
                                @* عرض العنوان الحقيقي القادم من قاعدة البيانات *@
                                @SharedLocalizer["Shipping to"] <strong>@Model.ShippingAddress</strong>
                                <br>
                                <a href="@Url.Action("index", "Profile", new { area = "Identity" })" class="change-address">@SharedLocalizer["Change address"]</a>
                            </div>
                            <div class="shipping-methods">
                                <div class="shipping-method">
                                    <input type="radio" id="standard" name="shipping" class="inputCheck" value="5.99" @(Model.Shipping == 12.99m ? "" : "checked")>
                                    <label for="standard">@SharedLocalizer["Standard Shipping"]: € 5.99</label>
                                </div>
                                <div class="shipping-method">
                                    <input type="radio" id="express" name="shipping" class="inputCheck" value="12.99" @(Model.Shipping == 12.99m ? "checked" : "")>
                                    <label for="express">@SharedLocalizer["Express Shipping"]: € 12.99</label>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="DetailsContainer">
                            
                        </div>
                    }



                <div class="total-row">
                    <span>@SharedLocalizer["CUSTOMS DUTIES AND TAXES"]</span>
                    <span>€ @Model.FormattedTax</span>
                </div>

                <div class="total-row final">
                    <span>@SharedLocalizer["TOTAL"]</span>
                    <div class="total-amount">
                        <div class="final-total">€ @Model.FormattedTotal</div>
                        <div class="usd-estimate">about US $@((Model.Total * 1.08m).ToString("N2"))</div>
                    </div>
                </div>

                <div class="checkout-actions">
                        <a href="@Url.Action("Index", "Checkout", new { area = "Customer" })" class="checkout-btn">
                        @SharedLocalizer["PROCEED TO CHECKOUT"]
                    </a>

                    <div class="alternative-payments">
                        <p>@SharedLocalizer["Or checkout with:"]</p>
                        <button type="button" class="paypal-btn" onclick="processPayPal()">PayPal</button>
                    </div>
                </div>

                <div class="paypal-info">
                    @SharedLocalizer["Pay in 3 installments of 19.94€ without interest with PayPal."]<br>
                    @SharedLocalizer["APR 0%"]. <a href="#" style="color: #e91e63;">@SharedLocalizer["Learn more"]</a>
                </div>

                <div class="continue-shopping">
                    @SharedLocalizer["OR"]<br><br>
                        <a href="@Url.Action("Index", "Home", new { area = "" })">@SharedLocalizer["Continue Shopping"]</a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Cart totals (rendered with InvariantCulture so JS parseFloat is safe)
    const CART_SUBTOTAL = @Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const CART_DISCOUNT = @Model.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const CART_TAX      = @Model.Tax.ToString(System.Globalization.CultureInfo.InvariantCulture);

    function recomputeCartTotal(shippingCost){
        // refresh the shipping line
        const shippingPrice = document.querySelector('.shipping-price');
        if (shippingPrice) shippingPrice.textContent = '€ ' + shippingCost.toFixed(2);

        // refresh grand total + USD estimate
        const newTotal = (CART_SUBTOTAL - CART_DISCOUNT) + CART_TAX + shippingCost;
        const totalEl = document.querySelector('.final-total');
        if (totalEl) totalEl.textContent = '€ ' + newTotal.toFixed(2);
        const usdEl = document.querySelector('.usd-estimate');
        if (usdEl) usdEl.textContent = 'about US $' + (newTotal * 1.08).toFixed(2);
    }

    function persistShipping(amount, opts){
        const fd = new FormData();
        fd.append('amount', amount.toFixed(2));
        // keepalive:true → the request survives page navigation (clicking "Checkout")
        return fetch('/Customer/Cart/SetShipping', Object.assign({
            method: 'POST',
            body: fd,
            keepalive: true
        }, opts || {})).catch(err => console.warn('SetShipping failed', err));
    }

    // Update shipping when method changes — recompute total + persist choice to server session
    document.querySelectorAll('input[name="shipping"]').forEach(radio => {
        radio.addEventListener('change', function () {
            if (!this.checked) return;
            const shippingCost = parseFloat(this.value);
            if (isNaN(shippingCost)) return;
            recomputeCartTotal(shippingCost);
            persistShipping(shippingCost);
        });
    });

    // Ensure the displayed total matches the currently-checked radio on load
    (function syncInitialShipping(){
        const checked = document.querySelector('input[name="shipping"]:checked');
        if (checked) recomputeCartTotal(parseFloat(checked.value));
    })();

    // Intercept "Proceed to Checkout" — wait for shipping to be saved before navigating
    document.querySelectorAll('a.checkout-btn').forEach(link => {
        link.addEventListener('click', function(e){
            const checked = document.querySelector('input[name="shipping"]:checked');
            if (!checked) return;
            const amount = parseFloat(checked.value);
            if (isNaN(amount)) return;
            e.preventDefault();
            const href = this.getAttribute('href');
            persistShipping(amount).finally(() => { window.location.href = href; });
        });
    });

    // Validate quantity input
    document.querySelectorAll('.qty-input').forEach(input => {
        input.addEventListener('change', function() {
            let value = parseInt(this.value);
            const min = parseInt(this.getAttribute('min')) || 1;
            const max = parseInt(this.getAttribute('max')) || 999;

            if (isNaN(value) || value < min) {
                value = min;
                this.value = min;
            } else if (value > max) {
                value = max;
                this.value = max;
                alert('Cannot add more than available stock: ' + max);
            }
        });
    });

    // Smooth item removal
    document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            if (!confirm('Are you sure you want to remove this item from your cart?')) {
                e.preventDefault();
            }
        });
    });

    // Calculate USD conversion
    function updateUSDConversion() {
        const total = @Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const usdRate = 1.08; // Example conversion rate
        const usdTotal = (total * usdRate).toFixed(2);

        const usdElement = document.querySelector('.usd-estimate');
        if (usdElement) {
            usdElement.textContent = 'about US $' + usdTotal;
        }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        updateUSDConversion();

        // Add fade-in animation for cart items
        const cartItems = document.querySelectorAll('.cart-item');
        cartItems.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(10px)';

            setTimeout(() => {
                item.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });

    // Payment methods
    function processPayPal() {
        alert('PayPal checkout would be initiated here');
        // Implement PayPal integration
    }

    function processApplePay() {
        alert('Apple Pay checkout would be initiated here');
        // Implement Apple Pay integration
    }
</script>