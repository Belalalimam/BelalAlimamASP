@model List<NakhlaBelal.Models.Product>
@using NakhlaBelal.Utitlies

@if (Model != null && Model.Any())
{
    <div class="mps-strip">
        @foreach (var p in Model)
        {
            <a class="mps-card" href="@Url.Action("Details","Home", new { id = p.Id, area="Customer" })">
                <img src="~/images/@p.MainImage" alt="@p.Name" />
                <div class="mps-info">
                    <div class="mps-name">@p.Name</div>
                    <div class="mps-price">€ @p.Price.ToString("N2") / @UnitHelper.GetEnglishShort(p.UnitPrice)</div>
                </div>
            </a>
        }
    </div>
    <style>
        .mps-strip{display:flex;gap:12px;overflow-x:auto;padding:6px 2px 14px;scroll-snap-type:x mandatory}
        .mps-card{flex:0 0 170px;scroll-snap-align:start;text-decoration:none;color:#013220;background:#fff;border:1px solid #eee;border-radius:12px;overflow:hidden;transition:.2s}
        .mps-card:hover{transform:translateY(-3px);box-shadow:0 6px 16px rgba(0,0,0,.08)}
        .mps-card img{width:100%;height:130px;object-fit:cover;display:block}
        .mps-info{padding:8px 10px}
        .mps-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .mps-price{font-size:12px;color:#555;margin-top:2px}
    </style>
}
