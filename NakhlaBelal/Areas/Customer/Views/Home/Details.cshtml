@model ProductWithRelatedVM

@{
    var discounted = Model.Product.Price - Model.Product.Price * (Model.Product.Discount / 100);
    var priceStr = @SharedLocalizer["£"] + discounted.ToString("N2").Replace(".", ",");
    var bulkStr = @SharedLocalizer["£"] + (discounted * 0.92m).ToString("N2").Replace(".", ",");

    // وحدة البيع + الكمية الأدنى + خطوة الإضافة
    var unitLabel = Model.Product.Unit.ShortLabel();
    var minQty    = Model.Product.MinimumQuantity > 0 ? Model.Product.MinimumQuantity : 1;
    var step      = Model.Product.QuantityStep    > 0 ? Model.Product.QuantityStep    : 1;
}
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer


<div class="pd-root" data-track-product-id="@Model.Product.Id">

    <!-- Breadcrumb -->
    <nav class="pd-breadcrumb">
        <a href="/">Home</a>
        <span class="pd-bc-sep">›</span>
        <a href="/Customer/Home/Product">Shop</a>
        <span class="pd-bc-sep">›</span>
        <span>@Model.Product.Name</span>
    </nav>

    <!-- MAIN 2-col -->
    <div class="pd-top">

        <!-- GALLERY -->
        <div class="pd-gallery">
            @{
                var imgs = Model.ProductImages?.OrderBy(i => i.DisplayOrder).ToList();
                var first = imgs?.FirstOrDefault();
            }

            <img id="mainImg"
                 src="~/images/@(first?.ImageUrl ?? Model.Product.MainImage ?? "products/default.jpg")"
                 alt="@Model.Product.Name"
                 class="pd-main-img pd-zoomable"
                 onclick="openLightbox(this.src)"
                 title="@SharedLocalizer["Click to zoom"]" />

            <div class="pd-thumbs">
                @if (imgs != null && imgs.Any())
                {
                    foreach (var img in imgs)
                    {
                        <img src="~/images/product_images/@img.ImageUrl"
                             alt="@img.AltText"
                             class="pd-thumb @(img == first ? "active" : "")"
                             onclick="switchImg(this)" />
                    }
                }
                else if (!string.IsNullOrEmpty(Model.Product.MainImage))
                {
                    <img src="~/images/@Model.Product.MainImage"
                         alt="@Model.Product.Name"
                         class="pd-thumb active"
                         onclick="switchImg(this)" />
                }
            </div>

           
        </div>

        <!-- INFO -->
        <div class="pd-info">

            <h1 class="pd-title">@SharedLocalizer[@Model.Product.Name]</h1>
            <div class="pd-sku-row">
                <span class="pd-sku">@SharedLocalizer[@Model.Product.SKU]</span>
                @if (Model.Product.Brand != null)
                {
                    <span class="pd-brand">@Model.Product.Brand.Name.ToUpper()</span>
                }
            </div>

            

            <!-- Price -->
            <div class="pd-price-block">
                <span class="pd-price">@SharedLocalizer[@priceStr] / @SharedLocalizer[@unitLabel]</span>
                <span class="pd-price-note"> + @SharedLocalizer["VAT if applicable"]</span>
            </div>
            @if (Model.Product.Discount > 0)
            {
                <div class="pd-price-discount">
                    @SharedLocalizer["Save"] @Model.Product.Discount% — @SharedLocalizer["buy 8 m or more at"] @bulkStr / @SharedLocalizer["m"]!
                </div>
            }
            <!-- Stock -->
            @if (Model.Product.StockQuantity != null)
            {
                <div class="pd-stock">✓ @Model.Product.StockQuantity @SharedLocalizer["m in stock"]</div>
            }
            <p class="pd-shipping">@SharedLocalizer["Shipping in"]  <strong>@SharedLocalizer["2 business days"]</strong>.</p>

            <!-- Add to Cart -->
            <form method="post"
                  asp-area="Customer" asp-controller="Cart" asp-action="AddToCart"
                  class="pd-order-row">
                <input type="hidden" name="ProductId" value="@Model.Product.Id" />
                <div class="pd-qty">
                    <button type="button" class="pd-qty-btn" onclick="decQty()">−</button>
                    <input type="number" name="count" id="qtyInput"
                           value="@minQty" min="@minQty" step="@step" max="@Model.Product.StockQuantity"
                           class="pd-qty-val" />
                    <button type="button" class="pd-qty-btn" onclick="incQty()">+</button>
                    @* <span class="pd-qty-unit">@unitLabel</span> *@
                </div>
                <button type="submit" class="pd-add-btn">@SharedLocalizer["ADD TO BASKET"]</button>
            </form>

            <!-- Secondary actions: Wishlist / Compare / Sample -->
            <div class="pd-secondary-actions">
                <button type="button" class="pd-sec-btn wishlist-btn" data-pid="@Model.Product.Id" onclick="toggleWishlist(@Model.Product.Id, this)">
                    <i class="ri-heart-line"></i>
                    <span>@SharedLocalizer["Wishlist"]</span>
                </button>
                <button type="button" class="pd-sec-btn compare-btn" data-pid="@Model.Product.Id" onclick="toggleCompare(@Model.Product.Id, this)">
                    <i class="ri-arrow-left-right-line"></i>
                    <span>@SharedLocalizer["Compare"]</span>
                </button>
                <button type="button" class="pd-sec-btn" onclick="requestSampleQuick(@Model.Product.Id)">
                    <i class="ri-scissors-cut-line"></i>
                    <span>@SharedLocalizer["Request Sample"]</span>
                </button>
            </div>
            <style>
                .pd-secondary-actions{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0}
                .pd-sec-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border-radius:999px;border:1px solid #d9dcd6;background:#fff;color:#003B6F;font-weight:600;font-size:13.5px;cursor:pointer;transition:.15s}
                .pd-sec-btn:hover{background:#003B6F;color:#fff;border-color:#003B6F}
                .pd-sec-btn.wishlist-btn.active{background:#e91e63;color:#fff;border-color:#e91e63}
                .pd-sec-btn.compare-btn.active{background:#003B6F;color:#D4A017;border-color:#003B6F}
                .pd-sec-btn i{font-size:16px}
            </style>
            @if (minQty > 1 || step > 1)
            {
                <small class="pd-qty-hint">
                    @SharedLocalizer["Minimum"]: @minQty @unitLabel
                    @if (step > 1)
                    {
                        <text> · @SharedLocalizer["Step"]: @step @unitLabel</text>
                    }
                </small>
            }

            @{
                // Detect whether this product is a fabric (so we can hide fabric-only specs for
                // accessories like buttons / clips / hooks that don't have composition / weight / width).
                var hasComposition = Model.SelectedCompositions != null && Model.SelectedCompositions.Any();
                var hasWeight      = (Model.Product.Weight ?? 0) > 0;
                var hasHeight      = (Model.Product.Height ?? 0) > 0;
                var hasWidth       = (Model.Product.Width  ?? 0) > 0;
                var hasFabricType  = Model.Product.FabricTypeId.HasValue;
                var hasProjects    = Model.Product.ProjectCategories != null && Model.Product.ProjectCategories.Any();
                var isFabric       = hasComposition || hasWeight || hasHeight || hasWidth || hasFabricType;
            }

            <!-- Specs (only render sections that have data) -->
            @if (isFabric || hasProjects)
            {
                <div class="pd-specs">
                    @if (hasComposition)
                    {
                        <div class="pd-spec-row full">
                            <div class="pd-spec-cell">
                                <span class="pd-spec-label">@SharedLocalizer["COMPOSITION"]</span>
                                <div class="pd-spec-comp">
                                    @foreach (var c in Model.SelectedCompositions)
                                    {
                                        <span>@c.Percentage% @SharedLocalizer[@c.CompositionName]</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (hasHeight || hasWeight)
                    {
                        <div class="pd-spec-row halves">
                            @if (hasHeight)
                            {
                                <div class="pd-spec-cell">
                                    <span class="pd-spec-label">@SharedLocalizer["HEIGHT"]</span>
                                    <span class="pd-spec-val">@Model.Product.Height cm</span>
                                </div>
                            }
                            @if (hasWeight)
                            {
                                <div class="pd-spec-cell">
                                    <span class="pd-spec-label">@SharedLocalizer["WEIGHT"]</span>
                                    <span class="pd-spec-val">@Model.Product.Weight g / m</span>
                                </div>
                            }
                        </div>
                    }

                    @if (hasProjects)
                    {
                        <div class="pd-spec-row full">
                            <div class="pd-spec-cell">
                                <span class="pd-spec-label">@SharedLocalizer["PROJECT"]</span>
                                <div class="pd-spec-icons">
                                    @foreach (var cat in Model.Product.ProjectCategories)
                                    {
                                        <i class="@cat.Icon" title="@cat.Name" style="font-size:22px"></i>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* Care instructions are meaningful only for fabrics *@
                    @if (isFabric)
                    {
                        <div class="pd-spec-row full last">
                            <div class="pd-spec-cell">
                                <span class="pd-spec-label">@SharedLocalizer["CARE INSTRUCTIONS"]</span>
                                <div class="pd-spec-icons">
                                    <i class="ri-t-shirt-line"></i>
                                    <i class="ri-scissors-line"></i>
                                    <i class="ri-temp-cold-line"></i>
                                    <i class="ri-drop-line"></i>
                                    <i class="ri-sun-line"></i>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }


            <div class="pd-desc">
                @if (!string.IsNullOrEmpty(Model.Product.Description))
                {
                    foreach (var p in Model.Product.Description.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p style="margin-bottom:8px">@SharedLocalizer[@p]</p>
                    }
                }
                else
                {
                    <p>@SharedLocalizer["An elegant fabric, perfect for both classic and modern garments."]</p>
                }
            </div>





            <!-- Available Colors -->
            @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
            {
                <div class="pd-colors-section">
                    <h3 class="pd-section-mini-title"> @SharedLocalizer["AVAILABLE COLORS"]</h3>
                    <div class="pd-color-list">
                        @foreach (var item in Model.RelatedProducts)
                        {
                            <a href="@Url.Action("Details", "Home", new { id = item.Id, area = "Customer" })"
                                   class="pd-color-item">
                                <img src="~/images/@item.MainImage"
                                     class="pd-color-swatch"
                                     alt="@item.SKU" />
                                <span class="pd-color-code">@item.SKU</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @{
                var showFabricAccordion = isFabric && (Model.Product.Color != null || hasWidth);
            }
            @if (showFabricAccordion)
            {
                <!-- Accordion -->
                <div class="pd-acc-item">
                    <button class="pd-acc-btn" type="button" onclick="toggleAcc('accDetails',this)">
                        @SharedLocalizer["Fabric Details"]<span>&#8964;</span>
                    </button>
                    <div id="accDetails" class="pd-acc-body">
                        @if (Model.Product.Color != null)
                        {
                            <p><strong>@SharedLocalizer["Color:"]</strong> @SharedLocalizer[@Model.Product.Color.Name] — @Model.Product.Color.HexCode</p>
                        }
                        @if (hasWidth)
                        {
                            <p><strong>@SharedLocalizer["Width:"]</strong> @Model.Product.Width cm</p>
                        }
                    </div>
                </div>
            }
            else if (Model.Product.Color != null)
            {
                <!-- Accordion (non-fabric item with just a color) -->
                <div class="pd-acc-item">
                    <button class="pd-acc-btn" type="button" onclick="toggleAcc('accDetails',this)">
                        @SharedLocalizer["Product Details"]<span>&#8964;</span>
                    </button>
                    <div id="accDetails" class="pd-acc-body">
                        <p><strong>@SharedLocalizer["Color:"]</strong> @SharedLocalizer[@Model.Product.Color.Name] — @Model.Product.Color.HexCode</p>
                    </div>
                </div>
            }

            <div class="pd-acc-item">
                <button class="pd-acc-btn" type="button" onclick="toggleAcc('accReviews',this)">
                    @SharedLocalizer["Reviews"] <span>&#8964;</span>
                </button>
                <div id="accReviews" class="pd-acc-body">
                    <p>@SharedLocalizer["No reviews yet. Be the first to review this product."]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- MATCHING PRODUCTS -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="pd-section">
            <div class="pd-section-head">
                <h2>@SharedLocalizer["Matching products"]</h2>
                <a href="@Url.Action("CategroySearch", "Home", new { categoryId = Model.Product.CategoryId })"
                   class="pd-view-all">@SharedLocalizer["View all"]</a>
            </div>
            <div class="pd-related-scroll">
                @foreach (var item in Model.RelatedProducts.Take(8))
                {
                    <a href="@Url.Action("Details", "Home", new { id = item.Id, area = "Customer" })"
                           class="pd-related-card">
                        <img src="~/images/@item.MainImage" alt="@item.Name" class="pd-related-img" />
                        <h4 class="pd-related-name">@item.Name</h4>
                        <span class="pd-related-badge">Premium</span>
                        <div class="pd-related-prices">
                            <span>€ @item.Price.ToString("N2").Replace(".", ",")</span>
                            <span class="pd-related-stock">@item.StockQuantity m</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

    <!-- YOU MAY ALSO BE INTERESTED IN -->
    <div class="pd-section">
        <h2 class="pd-section-title">@SharedLocalizer["You may also be interested in..."]</h2>
        <div class="pd-cat-grid-3">
            <a href="#" class="pd-cat-card" style="background:#2c3e28"><span>@SharedLocalizer["Fine Suit Fabrics"]</span></a>
            <a href="#" class="pd-cat-card" style="background:#1a2c4a"><span>@SharedLocalizer["Cashmere Fabrics"]</span></a>
            <a href="#" class="pd-cat-card" style="background:#4a3a28"><span>@SharedLocalizer["Cotton Fabrics"]</span></a>
        </div>
        <div class="pd-cat-grid-2">
            <a href="#" class="pd-cat-card" style="background:#3a3a3a"><span>@SharedLocalizer["Wool Fabrics"]</span></a>
            <a href="#" class="pd-cat-card" style="background:#2e4a2e"><span>@SharedLocalizer["Green Fabrics"]</span></a>
        </div>
    </div>

    <!-- MORE INSPIRATIONS -->
    <div class="pd-section">
        <h2 class="pd-section-title">@SharedLocalizer["More inspirations"]</h2>
        <div class="pd-insp-row">
            <a href="#" class="pd-insp-card" style="background:linear-gradient(135deg,#ffd700,#ffed4e)">@SharedLocalizer["ON SALE FABRICS"]</a>
            <a href="#" class="pd-insp-card" style="background:linear-gradient(135deg,#89CFF0,#B2E5FF)">@SharedLocalizer["NEW ARRIVALS"]</a>
            <a href="#" class="pd-insp-card" style="background:linear-gradient(135deg,#90EE90,#C1FFC1)">@SharedLocalizer["ORGANIC FABRICS"]</a>
        </div>
    </div>

    <!-- NEWSLETTER -->
    <div class="pd-newsletter">
        <h3>@SharedLocalizer["Subscribe to our Newsletter and get a"] <strong>@SharedLocalizer["bonus"]</strong> @SharedLocalizer["for your next order"]</h3>
        <form class="pd-newsletter-form">
            <input type="email" placeholder="@SharedLocalizer["Your email address"]" required />
            <button type="submit">@SharedLocalizer["SUBSCRIBE"]</button>
        </form>
    </div>

@* ── Sticky Add-to-Cart Bar ── *@
<div class="pd-sticky-bar" id="pdStickyBar">
    <div class="pd-sticky-inner">
        <img src="~/images/@(Model.Product.MainImage ?? "products/default.jpg")"
             alt="@Model.Product.Name" class="pd-sticky-img" />
        <div class="pd-sticky-info">
            <span class="pd-sticky-name">@Model.Product.Name</span>
            <span class="pd-sticky-price">@priceStr / @unitLabel</span>
        </div>
        <button type="button" class="pd-sticky-btn" onclick="document.querySelector('.pd-order-row').requestSubmit()">
            <i class="ri-shopping-basket-line"></i>
            @SharedLocalizer["ADD TO BASKET"]
        </button>
    </div>
</div>

@* ── Image Lightbox ── *@
<div class="pd-lightbox" id="pdLightbox" onclick="closeLightbox()">
    <button class="pd-lb-close" onclick="closeLightbox()">&times;</button>
    <img id="pdLightboxImg" src="" alt="" onclick="event.stopPropagation()" />
</div>

</div>

@section Scripts {
    <script>
        function switchImg(thumb) {
            document.getElementById('mainImg').src = thumb.src;
            document.querySelectorAll('.pd-thumb').forEach(t => t.classList.remove('active'));
            thumb.classList.add('active');
        }
        function incQty() {
            var el = document.getElementById('qtyInput');
            var step = parseInt(el.step) || 1;
            var max = parseInt(el.max);
            var next = parseInt(el.value) + step;
            if (!isNaN(max) && next > max) next = max;
            el.value = next;
        }
        function decQty() {
            var el = document.getElementById('qtyInput');
            var step = parseInt(el.step) || 1;
            var min = parseInt(el.min) || 1;
            var next = parseInt(el.value) - step;
            if (next < min) next = min;
            el.value = next;
        }
        function toggleAcc(id, btn) {
            var body = document.getElementById(id);
            body.classList.toggle('open');
            btn.querySelector('span').style.transform =
                body.classList.contains('open') ? 'rotate(180deg)' : '';
            btn.querySelector('span').style.transition = 'transform .2s';
            btn.querySelector('span').style.display = 'inline-block';
        }

        /* ── Sticky Add-to-Cart bar ── */
        (function() {
            var stickyBar = document.getElementById('pdStickyBar');
            var addBtn    = document.querySelector('.pd-order-row');
            if (!stickyBar || !addBtn) return;
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (!entry.isIntersecting) {
                        stickyBar.classList.add('visible');
                    } else {
                        stickyBar.classList.remove('visible');
                    }
                });
            }, { threshold: 0.1 });
            observer.observe(addBtn);
        })();

        /* ── Lightbox ── */
        function openLightbox(src) {
            var lb = document.getElementById('pdLightbox');
            var img = document.getElementById('pdLightboxImg');
            if (!lb || !img) return;
            img.src = src;
            lb.classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            var lb = document.getElementById('pdLightbox');
            if (lb) lb.classList.remove('open');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeLightbox();
        });
    </script>

    <style>
    /* ── Sticky cart bar ── */
    .pd-sticky-bar {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: #003B6F;
        color: #fff;
        z-index: 900;
        transform: translateY(100%);
        transition: transform .35s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 -4px 20px rgba(0,27,53,.25);
    }
    .pd-sticky-bar.visible { transform: translateY(0); }
    .pd-sticky-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 10px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .pd-sticky-img {
        width: 48px; height: 48px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
        border: 2px solid rgba(212,160,23,.4);
    }
    .pd-sticky-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }
    .pd-sticky-name {
        font-family: 'Cairo', sans-serif;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pd-sticky-price {
        font-size: 13px;
        color: #D4A017;
        font-family: 'Cairo', sans-serif;
        font-weight: 600;
    }
    .pd-sticky-btn {
        padding: 10px 22px;
        background: #D4A017;
        color: #1A2B3C;
        border: none;
        border-radius: 6px;
        font-family: 'Cairo', sans-serif;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        transition: background .2s;
    }
    .pd-sticky-btn:hover { background: #C49010; }
    .pd-sticky-btn i { font-size: 16px; }

    /* ── Lightbox ── */
    .pd-lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.88);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
    }
    .pd-lightbox.open { display: flex; }
    .pd-lightbox img {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 6px;
        box-shadow: 0 8px 48px rgba(0,0,0,.6);
        cursor: default;
    }
    .pd-lb-close {
        position: absolute;
        top: 18px; right: 22px;
        background: rgba(255,255,255,.12);
        border: none;
        color: #fff;
        font-size: 30px;
        line-height: 1;
        padding: 4px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: background .15s;
    }
    .pd-lb-close:hover { background: rgba(255,255,255,.22); }

    /* ── Zoomable cursor ── */
    .pd-zoomable { cursor: zoom-in; }
    </style>

<!-- Recently Viewed strip -->
<section class="container my-4" id="recentlyViewedWrap" style="display:none;">
    <h4 class="fw-bold mb-3"><i class="ri-history-line me-2"></i>@SharedLocalizer["Recently Viewed"]</h4>
    <div id="recentlyViewedStrip"></div>
</section>
}