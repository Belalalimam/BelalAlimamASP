@model List<Product>
@{
    var category = ViewBag.SelectedCategory as Category;
    var fabricType = ViewBag.SelectedFabricType as FabricType;
    var projectCategory = ViewBag.SelectedProject as ProjectCategory;
    var color = ViewBag.SelectedColor as Color;
    var composition = ViewBag.SelectedComposition as Composition;

    string? headerTitle = null;
    string? headerSub = null;
    string? headerImg = null;

    if (fabricType != null) { headerTitle = fabricType.Name; headerSub = fabricType.Description; headerImg = fabricType.ImageUrl; }
    else if (category != null) { headerTitle = category.Name; headerSub = category.Description; headerImg = category.ImageUrl; }
    else if (projectCategory != null) { headerTitle = projectCategory.Name; headerSub = projectCategory.Description; headerImg = projectCategory.ImageUrl; }
    else if (color != null) { headerTitle = color.Name; headerSub = color.Description; headerImg = color.ImageUrl; }
    else if (composition != null) { headerTitle = composition.Name; headerSub = composition.Description; headerImg = composition.ImageUrl; }
}
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer


@* ===== HERO — خارج pp-wrap ===== *@
@if (headerTitle != null)
{
    <div class="cs-hero">
        @if (!string.IsNullOrEmpty(headerImg))
        {
            <div class="cs-hero-img-wrap">
                <img src="~/images/@headerImg" alt="@headerTitle" class="cs-hero-img" />
            </div>
        }
        <div class="cs-hero-content">
            <h1 class="cs-hero-title">@SharedLocalizer[@headerTitle]</h1>
            @if (!string.IsNullOrEmpty(headerSub))
            {
                <p class="cs-hero-desc">@SharedLocalizer[@headerSub]</p>
            }
            <a href="#categoryDescription" class="cs-hero-readmore">@SharedLocalizer["Read more"]</a>
        </div>
    </div>
}

@* ===== SIDEBAR + MAIN LAYOUT ===== *@
<div class="pp-wrap">

    <aside class="pp-sidebar">
        <div class="pp-sidebar-inner">
            <h2 class="pp-sidebar-title">@SharedLocalizer["Filters"]</h2>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Search Products"]</span>
                    <button onclick="clearSearch()">@SharedLocalizer["Clear"]</button>
                </div>
                <div class="pp-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input id="searchInput" type="text" class="pp-input"
                           placeholder="Type & hit ENTER" oninput="applyFilters()" />
                </div>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Sortby"]</span>
                    <button onclick="resetSort()">@SharedLocalizer["Reset"]</button>
                </div>
                <select id="sortSelect" class="pp-select" onchange="applyFilters()">
                    <option value="new">New arrivals</option>
                    <option value="asc">Price: Low to High</option>
                    <option value="desc">Price: High to Low</option>
                    <option value="name">Name A–Z</option>
                </select>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Width(cm)"]</span>
                    <button onclick="resetRange('widthRange','200','widthVal','200 cm')">@SharedLocalizer["Reset"]</button>
                </div>
                <input type="range" id="widthRange" class="pp-range" min="100" max="200" value="200"
                       oninput="document.getElementById('widthVal').textContent=this.value+' cm'; applyFilters()" />
                <div class="pp-range-labels">
                    <span>100 cm</span><span id="widthVal">200 cm</span>
                </div>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Weight(g/m)"]</span>
                    <button onclick="resetRange('weightRange','700','weightVal','700 g')">@SharedLocalizer["Reset"]</button>
                </div>
                <input type="range" id="weightRange" class="pp-range" min="200" max="700" value="700"
                       oninput="document.getElementById('weightVal').textContent=this.value+' g'; applyFilters()" />
                <div class="pp-range-labels">
                    <span>200 g</span><span id="weightVal">700 g</span>
                </div>
            </div>

            <button class="pp-view-all" onclick="resetAll()">@SharedLocalizer["View All Products"]</button>
        </div>
    </aside>

    <main class="pp-main">

        <button class="pp-mobile-btn" onclick="toggleMobilePanel()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="8" y1="12" x2="20" y2="12" />
                <line x1="12" y1="18" x2="20" y2="18" />
            </svg>
            @SharedLocalizer["SHOW FILTERS"]
        </button>

        <div class="pp-mobile-panel" id="mobilePanel">
            <div class="pp-mobile-panel-head">
                <span>@SharedLocalizer["Filters"]</span>
                <button onclick="toggleMobilePanel()">×</button>
            </div>
            <div class="pp-filter-block">
                <div class="pp-filter-head"><span>@SharedLocalizer["Search"]</span></div>
                <input id="mSearchInput" type="text" class="pp-input"
                       placeholder="Type & hit ENTER"
                       oninput="document.getElementById('searchInput').value=this.value; applyFilters()" />
                <div class="cs-topfilters">
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label">@SharedLocalizer["Color"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                        </select>
                    </div>
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label"> @SharedLocalizer["Type"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                            <option>Tweed</option>
                            <option>Bouclé</option>
                            <option>Jacquard</option>
                            <option>Velvet</option>
                            <option>Crêpe</option>
                        </select>
                    </div>
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label">@SharedLocalizer["Quality"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                            <option>Premium</option>
                            <option>Standard</option>
                            <option>Economy</option>
                        </select>
                    </div>
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label"> @SharedLocalizer["COMPOSITION"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                        </select>
                    </div>
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label"> @SharedLocalizer["PROJECT"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                        </select>
                    </div>
                    <div class="cs-topfilter-item">
                        <span class="cs-topfilter-label"> @SharedLocalizer["Pattern"]</span>
                        <select class="cs-topfilter-select" onchange="applyFilters()">
                            <option value="">@SharedLocalizer["Any"]</option>
                            <option>Solid</option>
                            <option>Checkered</option>
                            <option>Striped</option>
                            <option>Floral</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @* 6-COLUMN FILTER BAR *@
        @if (headerTitle != null)
        {
            <div class="cs-topfilters">
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label">@SharedLocalizer["Color"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["Type"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                        <option>Tweed</option>
                        <option>Bouclé</option>
                        <option>Jacquard</option>
                        <option>Velvet</option>
                        <option>Crêpe</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label">@SharedLocalizer["Quality"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                        <option>Premium</option>
                        <option>Standard</option>
                        <option>Economy</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["COMPOSITION"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["PROJECT"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["Pattern"]</span>
                    <select class="cs-topfilter-select" onchange="applyFilters()">
                        <option value="">@SharedLocalizer["Any"]</option>
                        <option>Solid</option>
                        <option>Checkered</option>
                        <option>Striped</option>
                        <option>Floral</option>
                    </select>
                </div>
            </div>
        }

        <div class="pp-quick-bar">
            <span class="pp-quick-label">Filter by:</span>
            <select class="pp-quick-select" onchange="applyFilters()">
                <option value="">Type</option>
                <option>Tweed</option>
                <option>Bouclé</option>
                <option>Jacquard</option>
                <option>Velvet</option>
                <option>Crêpe</option>
            </select>
            <select class="pp-quick-select" onchange="applyFilters()">
                <option value="">Pattern</option>
                <option>Solid</option>
                <option>Checkered</option>
                <option>Striped</option>
                <option>Floral</option>
            </select>
            <select class="pp-quick-select" id="sortSelectMobile" onchange="document.getElementById('sortSelect').value=this.value; applyFilters()">
                <option value="new">Sort: New</option>
                <option value="asc">Price ↑</option>
                <option value="desc">Price ↓</option>
                <option value="name">Name A–Z</option>
            </select>
        </div>

        <p class="pp-count" id="resultsCount">@Model.Count() @SharedLocalizer["products"]</p>

        <div class="pp-grid" id="productGrid">
            @foreach (var item in Model)
            {
                var itemPrice = item.Price - item.Price * (item.Discount / 100);

                <a href="@Url.Action("Details", "Home", new { id = item.Id, area = "Customer" })"
                       class="pp-card"
                       data-name="@item.Name.ToLower()"
                       data-price="@itemPrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                       data-width="@(item.Height ?? 0)"
                       data-weight="@(item.Weight ?? 0)">

                    <div class="pp-card-img-wrap">
                        <img src="~/images/@item.MainImage" alt="@item.Name" class="pp-card-img" />
                        <span class="pp-card-sku">@item.SKU</span>
                        @if (item.Discount > 0)
                        {
                            <span class="pp-card-badge">–@item.Discount%</span>
                        }
                    </div>

                    <div class="pp-card-body">
                        <h3 class="pp-card-name">@item.Name</h3>

                        @if (item.ProductCompositions?.Any() == true)
                        {
                            <p class="pp-card-comp">
                                @string.Join("  ", item.ProductCompositions.Take(4)
                                    .Select(c => $"{c.Percentage}% {(c.Composition?.Name?.Length > 2 ? c.Composition.Name.Substring(0, 2).ToUpper() : c.Composition?.Name?.ToUpper())}"))
                            </p>
                        }

                        <div class="pp-card-specs">
                            @if (item.Height.HasValue)
                            {
                                <span>@item.Height cm</span>
                            }
                            @if (item.Weight.HasValue)
                            {
                                <span>@item.Weight g/m</span>
                            }
                        </div>

                        <div class="pp-card-price-row">
                            <span class="pp-card-price">€ @itemPrice.ToString("N2").Replace(".", ",") / m</span>
                            @if (item.StockQuantity != null)
                            {
                                <span class="pp-card-stock">@item.StockQuantity m</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>

        <div class="pp-empty" id="emptyState">
            <h3>@SharedLocalizer["No products found"]</h3>
            <p>@SharedLocalizer["Try adjusting your filters"]</p>
            <button onclick="resetAll()">@SharedLocalizer["Reset all filters"]</button>
        </div>

        <div class="pp-pagination" id="paginationWrap">
            <div class="pp-pagination" id="paginationWrap">
                <nav aria-label="Page navigation example">
                    <ul class="pagination">
                        @if (ViewBag.currentPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="/Customer/Home/categroysearch?page=@(ViewBag.currentPage - 1)">@SharedLocalizer["Previous"]</a></li>
                        }

                        @for (var i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            @if (i == ViewBag.currentPage)
                            {
                                <li class="page-item active"><a class="page-link" href="/Customer/Home/categroysearch?page=@i">@i</a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="/Customer/Home/categroysearch?&page=@i">@i</a></li>
                            }

                        }

                        @if (ViewBag.currentPage != ViewBag.TotalPages && Model.Any())
                        {
                            <li class="page-item"><a class="page-link" href="/Customer/Home/categroysearch?page=@(ViewBag.currentPage + 1)">@SharedLocalizer["Next"]</a></li>
                        }
                    </ul>
                </nav>
            </div>
        </div>

    </main>
</div>

@section Scripts {
    <script>
        const ITEMS_PER_PAGE = 12;
        let currentPage = 1;

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase().trim();
            const maxW = parseInt(document.getElementById('widthRange').value);
            const maxWt = parseInt(document.getElementById('weightRange').value);
            const sort = document.getElementById('sortSelect').value;

            let cards = Array.from(document.querySelectorAll('#productGrid .pp-card'));

            let visible = cards.filter(c => {
                const nameOk = c.dataset.name.includes(search);
                const wOk = !c.dataset.width || parseInt(c.dataset.width) <= maxW;
                const wtOk = !c.dataset.weight || parseInt(c.dataset.weight) <= maxWt;
                return nameOk && wOk && wtOk;
            });

            if (sort === 'asc') visible.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
            if (sort === 'desc') visible.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
            if (sort === 'name') visible.sort((a, b) => a.dataset.name.localeCompare(b.dataset.name));

            cards.forEach(c => c.style.display = 'none');

            const total = Math.max(1, Math.ceil(visible.length / ITEMS_PER_PAGE));
            currentPage = Math.min(currentPage, total);
            const start = (currentPage - 1) * ITEMS_PER_PAGE;
            visible.slice(start, start + ITEMS_PER_PAGE).forEach(c => c.style.display = '');

            document.getElementById('resultsCount').textContent =
                visible.length + ' product' + (visible.length !== 1 ? 's' : '');
            document.getElementById('emptyState').classList.toggle('show', visible.length === 0);
            renderPagination(total);
        }

        function renderPagination(total) {
            const wrap = document.getElementById('paginationWrap');
            wrap.innerHTML = '';
            if (total <= 1) return;

            const btn = (label, page, active) =>
                `<button class="pp-page-btn${active ? ' active' : ''}${typeof label === 'string' ? ' pp-page-text' : ''}"
                        onclick="goPage(${page})">${label}</button>`;

            if (currentPage > 1) wrap.innerHTML += btn('Previous', currentPage - 1, false);
            for (let i = 1; i <= total; i++) wrap.innerHTML += btn(i, i, i === currentPage);
            if (currentPage < total) wrap.innerHTML += btn('Next', currentPage + 1, false);
        }

        function goPage(n) { currentPage = n; applyFilters(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
        function clearSearch() { document.getElementById('searchInput').value = ''; applyFilters(); }
        function resetSort() { document.getElementById('sortSelect').value = 'new'; applyFilters(); }
        function resetRange(id, val, labelId, label) {
            document.getElementById(id).value = val;
            document.getElementById(labelId).textContent = label;
            // applyFilters();
        }
        function resetAll() {
            clearSearch(); resetSort();
            resetRange('widthRange', '200', 'widthVal', '200 cm');
            resetRange('weightRange', '700', 'weightVal', '700 g');
            currentPage = 1;
            applyFilters();
        }
        function toggleMobilePanel() {
            document.getElementById('mobilePanel').classList.toggle('open');
        }
    </script>
}