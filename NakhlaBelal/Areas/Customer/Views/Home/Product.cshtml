@model List<Product>
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    var currentColor       = ViewBag.Filter?.ColorId?.ToString()       ?? "";
    var currentType        = ViewBag.Filter?.FabricTypeId?.ToString()   ?? "";
    var currentComposition = ViewBag.Filter?.CompositionId?.ToString()  ?? "";
    var currentProject     = ViewBag.Filter?.ProjectCategoryId?.ToString() ?? "";
}

<div class="pp-wrap">

    <aside class="pp-sidebar">
        <div class="pp-sidebar-inner" id="sidebarInner">
            <h2 class="pp-sidebar-title">@SharedLocalizer["Filters"]</h2>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Search Products"]</span>
                    <button onclick="clearSearch()">@SharedLocalizer["Clear"]</button>
                </div>
                <div class="pp-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input id="searchInput" type="text" class="pp-input" placeholder="@SharedLocalizer["Type & hit ENTER"]" oninput="applyFilters()" />
                </div>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Sortby"]</span>
                    <button onclick="resetSort()">@SharedLocalizer["Reset"]</button>
                </div>
                <select id="sortSelect" class="pp-select" onchange="applyFilters()">
                    <option value="new">New arrivals</option>
                    <option value="asc">Price: Low to High</option>
                    <option value="desc">Price: High to Low</option>
                    <option value="name">Name A-Z</option>
                </select>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Width(cm)"]</span>
                    <button onclick="resetRange('widthRange','200','widthVal','200 cm')">@SharedLocalizer["Reset"]</button>
                </div>
                <input type="range" id="widthRange" class="pp-range" min="100" max="200" value="200"
                       oninput="document.getElementById('widthVal').textContent=this.value+' cm'; applyFilters()" />
                <div class="pp-range-labels">
                    <span>100 cm</span><span id="widthVal">200 cm</span>
                </div>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Weight(g/m)"]</span>
                    <button onclick="resetRange('weightRange','700','weightVal','700 g')">@SharedLocalizer["Reset"]</button>
                </div>
                <input type="range" id="weightRange" class="pp-range" min="200" max="700" value="700"
                       oninput="document.getElementById('weightVal').textContent=this.value+' g'; applyFilters()" />
                <div class="pp-range-labels">
                    <span>200 g</span><span id="weightVal">700 g</span>
                </div>
            </div>

            @{
                var minP = (int)(ViewBag.MinPriceBound ?? 0);
                var maxP = (int)(ViewBag.MaxPriceBound ?? 1000);
                if (maxP <= minP) maxP = minP + 100;
            }
            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Price"] (€)</span>
                    <button onclick="resetRange('priceRange','@maxP','priceVal','€ @maxP')">@SharedLocalizer["Reset"]</button>
                </div>
                <input type="range" id="priceRange" class="pp-range" min="@minP" max="@maxP" value="@maxP"
                       oninput="document.getElementById('priceVal').textContent='€ '+this.value; applyFilters()" />
                <div class="pp-range-labels">
                    <span>€ @minP</span><span id="priceVal">€ @maxP</span>
                </div>
            </div>

            <div class="pp-filter-block">
                <div class="pp-filter-head">
                    <span>@SharedLocalizer["Unit"]</span>
                    <button onclick="document.getElementById('unitSelect').value=''; applyFilters()">@SharedLocalizer["Reset"]</button>
                </div>
                <select id="unitSelect" class="pp-select" onchange="applyFilters()">
                    <option value="">@SharedLocalizer["Any"]</option>
                    <option value="@UnitHelper.Meter">@SharedLocalizer["Meter"]</option>
                    <option value="@UnitHelper.Piece">@SharedLocalizer["Piece"]</option>
                    <option value="@UnitHelper.Kilo">@SharedLocalizer["Kilo"]</option>
                    <option value="@UnitHelper.Yard">@SharedLocalizer["Yard"]</option>
                </select>
            </div>

            <button class="pp-view-all" onclick="resetAll()">@SharedLocalizer["View All Products"]</button>
        </div>
    </aside>

    <main class="pp-main">

        <button class="pp-mobile-btn" onclick="toggleMobilePanel()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="8" y1="12" x2="20" y2="12" />
                <line x1="12" y1="18" x2="20" y2="18" />
            </svg>
            @SharedLocalizer["SHOW FILTERS"]
        </button>

        <div class="pp-mobile-panel" id="mobilePanel">
            <div class="pp-mobile-panel-head">
                <span>@SharedLocalizer["Filters"]</span>
                <button onclick="toggleMobilePanel()">×</button>
            </div>
            <div class="pp-filter-block">
                <div class="pp-filter-head"><span>@SharedLocalizer["Search"]</span></div>
                <input id="mSearchInput" type="text" class="pp-input" placeholder="Type & hit ENTER"
                       oninput="document.getElementById('searchInput').value=this.value; applyFilters()" />
            </div>

            {{-- نفس الـ cs-topfilters للموبايل - تحويل server-side --}}
            <div class="cs-topfilters">
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label">@SharedLocalizer["Color"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('ColorId', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        @if (ViewBag.Colors != null)
                        {
                            @foreach (var color in ViewBag.Colors)
                            {
                                <option value="@color.Id" selected="@(currentColor == color.Id.ToString() ? "selected" : null)">@SharedLocalizer[@color.Name]</option>
                            }
                        }
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["Type"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('FabricTypeId', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        @if (ViewBag.FabricTypes != null)
                        {
                            @foreach (var fabricType in ViewBag.FabricTypes)
                            {
                                <option value="@fabricType.Id" selected="@(currentType == fabricType.Id.ToString() ? "selected" : null)">@SharedLocalizer[@fabricType.Name]</option>
                            }
                        }
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label">@SharedLocalizer["Unit"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('Unit', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        <option value="@UnitHelper.Meter" selected="@(ViewBag.Filter?.Unit == UnitHelper.Meter ? "selected" : null)">@SharedLocalizer["Meter"]</option>
                        <option value="@UnitHelper.Piece" selected="@(ViewBag.Filter?.Unit == UnitHelper.Piece ? "selected" : null)">@SharedLocalizer["Piece"]</option>
                        <option value="@UnitHelper.Kilo"  selected="@(ViewBag.Filter?.Unit == UnitHelper.Kilo  ? "selected" : null)">@SharedLocalizer["Kilo"]</option>
                        <option value="@UnitHelper.Yard"  selected="@(ViewBag.Filter?.Unit == UnitHelper.Yard  ? "selected" : null)">@SharedLocalizer["Yard"]</option>
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["COMPOSITION"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('CompositionId', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        @if (ViewBag.Compositions != null)
                        {
                            @foreach (var composition in ViewBag.Compositions)
                            {
                                <option value="@composition.Id" selected="@(currentComposition == composition.Id.ToString() ? "selected" : null)">@SharedLocalizer[@composition.Name]</option>
                            }
                        }
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["PROJECT"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('ProjectCategoryId', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        @if (ViewBag.ProjectCategory != null)
                        {
                            @foreach (var project in ViewBag.ProjectCategory)
                            {
                                <option value="@project.Id" selected="@(currentProject == project.Id.ToString() ? "selected" : null)">@SharedLocalizer[@project.Name]</option>
                            }
                        }
                    </select>
                </div>
                <div class="cs-topfilter-item">
                    <span class="cs-topfilter-label"> @SharedLocalizer["Pattern"]</span>
                    <select class="cs-topfilter-select" onchange="navigateFilter('Pattern', this.value)">
                        <option value="">@SharedLocalizer["Any"]</option>
                        @foreach (var pv in Enum.GetValues<NakhlaBelal.Models.ProductPattern>())
                        {
                            if (pv == NakhlaBelal.Models.ProductPattern.None) { continue; }
                            var sel = ViewBag.Filter?.Pattern != null && ViewBag.Filter.Pattern == pv ? "selected" : null;
                            <option value="@pv" selected="@sel">@SharedLocalizer[pv.EnglishLabel()]</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_ActiveFilterChips", ViewBag.Filter as NakhlaBelal.ViewModels.FilterVM)

        

        <p class="pp-count" id="resultsCount">@Model.Count() @SharedLocalizer["products"]</p>

        @* {{-- cs-topfilters الرئيسي - server-side --}} *@
        <div class="cs-topfilters">
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label">@SharedLocalizer["Color"]</span>
                <select class="cs-topfilter-select" onchange="navigateFilter('ColorId', this.value)">
                    <option value="">@SharedLocalizer["Any"]</option>
                    @if (ViewBag.Colors != null)
                    {
                        @foreach (var color in ViewBag.Colors)
                        {
                            <option value="@color.Id" selected="@(currentColor == color.Id.ToString() ? "selected" : null)">@SharedLocalizer[@color.Name]</option>
                        }
                    }
                </select>
            </div>
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label"> @SharedLocalizer["Type"]</span>
                <select class="cs-topfilter-select" onchange="navigateFilter('FabricTypeId', this.value)">
                    <option value="">@SharedLocalizer["Any"]</option>
                    @if (ViewBag.FabricTypes != null)
                    {
                        @foreach (var fabricType in ViewBag.FabricTypes)
                        {
                            <option value="@fabricType.Id" selected="@(currentType == fabricType.Id.ToString() ? "selected" : null)">@SharedLocalizer[@fabricType.Name]</option>
                        }
                    }
                </select>
            </div>
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label">@SharedLocalizer["Unit"]</span>
                <select class="cs-topfilter-select" onchange="navigateFilter('Unit', this.value)">
                    <option value="">@SharedLocalizer["Any"]</option>
                    <option value="@UnitHelper.Meter" selected="@(ViewBag.Filter?.Unit == UnitHelper.Meter ? "selected" : null)">@SharedLocalizer["Meter"]</option>
                    <option value="@UnitHelper.Piece" selected="@(ViewBag.Filter?.Unit == UnitHelper.Piece ? "selected" : null)">@SharedLocalizer["Piece"]</option>
                    <option value="@UnitHelper.Kilo"  selected="@(ViewBag.Filter?.Unit == UnitHelper.Kilo  ? "selected" : null)">@SharedLocalizer["Kilo"]</option>
                    <option value="@UnitHelper.Yard"  selected="@(ViewBag.Filter?.Unit == UnitHelper.Yard  ? "selected" : null)">@SharedLocalizer["Yard"]</option>
                </select>
            </div>
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label"> @SharedLocalizer["COMPOSITION"]</span>
                <select class="cs-topfilter-select" onchange="navigateFilter('CompositionId', this.value)">
                    <option value="">@SharedLocalizer["Any"]</option>
                    @if (ViewBag.Compositions != null)
                    {
                        @foreach (var composition in ViewBag.Compositions)
                        {
                            <option value="@composition.Id" selected="@(currentComposition == composition.Id.ToString() ? "selected" : null)">@SharedLocalizer[@composition.Name]</option>
                        }
                    }
                </select>
            </div>
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label"> @SharedLocalizer["PROJECT"]</span>
                <select class="cs-topfilter-select" onchange="navigateFilter('ProjectCategoryId', this.value)">
                    <option value="">@SharedLocalizer["Any"]</option>
                    @if (ViewBag.ProjectCategory != null)
                    {
                        @foreach (var project in ViewBag.ProjectCategory)
                        {
                            <option value="@project.Id" selected="@(currentProject == project.Id.ToString() ? "selected" : null)">@SharedLocalizer[@project.Name]</option>
                        }
                    }
                </select>
            </div>
            <div class="cs-topfilter-item">
                <span class="cs-topfilter-label"> @SharedLocalizer["Pattern"]</span>
                <select class="cs-topfilter-select">
                    <option value="">@SharedLocalizer["Any"]</option>
                    <option>Solid</option>
                    <option>Checkered</option>
                    <option>Striped</option>
                    <option>Floral</option>
                </select>
            </div>
        </div>

        <div class="pp-grid" id="productGrid">
            @foreach (var item in Model)
            {
                var itemUnitKey  = UnitHelper.Normalize(item.UnitPrice);
                var itemCompStr  = item.ProductCompositions == null ? "" :
                    string.Join(" ", item.ProductCompositions.Select(c => c.Composition?.Name ?? "")).ToLower();
                var itemUnit     = UnitHelper.GetEnglishShort(item.UnitPrice);
                var itemFinalPrice = item.Price - item.Price * (item.Discount / 100m);
                bool itemLowStock = item.StockQuantity > 0 && item.StockQuantity < 10;
                bool itemOutOfStock = item.StockQuantity <= 0;

                <div class="pp-card eg-pcard"
                     data-name="@item.Name.ToLower()"
                     data-comp="@itemCompStr"
                     data-price="@itemFinalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-width="@(item.Width ?? 0)"
                     data-weight="@(item.Weight ?? 0)"
                     data-unit="@itemUnitKey">

                    @* Image + slide-up tray *@
                    <a href="@Url.Action("Details", "Home", new { id = item.Id, area = "Customer" })" class="eg-pcard-imgwrap" tabindex="-1">
                        <img src="~/images/@item.MainImage" alt="@item.Name" loading="lazy"
                             onerror="this.src='https://via.placeholder.com/300x400?text=Fabric'" />

                        @* Badges *@
                        <div class="eg-pcard-badges">
                            @if (item.Discount > 0)    { <span class="eg-badge eg-sale">-@item.Discount%</span> }
                            @if (item.IsNew == true)   { <span class="eg-badge eg-new">NEW</span> }
                        </div>

                        @* Slide-up action tray *@
                        <div class="eg-pcard-tray" onclick="event.preventDefault();event.stopPropagation();">
                            <button type="button" class="eg-tray-icon wishlist-btn" data-pid="@item.Id"
                                    onclick="toggleWishlist(@item.Id,this);return false;" title="@SharedLocalizer["Wishlist"]">
                                <i class="ri-heart-line"></i>
                            </button>
                            <button type="button" class="eg-tray-icon compare-btn" data-pid="@item.Id"
                                    onclick="toggleCompare(@item.Id,this);return false;" title="@SharedLocalizer["Compare"]">
                                <i class="ri-arrow-left-right-line"></i>
                            </button>
                            <button type="button" class="eg-tray-icon"
                                    onclick="openQuickView(@item.Id);return false;" title="@SharedLocalizer["Quick View"]">
                                <i class="ri-eye-line"></i>
                            </button>
                            <button type="button" class="eg-tray-icon"
                                    onclick="requestSampleQuick(@item.Id);return false;" title="@SharedLocalizer["Request Sample"]">
                                <i class="ri-scissors-cut-line"></i>
                            </button>
                            <a href="@Url.Action("Details","Home", new { id = item.Id, area="Customer" })"
                               class="eg-tray-cart">
                                <i class="ri-shopping-basket-line"></i>
                                <span>@SharedLocalizer["Add to Cart"]</span>
                            </a>
                        </div>
                    </a>

                    @* Card body *@
                    <div class="eg-pcard-body">
                        <div class="eg-pcard-meta">
                            <span class="eg-pcard-cat">@item.Category?.Name</span>
                            <span class="eg-pcard-stock @(itemOutOfStock ? "out" : itemLowStock ? "low" : "in")">
                                <span class="eg-stock-dot"></span>
                                @(itemOutOfStock ? SharedLocalizer["Out of stock"].Value : itemLowStock ? SharedLocalizer["Low stock"].Value : SharedLocalizer["In stock"].Value)
                            </span>
                        </div>

                        <h3 class="eg-pcard-name">
                            <a href="@Url.Action("Details","Home", new { id = item.Id, area="Customer" })">
                                @(item.Name.Length > 46 ? item.Name.Substring(0,46)+"…" : item.Name)
                            </a>
                        </h3>

                        <div class="eg-pcard-stars">
                            @for (int s = 1; s <= 5; s++) {
                                <i class="@(s <= Math.Floor(item.AverageRating) ? "fas" : "far") fa-star"></i>
                            }
                            <span>(@item.ReviewCount)</span>
                        </div>

                        <div class="eg-pcard-foot">
                            <div class="eg-pcard-pricing">
                                @if (item.Discount > 0)
                                {
                                    <span class="eg-price-sale">@SharedLocalizer["£"] @itemFinalPrice.ToString("N2")</span>
                                    <span class="eg-price-old">@SharedLocalizer["£"] @item.Price.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="eg-price">@SharedLocalizer["£"] @item.Price.ToString("N2")</span>
                                }
                                <span class="eg-unit">/ @SharedLocalizer[itemUnit]</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="pp-empty" id="emptyState">
            <h3>@SharedLocalizer["No products found"]</h3>
            <p>@SharedLocalizer["Try adjusting your filters"]</p>
            <button onclick="resetAll()">@SharedLocalizer["Reset all filters"]</button> 
        </div>

        <div class="pp-pagination" id="paginationWrap">
            <nav aria-label="Page navigation example">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Customer/Home/product?page=@(ViewBag.CurrentPage - 1)&ColorId=@currentColor&FabricTypeId=@currentType&CompositionId=@currentComposition&ProjectCategoryId=@currentProject">@SharedLocalizer["Previous"]</a>
                        </li>
                    }
                    @for (var i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/Customer/Home/product?page=@i&ColorId=@currentColor&FabricTypeId=@currentType&CompositionId=@currentComposition&ProjectCategoryId=@currentProject">@i</a>
                        </li>
                    }
                    @if (ViewBag.CurrentPage != ViewBag.TotalPages && Model.Any())
                    {
                        <li class="page-item">
                            <a class="page-link" href="/Customer/Home/product?page=@(ViewBag.CurrentPage + 1)&ColorId=@currentColor&FabricTypeId=@currentType&CompositionId=@currentComposition&ProjectCategoryId=@currentProject">@SharedLocalizer["Next"]</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>


        <!-- Recently Viewed strip -->
        <section id="recentlyViewedWrap" class="mb-3" style="display:none;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong class="small text-muted"><i class="ri-history-line me-1"></i>@SharedLocalizer["Recently Viewed"]</strong>
                <button type="button" class="btn btn-link btn-sm p-0 text-muted" onclick="clearRecentlyViewed()">@SharedLocalizer["Clear"]</button>
            </div>
            <div id="recentlyViewedStrip"></div>
        </section>
    </main>
</div>

<style>
/* ═══════════════════════════════════════════
   Egypt Product Card — Product.cshtml
   ═══════════════════════════════════════════ */
.eg-pcard {
    display: flex; flex-direction: column;
    background: #fff;
    border: 1px solid rgba(212,160,23,.18);
    border-radius: 8px;
    overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease;
    height: 100%;
}
.eg-pcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 42px rgba(0,59,111,.16);
}

/* Image wrapper */
.eg-pcard-imgwrap {
    position: relative; display: block;
    overflow: hidden; aspect-ratio: 3/4;
    background: #F0E6C8; text-decoration: none; flex-shrink: 0;
}
.eg-pcard-imgwrap img {
    width:100%; height:100%; object-fit:cover; display:block;
    transition: transform .5s ease;
}
.eg-pcard:hover .eg-pcard-imgwrap img { transform: scale(1.06); }

/* Badges */
.eg-pcard-badges {
    position:absolute; top:10px; inset-inline-start:10px;
    display:flex; flex-direction:column; gap:4px; z-index:4;
}
.eg-badge { font-size:9px; font-weight:800; letter-spacing:1px; padding:3px 8px; border-radius:3px; text-transform:uppercase; }
.eg-sale  { background:#D4A017; color:#1A2B3C; }
.eg-new   { background:#003B6F; color:#fff; }

/* Slide-up tray */
.eg-pcard-tray {
    position:absolute; bottom:0; left:0; right:0;
    display:flex; align-items:center; gap:6px; padding:10px;
    background:rgba(0,27,53,.82);
    backdrop-filter:blur(4px);
    transform:translateY(100%);
    transition:transform .3s cubic-bezier(.4,0,.2,1);
    z-index:5;
}
.eg-pcard:hover .eg-pcard-tray { transform:translateY(0); }

.eg-tray-icon {
    width:34px; height:34px; border-radius:6px; border:none;
    background:rgba(253,245,230,.12); color:#FDF5E6;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:15px; cursor:pointer; flex-shrink:0;
    transition:background .2s, color .2s, transform .15s;
}
.eg-tray-icon:hover   { background:#D4A017; color:#1A2B3C; transform:scale(1.1); }
.eg-tray-icon.active  { background:#D4A017; color:#1A2B3C; }
.eg-tray-icon.compare-btn.active { background:#0055A4; color:#D4A017; }

.eg-tray-cart {
    flex:1; display:inline-flex; align-items:center; justify-content:center; gap:6px;
    padding:7px 10px; background:#D4A017; color:#1A2B3C;
    border-radius:6px; font-family:'Cairo',sans-serif; font-size:12px; font-weight:700;
    text-decoration:none; transition:background .2s; white-space:nowrap;
}
.eg-tray-cart:hover { background:#C49010; color:#1A2B3C; }
.eg-tray-cart i { font-size:14px; }

/* Card body */
.eg-pcard-body {
    padding:12px 14px 14px; background:#fff;
    flex:1; display:flex; flex-direction:column; gap:5px;
}
.eg-pcard-meta {
    display:flex; align-items:center; justify-content:space-between; gap:6px;
}
.eg-pcard-cat { font-size:9px; letter-spacing:2px; text-transform:uppercase; color:#B8860B; }

/* Stock indicator */
.eg-pcard-stock {
    display:inline-flex; align-items:center; gap:4px;
    font-size:9px; font-weight:600; font-family:'Cairo',sans-serif;
}
.eg-stock-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
.eg-pcard-stock.in  { color:#2a7d4f; }
.eg-pcard-stock.in  .eg-stock-dot { background:#2a7d4f; box-shadow:0 0 0 2px rgba(42,125,79,.2); }
.eg-pcard-stock.low { color:#d47a00; }
.eg-pcard-stock.low .eg-stock-dot { background:#d47a00; box-shadow:0 0 0 2px rgba(212,122,0,.2); }
.eg-pcard-stock.out { color:#c0392b; }
.eg-pcard-stock.out .eg-stock-dot { background:#c0392b; box-shadow:0 0 0 2px rgba(192,57,43,.2); }

/* Name */
.eg-pcard-name { font-family:'Cairo',sans-serif; font-size:14px; font-weight:700; margin:0; line-height:1.4; }
.eg-pcard-name a { color:#1A2B3C; text-decoration:none; }
.eg-pcard-name a:hover { color:#003B6F; }

/* Stars */
.eg-pcard-stars { color:#D4A017; font-size:11px; display:flex; align-items:center; gap:2px; }
.eg-pcard-stars span { color:#aaa; font-size:10px; margin-inline-start:2px; }

/* Price */
.eg-pcard-foot    { margin-top:auto; }
.eg-pcard-pricing { display:flex; align-items:baseline; gap:5px; flex-wrap:wrap; }
.eg-price, .eg-price-sale { font-size:16px; font-weight:800; color:#003B6F; font-family:'Cairo',sans-serif; }
.eg-price-old     { font-size:11px; color:#bbb; text-decoration:line-through; }
.eg-unit          { font-size:11px; color:#B8860B; }
</style>

<script>
    /* =========================================================
       Product listing — sidebar JS
       - الكروت تنعرض كلها أول تحميل (server paginated فعلاً)
       - الـ sidebar يفلتر client-side على نتائج الصفحة الحالية
       - لو المستخدم عامل فلاتر server-side (من cs-topfilters) بنحتفظ فيها
       ========================================================= */
    const $  = (id) => document.getElementById(id);
    let searchTimer = null;

    // cs-topfilters → server-side: يحفظ باقي الـ params ويغير اللي المطلوب
    function navigateFilter(paramName, value) {
        const url = new URL(window.location.href);
        url.searchParams.set('page', '1');
        if (value === '' || value == null) url.searchParams.delete(paramName);
        else                                url.searchParams.set(paramName, value);
        window.location.href = url.toString();
    }

    // debounce للبحث النصي
    function onSearchInput() {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(applyFilters, 150);
    }

    function applyFilters() {
        const search  = ($('searchInput')?.value || '').trim().toLowerCase();
        const maxW    = parseInt($('widthRange')?.value  || '9999');
        const maxWt   = parseInt($('weightRange')?.value || '9999');
        const maxPr   = parseFloat($('priceRange')?.value || '9e9');
        const unitVal = $('unitSelect')?.value || '';
        const sort    = $('sortSelect')?.value || 'new';

        const cards = Array.from(document.querySelectorAll('#productGrid .pp-card'));

        const visible = cards.filter(c => {
            const name = c.dataset.name || '';
            const comp = c.dataset.comp || '';
            const nameMatch = !search || name.includes(search) || comp.includes(search);

            const w  = parseFloat(c.dataset.width);
            const wt = parseFloat(c.dataset.weight);
            const pr = parseFloat(c.dataset.price);
            const unit = c.dataset.unit || '';

            const wOk  = isNaN(w)  || w  <= maxW;
            const wtOk = isNaN(wt) || wt <= maxWt;
            const prOk = isNaN(pr) || pr <= maxPr;
            const unitOk = !unitVal || unit === unitVal;

            return nameMatch && wOk && wtOk && prOk && unitOk;
        });

        // الترتيب
        if (sort === 'asc')  visible.sort((a,b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
        if (sort === 'desc') visible.sort((a,b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
        if (sort === 'name') visible.sort((a,b) => (a.dataset.name||'').localeCompare(b.dataset.name||''));

        // أخفي كل الكروت ثم رجّع الظاهرين بالترتيب الجديد
        const grid = $('productGrid');
        cards.forEach(c => c.style.display = 'none');
        visible.forEach(c => { c.style.display = ''; grid.appendChild(c); });

        // عداد + empty state
        const count = visible.length;
        const countEl = $('resultsCount');
        if (countEl) countEl.textContent = count + ' ' + (count === 1 ? 'product' : 'products');
        const emptyEl = $('emptyState');
        if (emptyEl) emptyEl.style.display = count === 0 ? 'block' : 'none';
    }

    function clearSearch() { const el = $('searchInput'); if (el) el.value=''; applyFilters(); }
    function resetSort()   { const el = $('sortSelect');  if (el) el.value='new'; applyFilters(); }
    function resetRange(id, val, labelId, label) {
        const r = $(id);   if (r) r.value = val;
        const l = $(labelId); if (l) l.textContent = label;
        applyFilters();
    }

    // Reset All = امسح كل الفلاتر من الـ URL (server + client) وارجع للصفحة النظيفة
    function resetAll() {
        const url = new URL(window.location.href);
        ['ColorId','FabricTypeId','CompositionId','ProjectCategoryId','CategoryId','Unit','Name','MinPriceDecimal','MaxPriceDecimal','page']
            .forEach(k => url.searchParams.delete(k));
        window.location.href = url.pathname;
    }

    function toggleMobilePanel() {
        $('mobilePanel')?.classList.toggle('open');
    }

    // ربط الـ search بالـ debounce
    document.addEventListener('DOMContentLoaded', () => {
        const s = $('searchInput');
        if (s) { s.removeAttribute('oninput'); s.addEventListener('input', onSearchInput); }
        const ms = $('mSearchInput');
        if (ms) ms.addEventListener('input', () => { const sEl=$('searchInput'); if (sEl) sEl.value = ms.value; onSearchInput(); });
    });
</script>