}
.eg-offers-content h2 { font-family: 'Cairo', sans-serif; font-size: 48px; font-weight: 900; color: #fff; margin: 0; line-height: 1; }
.eg-offers-content p { font-size: 16px; color: rgba(255,255,255,.75); margin: 0; }
.eg-offers-btn {
