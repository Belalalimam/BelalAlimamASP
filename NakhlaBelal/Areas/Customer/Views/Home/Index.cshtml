@{
    ViewBag.Title = "Home";
}
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<section class="hero-swiper-wrap">
    <div class="swiper heroSwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="hero-slide" style="background-image:url('https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=1600&q=80');">
                    <div class="hero-slide-overlay"></div>
                    <div class="hero-slide-content">
                        <h1>@SharedLocalizer["Find High-Quality Textiles In our Online Fabric Store"]</h1>
                        <p>@SharedLocalizer["Design your dreams and make them come true with our online fabrics."]</p>
                        <a href="@Url.Action("Product", "Home")" class="hero-slide-btn theme-btn">@SharedLocalizer["Browse Our Fabrics"]</a>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="hero-slide" style="background-image:url('https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1600&q=80');">
                    <div class="hero-slide-overlay"></div>
                    <div class="hero-slide-content">
                        <h1>@SharedLocalizer["Premium Materials for Every Project"]</h1>
                        <p>@SharedLocalizer["Discover a curated selection of fabrics, labels, and packaging."]</p>
                        <a href="@Url.Action("Product", "Home")" class="hero-slide-btn theme-btn">@SharedLocalizer["Shop Now"]</a>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="hero-slide" style="background-image:url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1600&q=80');">
                    <div class="hero-slide-overlay"></div>
                    <div class="hero-slide-content">
                        <h1>@SharedLocalizer["New Arrivals This Season"]</h1>
                        <p>@SharedLocalizer["Fresh designs, trusted quality — delivered to your door."]</p>
                        <a href="@Url.Action("Product", "Home")" class="hero-slide-btn theme-btn">@SharedLocalizer["Explore Collection"]</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
</section>

<style>
    .hero-swiper-wrap { position: relative; margin-bottom: 30px; }
    .heroSwiper { width: 100%; height: 520px; }
    .hero-slide {
        position: relative;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 0 8%;
    }
    .hero-slide-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,.2) 60%, rgba(0,0,0,0) 100%);
    }
    [dir="rtl"] .hero-slide-overlay {
        background: linear-gradient(270deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,.2) 60%, rgba(0,0,0,0) 100%);
    }
    .hero-slide-content {
        position: relative;
        z-index: 2;
        max-width: 620px;
        color: #fff;
    }
    .hero-slide-content h1 {
        font-size: 40px;
        font-weight: 800;
        line-height: 1.2;
        margin: 0 0 14px;
        text-shadow: 0 2px 10px rgba(0,0,0,.35);
    }
    .hero-slide-content p {
        font-size: 17px;
        margin: 0 0 22px;
        opacity: .95;
    }
    .hero-slide-btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        transition: filter .15s ease, transform .15s ease;
    }
    .hero-slide-btn:hover { filter: brightness(1.1); transform: translateY(-2px); }
    .heroSwiper .swiper-button-prev,
    .heroSwiper .swiper-button-next {
        color: #fff;
        background: rgba(0,0,0,.35);
        width: 44px; height: 44px;
        border-radius: 50%;
        backdrop-filter: blur(4px);
    }
    .heroSwiper .swiper-button-prev:after,
    .heroSwiper .swiper-button-next:after { font-size: 18px; font-weight: 700; }
    .heroSwiper .swiper-pagination-bullet { background: #fff; opacity: .6; }
    .heroSwiper .swiper-pagination-bullet-active { opacity: 1; background: var(--brand-secondary, #ffd700); }
    @@media (max-width: 767px) {
        .heroSwiper { height: 380px; }
        .hero-slide { padding: 0 24px; }
        .hero-slide-content h1 { font-size: 26px; }
        .hero-slide-content p { font-size: 14px; }
        .hero-slide-btn { padding: 10px 22px; font-size: 14px; }
        .heroSwiper .swiper-button-prev,
        .heroSwiper .swiper-button-next { display: none; }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new Swiper('.heroSwiper', {
                loop: true,
                autoplay: { delay: 5500, disableOnInteraction: false },
                speed: 700,
                effect: 'fade',
                fadeEffect: { crossFade: true },
                pagination: { el: '.heroSwiper .swiper-pagination', clickable: true },
                navigation: {
                    nextEl: '.heroSwiper .swiper-button-next',
                    prevEl: '.heroSwiper .swiper-button-prev'
                }
            });
        });
    </script>
}

<section class="dynamic-categories container py-5">
    <div class="dc-header text-center mb-4">
        <h2 class="dc-title">@SharedLocalizer["Shop by Category"]</h2>
        <p class="dc-sub text-muted">@SharedLocalizer["Browse our categories and find what fits your project"]</p>
    </div>

    @if (ViewBag.Categories != null && ((IEnumerable<NakhlaBelal.Models.Category>)ViewBag.Categories).Any())
    {
        <div class="dc-grid">
            @foreach (var cat in (IEnumerable<NakhlaBelal.Models.Category>)ViewBag.Categories)
            {
                <a href="@Url.Action("CategroySearch", "Home", new { CategoryId = cat.Id })"
                   class="dc-card"
                   title="@cat.Name">
                    <div class="dc-thumb">
                        @if (!string.IsNullOrWhiteSpace(cat.ImageUrl))
                        {
                            <img src="~/images/@cat.ImageUrl" alt="@cat.Name" loading="lazy" />
                        }
                        else if (!string.IsNullOrWhiteSpace(cat.IconClass))
                        {
                            <span class="dc-icon"><i class="@cat.IconClass"></i></span>
                        }
                        else
                        {
                            <span class="dc-icon"><i class="ri-price-tag-3-line"></i></span>
                        }
                    </div>
                    <span class="dc-name">@SharedLocalizer[cat.Name]</span>
                </a>
            }
        </div>
    }
</section>

<style>
    .dynamic-categories .dc-title { font-weight: 700; letter-spacing: .3px; }
    .dynamic-categories .dc-sub { font-size: 15px; }
    .dc-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 18px;
    }
    .dc-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: inherit;
        transition: transform .25s ease;
    }
    .dc-card:hover { transform: translateY(-4px); }
    .dc-thumb {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 18px;
        overflow: hidden;
        background: linear-gradient(135deg, #f5f5f7 0%, #e9ecef 100%);
        box-shadow: 0 4px 14px rgba(0,0,0,.06);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: box-shadow .25s ease, transform .25s ease;
    }
    .dc-card:hover .dc-thumb { box-shadow: 0 10px 24px rgba(0,0,0,.12); }
    .dc-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .dc-icon { font-size: 38px; color: #1a1a2e; }
    .dc-name {
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        color: #1a1a2e;
    }
    @@media (max-width: 1199px) { .dc-grid { grid-template-columns: repeat(5, 1fr); } }
    @@media (max-width: 991px)  { .dc-grid { grid-template-columns: repeat(4, 1fr); } }
    @@media (max-width: 767px)  { .dc-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; } .dc-name { font-size: 13px; } }
    @@media (max-width: 480px)  { .dc-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; } }
</style>





 
<div class="container  ">
    <!-- Search Section -->
    <div class="changeColor">
        <h1 class="text-center">@SharedLocalizer["Search for the fabric you desire:"]</h1>
    </div>


    <form class="home-search" action="@Url.Action("CategroySearch", "Home")" method="get" role="search" autocomplete="off">
        <div class="home-search-inner">
            <i class="ri-search-line home-search-icon" aria-hidden="true"></i>
            <input type="text" name="Name" class="home-search-input"
                   placeholder="@SharedLocalizer["Search for products, categories, colors..."]"
                   aria-label="@SharedLocalizer["Search"]" />
            <button type="submit" class="home-search-btn theme-btn">
                <i class="ri-search-line d-md-none"></i>
                <span class="d-none d-md-inline">@SharedLocalizer["Search"]</span>
            </button>
        </div>
    </form>
    <style>
        .home-search { max-width: 720px; margin: 0 auto 28px; padding: 0 12px; }
        .home-search-inner {
            position: relative;
            display: flex;
            align-items: center;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            box-shadow: 0 6px 18px rgba(0,0,0,.06);
            transition: box-shadow .2s ease, border-color .2s ease;
        }
        .home-search-inner:focus-within {
            border-color: var(--brand-primary, #013220);
            box-shadow: 0 8px 22px rgba(0,0,0,.12);
        }
        .home-search-icon {
            font-size: 20px;
            color: #9ca3af;
            padding: 0 16px;
            flex: 0 0 auto;
        }
        .home-search-input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            padding: 14px 0;
            font-size: 15px;
            min-width: 0;
        }
        .home-search-btn {
            border: none;
            border-radius: 999px;
            padding: 10px 22px;
            margin: 5px;
            font-weight: 600;
            cursor: pointer;
            flex: 0 0 auto;
            transition: filter .15s ease;
        }
        .home-search-btn:hover { filter: brightness(1.1); }
        @@media (max-width: 575px) {
            .home-search-btn { padding: 10px 14px; }
            .home-search-input { font-size: 14px; padding: 12px 0; }
            .home-search-icon { padding: 0 12px; font-size: 18px; }
        }
    </style>

    <!-- Divider -->
    <div class="changeColor">
        <h2 class="or-text text-center">@SharedLocalizer["Or start from here"]</h2>
        <p class="sub-text text-center">
            @SharedLocalizer["What are you making? Choose the fabrics best suited to your project."]
        </p>
    </div>
</div>





<!-- Categories -->
<div class="categories2">
    @if (ViewBag.ProjectCategories != null)
    {
        @foreach (var project in ViewBag.ProjectCategories)
        {
            <a href="@Url.Action("CategroySearch", "Home", new { ProjectCategoryId = project.Id })" class="cat text-decoration-none">
                <i class="@project.Icon"></i> @SharedLocalizer[project.Name]
            </a>
        }
    }
</div>





<!-- COLOR FILTER SECTION -->
<section class="color-filter container">
    <div class="color-row">
        @if (ViewBag.Colors != null)
        {
            @foreach (var color in ViewBag.Colors)
            {
                <a href="@Url.Action("CategroySearch", "Home", new { ColorId = color.Id })"
                       class="color-circle"
                       style="background:@color.HexCode;"
                       title="@color.Name">
                </a>
            }
        }
    </div>
</section>

<!-- FABRIC TYPES -->
<section class="fabric-types container">
    <h2>@SharedLocalizer["What material do you need? Browse our fabrics by type"]</h2>

    <div class="fabric-grid">
        @if (ViewBag.FabricTypes != null)
        {
            @foreach (var type in ViewBag.FabricTypes)
            {
                <a class="fabric-card" href="@Url.Action("CategroySearch", "Home", new { FabricTypeId = type.Id })">
                    <img src="~/images/@type.ImageUrl" alt="@type.Name">
                        <span>@SharedLocalizer[type.Name]</span>
                    </a>
                }
            }
        </div>
    </section>


    <section class="seo-section">
        <div class="seo-container">

            <h2>@SharedLocalizer["Discover Quality Fabrics for Every Project"]</h2>

            <p>
                @SharedLocalizer["We provide a carefully curated selection of high-quality fabrics designed to meet the needs of designers, tailors, and fashion enthusiasts.Whether you are creating formal wear, casual clothing, or custom pieces, our platform helps you find the right materials with confidence."]
            </p>

            <p>
                @SharedLocalizer["Our fabric collection includes options for dresses, suits, shirts, coats, and lightweight garments, allowing you to choose based on texture, weight, and purpose. Each product is selected with attention to quality, durability, and comfort."]
            </p>

            <p>
                @SharedLocalizer["We believe that a great shopping experience should be simple and enjoyable. That’s why our platform is designed with intuitive search tools, clear categorization, and a smooth browsing experience across all devices."]
            </p>

            <p>
                @SharedLocalizer["From discovering new materials to selecting trusted classics, we aim to support your creative journey by offering reliable products and a seamless online experience."]
            </p>

        </div>
    </section>

    <!-- Recently Viewed strip (populated from localStorage) -->
    <section class="container my-5" id="recentlyViewedWrap" style="display:none;">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0"><i class="ri-history-line me-2"></i>@SharedLocalizer["Recently Viewed"]</h3>
            <button type="button" class="btn btn-link btn-sm text-muted" onclick="clearRecentlyViewed()">@SharedLocalizer["Clear"]</button>
        </div>
        <div id="recentlyViewedStrip"></div>
    </section>
