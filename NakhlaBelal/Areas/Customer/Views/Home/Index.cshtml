.eg-cat-tile-overlay span { font-family: 'Cairo', sans-serif; color: #fff; font-size: 13px; font-weight: 700; text-align: center; transform: translateY(8px); transition: transform .3s; }
.eg-cat-tile-overlay i { color: var(--eg-gold,#D4A017); font-size: 16px; transform: translateY(8px); transition: transform .3s .05s; }
.eg-cat-tile:hover .eg-cat-tile-overlay span,
.eg-cat-tile:hover .eg-cat-tile-overlay i { transform: translateY(0); }

/* ── Offers Banner ── */
.eg-offers-banner {
    background: var(--eg-blue,#003B6F);
    display: flex; align-items: stretch;
    min-height: 240px; overflow: hidden; position: relative;
