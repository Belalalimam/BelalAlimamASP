/* ── Fabric Types Swiper ── */
.eg-fabrics-section { padding: 60px 40px; max-width: 1200px; margin: 0 auto; }
.fabricSwiper { padding: 10px 4px 16px !important; }
.eg-fabric-card { display: block; text-decoration: none; border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 3px 12px rgba(0,0,0,.07); transition: transform .3s, box-shadow .3s; }
.eg-fabric-card:hover { transform: translateY(-5px); box-shadow: 0 14px 32px rgba(0,59,111,.13); }
.eg-fabric-img { aspect-ratio: 2/3; overflow: hidden; }
.eg-fabric-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
.eg-fabric-card:hover .eg-fabric-img img { transform: scale(1.06); }
.eg-fabric-label {
    padding: 14px 16px; display: flex; align-items: center; justify-content: space-between;
    font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 700;
    color: var(--eg-blue,#003B6F);
    border-top: 3px solid var(--eg-gold,#D4A017);
}
.eg-fabric-label i { color: var(--eg-gold,#D4A017); font-size: 16px; transition: transform .2s; }
.eg-fabric-card:hover .eg-fabric-label i { transform: translate(3px, -3px); }
.eg-fab-prev, .eg-fab-next { color: var(--eg-blue,#003B6F) !important; background: #fff !important; width: 40px !important; height: 40px !important; border-radius: 50% !important; box-shadow: 0 4px 14px rgba(0,0,0,.12) !important; border: 1px solid rgba(0,59,111,.15) !important; }
