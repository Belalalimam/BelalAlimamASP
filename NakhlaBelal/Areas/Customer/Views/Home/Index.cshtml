@{
    ViewBag.Title = "Home";
}
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/animate.css" asp-append-version="true" />

@* ══════════════════════════════════════════════════════════
   SECTION 1 — HERO SLIDER (enhanced with animate.css)
══════════════════════════════════════════════════════════ *@
<section class="eg-hero-wrap">
    <div class="swiper heroSwiper">
        <div class="swiper-wrapper">

            <div class="swiper-slide">
                <div class="eg-slide" style="background-image:url('https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=1600&q=80')">
                    <div class="eg-slide-overlay"></div>
                    <div class="eg-panel animate__animated animate__fadeInLeft">
                        <p class="eg-glyph">𓂀  𓋹  𓂀</p>
                        <p class="eg-eyebrow animate__animated animate__fadeInDown">مجموعة متميزة</p>
                        <h1 class="animate__animated animate__fadeInUp">@SharedLocalizer["Find High-Quality Textiles In our Online Fabric Store"]</h1>
                        <p class="eg-sub animate__animated animate__fadeIn">@SharedLocalizer["Design your dreams and make them come true with our online fabrics."]</p>
                        <a href="@Url.Action("Product", "Home")" class="eg-cta animate__animated animate__fadeInUp">@SharedLocalizer["Browse Our Fabrics"]</a>
                        <p class="eg-glyph eg-glyph-bot">𓂀  𓋹  𓂀</p>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="eg-slide" style="background-image:url('https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1600&q=80')">
                    <div class="eg-slide-overlay"></div>
                    <div class="eg-panel animate__animated animate__fadeInLeft">
                        <p class="eg-glyph">𓂀  𓋹  𓂀</p>
                        <p class="eg-eyebrow">أقمشة راقية</p>
                        <h1>@SharedLocalizer["Premium Materials for Every Project"]</h1>
                        <p class="eg-sub">@SharedLocalizer["Discover a curated selection of fabrics, labels, and packaging."]</p>
                        <a href="@Url.Action("Product", "Home")" class="eg-cta">@SharedLocalizer["Shop Now"]</a>
                        <p class="eg-glyph eg-glyph-bot">𓂀  𓋹  𓂀</p>
                    </div>
                </div>
            </div>

            <div class="swiper-slide">
                <div class="eg-slide" style="background-image:url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1600&q=80')">
                    <div class="eg-slide-overlay"></div>
                    <div class="eg-panel animate__animated animate__fadeInLeft">
                        <p class="eg-glyph">𓂀  𓋹  𓂀</p>
                        <p class="eg-eyebrow">وصل حديثاً</p>
                        <h1>@SharedLocalizer["New Arrivals This Season"]</h1>
                        <p class="eg-sub">@SharedLocalizer["Fresh designs, trusted quality — delivered to your door."]</p>
                        <a href="@Url.Action("Product", "Home")" class="eg-cta">@SharedLocalizer["Explore Collection"]</a>
                        <p class="eg-glyph eg-glyph-bot">𓂀  𓋹  𓂀</p>
                    </div>
                </div>
            </div>

        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
    <div class="eg-hero-gold-strip"></div>
    <a href="#eg-trust" class="eg-scroll-hint" aria-label="Scroll down">
        <i class="ri-arrow-down-s-line"></i>
    </a>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 2 — TRUST BAR (NEW)
══════════════════════════════════════════════════════════ *@
<div class="eg-trust-bar eg-reveal" id="eg-trust">
    <div class="eg-trust-inner">
        <div class="eg-trust-item">
            <i class="ri-truck-line"></i>
            <div>
                <strong>@(ViewBag.IsArabic == true ? "شحن مجاني" : "Free Shipping")</strong>
                <span>@(ViewBag.IsArabic == true ? "للطلبات فوق $200" : "On orders over $200")</span>
            </div>
        </div>
        <div class="eg-trust-divider"></div>
        <div class="eg-trust-item">
            <i class="ri-shield-check-line"></i>
            <div>
                <strong>@(ViewBag.IsArabic == true ? "ضمان الجودة" : "Quality Guarantee")</strong>
                <span>@(ViewBag.IsArabic == true ? "أقمشة مختارة بعناية" : "Carefully selected fabrics")</span>
            </div>
        </div>
        <div class="eg-trust-divider"></div>
        <div class="eg-trust-item">
            <i class="ri-refresh-line"></i>
            <div>
                <strong>@(ViewBag.IsArabic == true ? "إرجاع سهل" : "Easy Returns")</strong>
                <span>@(ViewBag.IsArabic == true ? "خلال 14 يوم" : "Within 14 days")</span>
            </div>
        </div>
        <div class="eg-trust-divider"></div>
        <div class="eg-trust-item">
            <i class="ri-lock-line"></i>
            <div>
                <strong>@(ViewBag.IsArabic == true ? "دفع آمن" : "Secure Payment")</strong>
                <span>@(ViewBag.IsArabic == true ? "بيانات محمية بالكامل" : "100% protected data")</span>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════
   SECTION 3 — CATEGORIES — Full-image overlay tiles
══════════════════════════════════════════════════════════ *@
<section class="eg-cat-section eg-reveal">
    <div class="eg-section-header">
        <h2>@SharedLocalizer["Shop by Category"]</h2>
        <p>@SharedLocalizer["Browse our categories and find what fits your project"]</p>
    </div>

    @if (ViewBag.Categories != null && ((IEnumerable<NakhlaBelal.Models.Category>)ViewBag.Categories).Any())
    {
        <div class="eg-cat-grid">
            @foreach (var cat in (IEnumerable<NakhlaBelal.Models.Category>)ViewBag.Categories)
            {
                <a href="@Url.Action("CategroySearch", "Home", new { CategoryId = cat.Id })"
                   class="eg-cat-tile" title="@cat.Name">
                    @if (!string.IsNullOrWhiteSpace(cat.ImageUrl))
                    {
                        <img src="~/images/@cat.ImageUrl" alt="@cat.Name" loading="lazy" />
                    }
                    else
                    {
                        <div class="eg-cat-tile-fallback">
                            <i class="@(string.IsNullOrWhiteSpace(cat.IconClass) ? "ri-price-tag-3-line" : cat.IconClass)"></i>
                        </div>
                    }
                    <div class="eg-cat-tile-overlay">
                        <span>@SharedLocalizer[cat.Name]</span>
                        <i class="ri-arrow-right-line"></i>
                    </div>
                </a>
            }
        </div>
    }
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 4 — OFFERS BANNER (NEW)
══════════════════════════════════════════════════════════ *@
<section class="eg-offers-banner eg-reveal">
    <div class="eg-offers-content">
        <span class="eg-offers-tag">@(ViewBag.IsArabic == true ? "عروض حصرية" : "EXCLUSIVE DEALS")</span>
        <h2>@(ViewBag.IsArabic == true ? "خصومات تصل إلى ٤٠٪" : "SALE UP TO 40% OFF")</h2>
        <p>@(ViewBag.IsArabic == true ? "أقمشة فاخرة بأسعار استثنائية — لفترة محدودة" : "Premium fabrics at exceptional prices — limited time only")</p>
        <a href="@Url.Action("CategroySearch", "Home", new { OnSale = true })" class="eg-offers-btn">
            @(ViewBag.IsArabic == true ? "تسوق العروض الآن" : "Shop Sale Now")
            <i class="ri-arrow-right-line ms-2"></i>
        </a>
    </div>
    <div class="eg-offers-visual">
        <div class="eg-offers-shape"></div>
        <div class="eg-offers-pct">40<sup>%</sup></div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 5 — FABRIC TYPES — Swiper horizontal carousel
══════════════════════════════════════════════════════════ *@
<section class="eg-fabrics-section eg-reveal">
    <div class="eg-section-header">
        <h2>@SharedLocalizer["What material do you need? Browse our fabrics by type"]</h2>
        <a href="@Url.Action("Product", "Home")" class="eg-section-link">
            @(ViewBag.IsArabic == true ? "عرض الكل" : "View All") <i class="ri-arrow-right-line"></i>
        </a>
    </div>

    @if (ViewBag.FabricTypes != null)
    {
        <div class="swiper fabricSwiper">
            <div class="swiper-wrapper">
                @foreach (var type in ViewBag.FabricTypes)
                {
                    <div class="swiper-slide">
                        <a class="eg-fabric-card" href="@Url.Action("CategroySearch", "Home", new { FabricTypeId = type.Id })">
                            <div class="eg-fabric-img">
                                <img src="~/images/@type.ImageUrl" alt="@type.Name" loading="lazy" />
                            </div>
                            <div class="eg-fabric-label">
                                <span>@SharedLocalizer[type.Name]</span>
                                <i class="ri-arrow-right-up-line"></i>
                            </div>
                        </a>
                    </div>
                }
            </div>
            <div class="swiper-button-prev eg-fab-prev"></div>
            <div class="swiper-button-next eg-fab-next"></div>
        </div>
    }
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 6 — SEARCH (repositioned, redesigned)
══════════════════════════════════════════════════════════ *@
<section class="eg-search-section eg-reveal">
    <div class="eg-search-inner-wrap">
        <h2 class="eg-search-title">@SharedLocalizer["Search for the fabric you desire:"]</h2>
        <form class="eg-search-form" action="@Url.Action("CategroySearch", "Home")" method="get" role="search" autocomplete="off">
            <div class="eg-search-box">
                <i class="ri-search-line"></i>
                <input type="text" name="Name"
                       placeholder="@SharedLocalizer["Search for products, categories, colors..."]"
                       aria-label="@SharedLocalizer["Search"]" />
                <button type="submit">
                    <span class="d-none d-md-inline">@SharedLocalizer["Search"]</span>
                    <i class="ri-arrow-right-line d-md-none"></i>
                </button>
            </div>
        </form>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 7 — PROJECT CATEGORIES (icon grid)
══════════════════════════════════════════════════════════ *@
<section class="eg-projects-section eg-reveal container">
    <div class="eg-section-header text-center">
        <h2>@SharedLocalizer["Or start from here"]</h2>
        <p>@SharedLocalizer["What are you making? Choose the fabrics best suited to your project."]</p>
    </div>
    <div class="eg-projects-grid">
        @if (ViewBag.ProjectCategories != null)
        {
            @foreach (var project in ViewBag.ProjectCategories)
            {
                <a href="@Url.Action("CategroySearch", "Home", new { ProjectCategoryId = project.Id })"
                   class="eg-project-card text-decoration-none">
                    <div class="eg-project-icon">
                        <i class="@project.Icon"></i>
                    </div>
                    <span>@SharedLocalizer[project.Name]</span>
                </a>
            }
        }
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 8 — COLOR SHOP (square swatches + labels)
══════════════════════════════════════════════════════════ *@
<section class="eg-colors-section eg-reveal">
    <div class="eg-section-header text-center">
        <h2>@(ViewBag.IsArabic == true ? "تسوق حسب اللون" : "Shop by Color")</h2>
    </div>
    <div class="eg-colors-row container">
        @if (ViewBag.Colors != null)
        {
            @foreach (var color in ViewBag.Colors)
            {
                <a href="@Url.Action("CategroySearch", "Home", new { ColorId = color.Id })"
                   class="eg-color-swatch"
                   style="background:@color.HexCode;"
                   title="@color.Name">
                    <span class="eg-color-label">@color.Name</span>
                </a>
            }
        }
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 9 — TESTIMONIALS (NEW — static)
══════════════════════════════════════════════════════════ *@
<section class="eg-testimonials eg-reveal">
    <div class="eg-section-header text-center">
        <h2>@(ViewBag.IsArabic == true ? "ماذا يقول عملاؤنا" : "What Our Customers Say")</h2>
    </div>
    <div class="eg-testimonials-grid container">
        <div class="eg-testi-card">
            <div class="eg-testi-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
            <p class="eg-testi-quote">"@(ViewBag.IsArabic == true ? "جودة الأقمشة رائعة، وصلت بسرعة والتغليف كان ممتازاً. سأعود للشراء مرة أخرى بالتأكيد." : "Exceptional fabric quality, arrived quickly with excellent packaging. Will definitely shop again.")"</p>
            <div class="eg-testi-author">
                <div class="eg-testi-avatar">ن</div>
                <div>
                    <strong>@(ViewBag.IsArabic == true ? "نورة المنصور" : "Noura M.")</strong>
                    <span>@(ViewBag.IsArabic == true ? "مصممة أزياء" : "Fashion Designer")</span>
                </div>
            </div>
        </div>
        <div class="eg-testi-card">
            <div class="eg-testi-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
            <p class="eg-testi-quote">"@(ViewBag.IsArabic == true ? "تنوع هائل في الألوان والأنواع. الموقع سهل الاستخدام وعملية الطلب سلسة جداً." : "Huge variety in colors and types. The site is easy to use and the ordering process is very smooth.")"</p>
            <div class="eg-testi-author">
                <div class="eg-testi-avatar">م</div>
                <div>
                    <strong>@(ViewBag.IsArabic == true ? "محمد الشريف" : "Mohamed S.")</strong>
                    <span>@(ViewBag.IsArabic == true ? "خياط محترف" : "Professional Tailor")</span>
                </div>
            </div>
        </div>
        <div class="eg-testi-card">
            <div class="eg-testi-stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="far fa-star"></i></div>
            <p class="eg-testi-quote">"@(ViewBag.IsArabic == true ? "طلبت عينات قبل الشراء وكانت التجربة رائعة. الأقمشة تطابق تماماً ما يُعرض على الموقع." : "Ordered samples before buying and the experience was great. Fabrics match exactly what's shown on the site.")"</p>
            <div class="eg-testi-author">
                <div class="eg-testi-avatar">س</div>
                <div>
                    <strong>@(ViewBag.IsArabic == true ? "سارة بدر" : "Sara B.")</strong>
                    <span>@(ViewBag.IsArabic == true ? "مهتمة بالأزياء" : "Fashion Enthusiast")</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 10 — NEWSLETTER CTA STRIP (NEW)
══════════════════════════════════════════════════════════ *@
<section class="eg-newsletter-strip eg-reveal">
    <div class="eg-newsletter-inner container">
        <div class="eg-newsletter-text">
            <h3>@(ViewBag.IsArabic == true ? "اشترك في نشرتنا البريدية" : "Subscribe to our Newsletter")</h3>
            <p>@(ViewBag.IsArabic == true ? "احصل على آخر العروض وتشكيلات الموسم مباشرة في بريدك" : "Get the latest offers and new arrivals delivered to your inbox")</p>
        </div>
        <form class="eg-newsletter-form" action="#" method="post" onsubmit="return false;">
            <input type="email" placeholder="@(ViewBag.IsArabic == true ? "بريدك الإلكتروني" : "Your email address")" required />
            <button type="submit">
                <i class="ri-send-plane-fill me-1"></i>
                @(ViewBag.IsArabic == true ? "اشترك" : "Subscribe")
            </button>
        </form>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   SECTION 11 — SEO CONTENT
══════════════════════════════════════════════════════════ *@
<section class="seo-section eg-reveal">
    <div class="seo-container">
        <h2>@SharedLocalizer["Discover Quality Fabrics for Every Project"]</h2>
        <p>@SharedLocalizer["We provide a carefully curated selection of high-quality fabrics designed to meet the needs of designers, tailors, and fashion enthusiasts.Whether you are creating formal wear, casual clothing, or custom pieces, our platform helps you find the right materials with confidence."]</p>
        <p>@SharedLocalizer["Our fabric collection includes options for dresses, suits, shirts, coats, and lightweight garments, allowing you to choose based on texture, weight, and purpose. Each product is selected with attention to quality, durability, and comfort."]</p>
        <p>@SharedLocalizer["We believe that a great shopping experience should be simple and enjoyable. That's why our platform is designed with intuitive search tools, clear categorization, and a smooth browsing experience across all devices."]</p>
        <p>@SharedLocalizer["From discovering new materials to selecting trusted classics, we aim to support your creative journey by offering reliable products and a seamless online experience."]</p>
    </div>
</section>

@* Recently Viewed strip (populated from localStorage) *@
<section class="container my-5" id="recentlyViewedWrap" style="display:none;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="fw-bold mb-0"><i class="ri-history-line me-2"></i>@SharedLocalizer["Recently Viewed"]</h3>
        <button type="button" class="btn btn-link btn-sm text-muted" onclick="clearRecentlyViewed()">@SharedLocalizer["Clear"]</button>
    </div>
    <div id="recentlyViewedStrip"></div>
</section>

@* ══════════════════════════════════════════════════════════
   PAGE-LEVEL STYLES
══════════════════════════════════════════════════════════ *@
<style>
/* ── Hero ── */
.eg-hero-wrap { position: relative; }
.heroSwiper { width: 100%; height: 600px; }
.eg-slide {
    position: relative; width: 100%; height: 100%;
    background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: flex-start;
    padding: 0 8%;
}
[dir="rtl"] .eg-slide { justify-content: flex-end; }
.eg-slide-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(110deg, rgba(0,59,111,.55) 0%, rgba(0,20,50,.25) 50%, rgba(0,0,0,.05) 100%);
}
.eg-panel {
    position: relative; z-index: 2;
    background: rgba(253,245,230,.93);
    padding: 36px 44px;
    max-width: 500px; width: 100%;
    border-top: 4px solid var(--eg-gold, #D4A017);
    border-bottom: 4px solid var(--eg-gold, #D4A017);
    border-left: 1px solid rgba(212,160,23,.3);
    border-right: 1px solid rgba(212,160,23,.3);
    box-shadow: 0 12px 48px rgba(0,0,0,.2);
    animation-delay: .2s;
}
.eg-glyph { text-align: center; color: var(--eg-gold, #D4A017); font-size: 16px; letter-spacing: 10px; margin: 0 0 12px; opacity: .55; }
.eg-glyph-bot { margin: 12px 0 0; }
.eg-eyebrow { font-family: 'Cairo', sans-serif; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--eg-gold, #D4A017); font-weight: 700; margin: 0 0 12px; }
.eg-panel h1 { font-family: 'Cairo', sans-serif; font-size: 30px; font-weight: 800; line-height: 1.3; color: var(--eg-blue, #003B6F); margin: 0 0 14px; }
.eg-sub { font-family: 'Cairo', sans-serif; font-size: 14px; color: #1A2B3C; opacity: .8; margin: 0 0 22px; line-height: 1.7; }
.eg-cta {
    display: inline-block; padding: 12px 34px;
    background: var(--eg-gold, #D4A017); color: #1A2B3C;
    font-family: 'Cairo', sans-serif; font-weight: 800; letter-spacing: 1.5px;
    text-transform: uppercase; font-size: 12px; text-decoration: none;
    border-radius: 3px; border: 2px solid var(--eg-gold, #D4A017); transition: all .25s;
}
.eg-cta:hover { background: var(--eg-blue, #003B6F); color: #fff; border-color: var(--eg-blue, #003B6F); }
.eg-hero-gold-strip { height: 5px; background: linear-gradient(90deg, var(--eg-blue,#003B6F) 0%, var(--eg-gold,#D4A017) 30%, #E8C547 50%, var(--eg-gold,#D4A017) 70%, var(--eg-blue,#003B6F) 100%); }
.heroSwiper .swiper-button-prev, .heroSwiper .swiper-button-next { color: var(--eg-gold,#D4A017); background: rgba(0,59,111,.65); width: 46px; height: 46px; border-radius: 50%; backdrop-filter: blur(4px); border: 1px solid rgba(212,160,23,.35); }
.heroSwiper .swiper-button-prev:after, .heroSwiper .swiper-button-next:after { font-size: 16px; font-weight: 900; }
.heroSwiper .swiper-pagination-bullet { background: rgba(212,160,23,.6); opacity: 1; }
.heroSwiper .swiper-pagination-bullet-active { background: var(--eg-gold,#D4A017); }
.eg-scroll-hint {
    position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
    z-index: 10; color: #fff; font-size: 28px; opacity: .7;
    animation: eg-bounce 2s infinite; text-decoration: none;
}
@@keyframes eg-bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(6px)} }

/* ── Trust Bar ── */
.eg-trust-bar { background: #fff; border-top: 1px solid rgba(0,59,111,.08); border-bottom: 1px solid rgba(0,59,111,.08); padding: 0; }
.eg-trust-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: stretch; }
.eg-trust-item {
    flex: 1; display: flex; align-items: center; gap: 14px;
    padding: 22px 28px; transition: background .2s;
}
.eg-trust-item:hover { background: rgba(0,59,111,.03); }
.eg-trust-item i { font-size: 30px; color: var(--eg-gold,#D4A017); flex-shrink: 0; }
.eg-trust-item strong { display: block; font-size: 14px; font-weight: 700; color: var(--eg-blue,#003B6F); margin-bottom: 2px; }
.eg-trust-item span { font-size: 12px; color: #888; }
.eg-trust-divider { width: 1px; background: rgba(0,59,111,.08); margin: 14px 0; flex-shrink: 0; }

/* ── Section Headers ── */
.eg-section-header { display: flex; align-items: center; justify-content: space-between; padding: 0 0 24px; flex-wrap: wrap; gap: 8px; }
.eg-section-header.text-center { justify-content: center; flex-direction: column; }
.eg-section-header h2 { font-family: 'Cairo', sans-serif; font-size: 24px; font-weight: 700; color: var(--eg-blue,#003B6F); margin: 0; }
.eg-section-header p { font-size: 14px; color: #888; margin: 4px 0 0; }
.eg-section-link { font-size: 13px; font-weight: 600; color: var(--eg-blue,#003B6F); text-decoration: none; display: flex; align-items: center; gap: 4px; white-space: nowrap; }
.eg-section-link:hover { color: var(--eg-gold,#D4A017); }

/* ── Categories Overlay Tiles ── */
.eg-cat-section { padding: 60px 40px; max-width: 1200px; margin: 0 auto; }
.eg-cat-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; }
.eg-cat-tile {
    position: relative; aspect-ratio: 1/1;
