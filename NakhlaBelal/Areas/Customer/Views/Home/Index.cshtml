}
.eg-offers-btn:hover { background: #E8C547; color: #1A2B3C; transform: translateY(-2px); }
@@keyframes eg-pulse { 0%,100%{box-shadow:0 0 0 0 rgba(212,160,23,.5)} 50%{box-shadow:0 0 0 14px rgba(212,160,23,0)} }
.eg-offers-visual {
    width: 340px; flex-shrink: 0; position: relative;
