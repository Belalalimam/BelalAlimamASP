/* ── Search Section ── */
.eg-search-section { background: linear-gradient(135deg, rgba(0,59,111,.04), rgba(212,160,23,.04)); padding: 60px 24px; }
.eg-search-inner-wrap { max-width: 700px; margin: 0 auto; text-align: center; }
.eg-search-title { font-family: 'Cairo', sans-serif; font-size: 24px; font-weight: 700; color: var(--eg-blue,#003B6F); margin-bottom: 24px; }
.eg-search-form { }
.eg-search-box {
    display: flex; align-items: center;
    background: #fff; border-radius: 50px;
    border: 2px solid rgba(0,59,111,.15);
    box-shadow: 0 6px 24px rgba(0,0,0,.08);
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s;
}
.eg-search-box:focus-within { border-color: var(--eg-blue,#003B6F); box-shadow: 0 8px 28px rgba(0,59,111,.14); }
.eg-search-box i { font-size: 20px; color: #aaa; padding: 0 16px; flex-shrink: 0; }
.eg-search-box input { flex: 1; border: none; outline: none; background: transparent; padding: 16px 0; font-size: 15px; font-family: 'Cairo', sans-serif; min-width: 0; }
.eg-search-box button {
    background: var(--eg-blue,#003B6F); color: #fff;
    border: none; border-radius: 0 50px 50px 0;
    padding: 16px 28px; font-weight: 700; cursor: pointer;
    font-family: 'Cairo', sans-serif; font-size: 14px;
    transition: background .2s; flex-shrink: 0;
}
.eg-search-box button:hover { background: var(--eg-gold,#D4A017); color: #1A2B3C; }

/* ── Project Categories Grid ── */
.eg-projects-section { padding: 60px 24px; }
.eg-projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 16px; margin-top: 32px; }
.eg-project-card { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 20px 12px; background: #fff; border-radius: 12px; border: 2px solid transparent; text-decoration: none; color: var(--eg-blue,#003B6F); transition: all .25s; box-shadow: 0 3px 10px rgba(0,0,0,.05); }
.eg-project-card:hover { border-color: var(--eg-gold,#D4A017); box-shadow: 0 8px 24px rgba(0,59,111,.1); transform: translateY(-3px); color: var(--eg-blue,#003B6F); }
.eg-project-icon { width: 54px; height: 54px; background: rgba(0,59,111,.07); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; transition: background .2s; }
.eg-project-card:hover .eg-project-icon { background: var(--eg-gold,#D4A017); color: #1A2B3C; }
.eg-project-card span { font-size: 12px; font-weight: 600; text-align: center; font-family: 'Cairo', sans-serif; }

/* ── Color Shop ── */
.eg-colors-section { padding: 50px 0; background: rgba(0,59,111,.02); }
.eg-colors-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 0 24px; }
.eg-color-swatch {
    width: 52px; height: 52px; border-radius: 8px;
    border: 2px solid rgba(0,0,0,.1);
    position: relative; overflow: visible;
    transition: transform .2s, box-shadow .2s;
    flex-shrink: 0;
}
.eg-color-swatch:hover { transform: scale(1.2); box-shadow: 0 6px 18px rgba(0,0,0,.2); z-index: 5; }
.eg-color-label {
    position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    background: #1A2B3C; color: #fff; font-size: 10px; font-weight: 600;
    padding: 4px 8px; border-radius: 4px; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity .2s;
}
.eg-color-swatch:hover .eg-color-label { opacity: 1; }

/* ── Testimonials ── */
.eg-testimonials { padding: 70px 0; }
.eg-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.eg-testi-card {
    background: #fff; border-radius: 14px;
    padding: 32px 28px;
    box-shadow: 0 4px 18px rgba(0,0,0,.06);
    border-bottom: 3px solid var(--eg-gold,#D4A017);
    transition: transform .3s, box-shadow .3s;
}
.eg-testi-card:hover { transform: translateY(-5px); box-shadow: 0 14px 36px rgba(0,59,111,.1); }
.eg-testi-stars { color: var(--eg-gold,#D4A017); font-size: 14px; margin-bottom: 16px; display: flex; gap: 3px; }
.eg-testi-quote { font-size: 14px; color: #4a5568; line-height: 1.75; margin: 0 0 20px; font-style: italic; }
.eg-testi-quote::before { content: '\201C'; font-size: 28px; color: var(--eg-gold,#D4A017); line-height: 0; vertical-align: -12px; margin-inline-end: 4px; }
.eg-testi-author { display: flex; align-items: center; gap: 12px; }
.eg-testi-avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--eg-blue,#003B6F); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; flex-shrink: 0; }
.eg-testi-author strong { display: block; font-size: 14px; font-weight: 700; color: var(--eg-blue,#003B6F); }
.eg-testi-author span { font-size: 12px; color: #aaa; }

/* ── Newsletter CTA ── */
.eg-newsletter-strip { background: var(--eg-blue,#003B6F); padding: 50px 0; }
.eg-newsletter-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
.eg-newsletter-text h3 { color: #fff; font-family: 'Cairo', sans-serif; font-size: 22px; font-weight: 700; margin: 0 0 6px; }
.eg-newsletter-text p { color: rgba(255,255,255,.7); font-size: 14px; margin: 0; }
.eg-newsletter-form { display: flex; gap: 10px; flex: 1; min-width: 300px; max-width: 460px; }
.eg-newsletter-form input { flex: 1; padding: 13px 18px; border-radius: 6px; border: none; font-size: 14px; background: rgba(255,255,255,.95); outline: none; font-family: 'Cairo', sans-serif; }
.eg-newsletter-form button { padding: 13px 24px; background: var(--eg-gold,#D4A017); color: #1A2B3C; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all .2s; white-space: nowrap; font-family: 'Cairo', sans-serif; }
.eg-newsletter-form button:hover { background: #E8C547; transform: translateY(-1px); }

/* ── Scroll-reveal base ── */
.eg-reveal { opacity: 0; transform: translateY(30px); transition: opacity .6s ease, transform .6s ease; }
.eg-reveal.is-visible { opacity: 1; transform: translateY(0); }

/* ── Responsive ── */
@@media (max-width: 1199px) { .eg-cat-grid { grid-template-columns: repeat(5, 1fr); } }
@@media (max-width: 991px)  { .eg-cat-grid { grid-template-columns: repeat(4, 1fr); } .eg-testimonials-grid { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 767px) {
    .heroSwiper { height: 520px; }
    .eg-panel { max-width: 100%; padding: 28px 24px; }
    .eg-panel h1 { font-size: 22px; }
    .eg-sub { font-size: 13px; }
    .heroSwiper .swiper-button-prev, .heroSwiper .swiper-button-next { display: none; }
    .eg-trust-inner { flex-direction: column; }
    .eg-trust-divider { width: auto; height: 1px; margin: 0 20px; }
    .eg-cat-section, .eg-fabrics-section { padding: 40px 16px; }
    .eg-cat-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .eg-offers-content { padding: 36px 24px; }
    .eg-offers-content h2 { font-size: 32px; }
    .eg-offers-visual { display: none; }
    .eg-testimonials-grid { grid-template-columns: 1fr; }
    .eg-newsletter-inner { flex-direction: column; align-items: flex-start; }
    .eg-newsletter-form { min-width: 100%; }
}
@@media (max-width: 480px) { .eg-cat-grid { grid-template-columns: repeat(2, 1fr); } }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // Hero slider
        new Swiper('.heroSwiper', {
            loop: true,
            autoplay: { delay: 5500, disableOnInteraction: false },
            speed: 700,
            effect: 'fade',
            fadeEffect: { crossFade: true },
            pagination: { el: '.heroSwiper .swiper-pagination', clickable: true },
            navigation: {
                nextEl: '.heroSwiper .swiper-button-next',
                prevEl: '.heroSwiper .swiper-button-prev'
            }
        });

        // Fabric types carousel
        new Swiper('.fabricSwiper', {
            slidesPerView: 2,
            spaceBetween: 16,
            freeMode: true,
            navigation: { nextEl: '.eg-fab-next', prevEl: '.eg-fab-prev' },
            breakpoints: {
                576:  { slidesPerView: 3 },
                768:  { slidesPerView: 4 },
                1024: { slidesPerView: 5 },
                1200: { slidesPerView: 6 }
            }
        });

        // Scroll-reveal using IntersectionObserver
        const reveals = document.querySelectorAll('.eg-reveal');
        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        reveals.forEach(function(el) { observer.observe(el); });
    });
    </script>
}
