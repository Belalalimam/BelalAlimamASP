    background: linear-gradient(135deg, #E8F0F8, #F5EDDB);
}
.eg-cat-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
.eg-cat-tile-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 42px; color: var(--eg-blue,#003B6F); background: linear-gradient(135deg, #E8F0F8, #F5EDDB); }
.eg-cat-tile-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,27,53,.85) 0%, rgba(0,27,53,.2) 60%, transparent 100%);
