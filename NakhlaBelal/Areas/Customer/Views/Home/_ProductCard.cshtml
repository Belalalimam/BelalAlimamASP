@model Product

<div class="card product-card border-0 shadow-sm h-100 rounded-4 overflow-hidden position-relative">
    <!-- Badges -->
    <div class="position-absolute top-0 start-0 m-3 z-1">
        @if (Model.IsOnSale)
        {
            <span class="badge bg-danger rounded-pill px-2 py-1">
                <small><i class="fas fa-tag me-1"></i>SALE</small>
            </span>
        }
        @if (Model.IsNew)
        {
            <span class="badge bg-success rounded-pill px-2 py-1 mt-1">
                <small><i class="fas fa-star me-1"></i>NEW</small>
            </span>
        }
    </div>

    <!-- Product Image -->
    <div class="position-relative overflow-hidden" style="height: 200px; background: #f8f9fa;">
        <img src="~/images/@Model.MainImage"
             class="img-fluid w-100 h-100 object-fit-cover"
             alt="@Model.Name"
             onerror="this.src='https://via.placeholder.com/300x200?text=Product'">

        <!-- Quick Actions stack (top-end) -->
        <div class="card-actions-stack">
            <button type="button" class="card-action-btn wishlist-btn" data-pid="@Model.Id" onclick="toggleWishlist(@Model.Id, this); return false;" title="Wishlist">
                <i class="far fa-heart"></i>
            </button>
            <button type="button" class="card-action-btn compare-btn" data-pid="@Model.Id" onclick="toggleCompare(@Model.Id, this); return false;" title="Compare">
                <i class="ri-arrow-left-right-line"></i>
            </button>
            <button type="button" class="card-action-btn quickview-btn" onclick="openQuickView(@Model.Id); return false;" title="Quick view">
                <i class="ri-eye-line"></i>
            </button>
            <button type="button" class="card-action-btn sample-btn" onclick="requestSampleQuick(@Model.Id); return false;" title="Request Sample">
                <i class="ri-scissors-cut-line"></i>
            </button>
        </div>
    </div>

    <!-- Product Info -->
    <div class="card-body p-3">
        <!-- Category -->
        <small class="text-muted d-block mb-1">@Model.Category?.Name</small>

        <!-- Name -->
        <h6 class="card-title fw-bold mb-2">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })"
               class="text-decoration-none text-dark">
                @(Model.Name.Length > 50 ? Model.Name.Substring(0, 50) + "..." : Model.Name)
            </a>
        </h6>

        <!-- Rating -->
        <div class="d-flex align-items-center mb-2">
            <div class="rating-stars small">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="@(i <= Math.Floor(Model.AverageRating) ? "fas" : "far") fa-star text-warning"></i>
                }
            </div>
            <small class="text-muted ms-2">(@Model.ReviewCount)</small>
        </div>

        <!-- Price -->
        @{
            var cardUnit = UnitHelper.GetShortLabel(Model.UnitPrice);
        }
        <div class="d-flex align-items-center mb-3">
            @if (Model.IsOnSale)
            {
                <span class="h5 mb-0 fw-bold text-danger">$@Model.FinalPrice.ToString("N2")</span>
                <small class="text-muted ms-1">/ @cardUnit</small>
                <small class="text-muted text-decoration-line-through ms-2">$@Model.Price.ToString("N2")</small>
            }
            else
            {
                <span class="h5 mb-0 fw-bold">$@Model.Price.ToString("N2")</span>
                <small class="text-muted ms-1">/ @cardUnit</small>
            }
        </div>

        <!-- Add to Cart -->
        <div class="d-grid">
            <button class="btn btn-outline-primary btn-sm rounded-pill"
                    onclick="addToCart(@Model.Id, 1)">
                <i class="fas fa-shopping-cart me-2"></i>Add to Cart
            </button>
        </div>
    </div>
</div>

<style>
    .card-actions-stack{position:absolute;top:12px;inset-inline-end:12px;display:flex;flex-direction:column;gap:6px;z-index:2}
    .card-action-btn{width:34px;height:34px;border-radius:50%;border:none;background:rgba(255,255,255,.95);box-shadow:0 2px 6px rgba(0,0,0,.12);display:inline-flex;align-items:center;justify-content:center;color:#013220;transition:.15s;cursor:pointer}
    .card-action-btn:hover{background:#013220;color:#fff;transform:scale(1.08)}
    .card-action-btn.active{background:#e91e63;color:#fff}
    .card-action-btn.active .fa-heart{font-weight:900}
    .card-action-btn.compare-btn.active{background:#013220;color:#ffd700}
</style>
