@model Product
@{
    var cardUnit = UnitHelper.GetShortLabel(Model.UnitPrice);
}

<div class="eg-pcard">

    <div class="eg-pcard-head"></div>

    <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })" class="eg-pcard-imgwrap" tabindex="-1">
        <img src="~/images/@Model.MainImage" alt="@Model.Name"
             onerror="this.src='https://via.placeholder.com/300x240?text=Fabric'" loading="lazy" />

        <div class="eg-pcard-badges">
            @if (Model.IsOnSale) { <span class="eg-badge eg-sale">SALE</span> }
            @if (Model.IsNew)    { <span class="eg-badge eg-new">NEW</span> }
        </div>

        <div class="eg-pcard-actions">
            <button type="button" class="eg-act-btn wishlist-btn" data-pid="@Model.Id"
                    onclick="toggleWishlist(@Model.Id, this); return false;" title="Wishlist">
                <i class="far fa-heart"></i>
            </button>
            <button type="button" class="eg-act-btn compare-btn" data-pid="@Model.Id"
                    onclick="toggleCompare(@Model.Id, this); return false;" title="Compare">
                <i class="ri-arrow-left-right-line"></i>
            </button>
            <button type="button" class="eg-act-btn quickview-btn"
                    onclick="openQuickView(@Model.Id); return false;" title="Quick view">
                <i class="ri-eye-line"></i>
            </button>
            <button type="button" class="eg-act-btn sample-btn"
                    onclick="requestSampleQuick(@Model.Id); return false;" title="Sample">
                <i class="ri-scissors-cut-line"></i>
            </button>
        </div>
    </a>

    <div class="eg-pcard-body">
        <p class="eg-pcard-cat">@Model.Category?.Name</p>
        <h3 class="eg-pcard-name">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })">
                @(Model.Name.Length > 46 ? Model.Name.Substring(0, 46) + "…" : Model.Name)
            </a>
        </h3>

        <div class="eg-pcard-stars">
            @for (int i = 1; i <= 5; i++)
            {
                <i class="@(i <= Math.Floor(Model.AverageRating) ? "fas" : "far") fa-star"></i>
            }
            <span>(@Model.ReviewCount)</span>
        </div>

        <div class="eg-pcard-foot">
            <div>
                @if (Model.IsOnSale)
                {
                    <span class="eg-price-sale">$@Model.FinalPrice.ToString("N2")</span>
                    <span class="eg-price-old">$@Model.Price.ToString("N2")</span>
                }
                else
                {
                    <span class="eg-price">$@Model.Price.ToString("N2")</span>
                }
                <span class="eg-unit">/ @cardUnit</span>
            </div>
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })"
               class="eg-view-btn">عرض</a>
        </div>
    </div>

</div>

<style>
/* ── Egypt Product Card ── */
.eg-pcard {
    display: flex; flex-direction: column;
    background: #FDF5E6;
    border: 1px solid rgba(212,160,23,.2);
    border-radius: 2px; overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease;
}
.eg-pcard:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 38px rgba(0,59,111,.14);
}

/* Blue Nile header stripe */
.eg-pcard-head {
    height: 4px;
    background: linear-gradient(90deg, #003B6F 0%, #0055A4 50%, #003B6F 100%);
    flex-shrink: 0;
}

/* Image */
.eg-pcard-imgwrap {
    position: relative; display: block;
    overflow: hidden; aspect-ratio: 4 / 3; background: #F0E0BA;
    text-decoration: none;
}
.eg-pcard-imgwrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .45s ease;
}
.eg-pcard:hover .eg-pcard-imgwrap img { transform: scale(1.05); }

/* Badges */
.eg-pcard-badges {
    position: absolute; top: 8px; inset-inline-start: 8px;
    display: flex; flex-direction: column; gap: 3px; z-index: 2;
}
.eg-badge { font-size: 9px; font-weight: 800; letter-spacing: 1px; padding: 3px 8px; border-radius: 2px; text-transform: uppercase; }
.eg-sale { background: #D4A017; color: #1A2B3C; }
.eg-new  { background: #003B6F; color: #fff; }

/* Action buttons — fade in over image */
.eg-pcard-actions {
    position: absolute; top: 8px; inset-inline-end: 8px;
    display: flex; flex-direction: column; gap: 5px; z-index: 3;
    opacity: 0; transition: opacity .25s ease;
}
.eg-pcard:hover .eg-pcard-actions { opacity: 1; }

.eg-act-btn {
    width: 32px; height: 32px; border-radius: 4px; border: none;
    background: rgba(253,245,230,.95); color: #003B6F;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 14px; cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,.14);
    transition: background .15s, color .15s;
}
.eg-act-btn:hover { background: #D4A017; color: #1A2B3C; }
.eg-act-btn.active { background: #D4A017; color: #1A2B3C; }
.eg-act-btn.compare-btn.active { background: #003B6F; color: #D4A017; }

/* Body */
.eg-pcard-body { padding: 12px 14px 14px; background: #FDF5E6; }
.eg-pcard-cat { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #B8860B; margin: 0 0 4px; }
.eg-pcard-name {
    font-family: 'Cairo', sans-serif;
    font-size: 14px; font-weight: 700; margin: 0 0 6px; line-height: 1.4;
}
.eg-pcard-name a { color: #1A2B3C; text-decoration: none; }
.eg-pcard-name a:hover { color: #003B6F; }

.eg-pcard-stars { color: #D4A017; font-size: 11px; margin-bottom: 8px; display: flex; align-items: center; gap: 3px; }
.eg-pcard-stars span { color: #888; font-size: 10px; }

.eg-pcard-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.eg-price, .eg-price-sale { font-size: 15px; font-weight: 700; color: #003B6F; font-family: 'Cairo', sans-serif; }
.eg-price-old { font-size: 11px; color: #bbb; text-decoration: line-through; }
.eg-unit { font-size: 11px; color: #B8860B; }

.eg-view-btn {
    padding: 6px 14px; background: #003B6F; color: #fff;
    font-family: 'Cairo', sans-serif; font-size: 12px; font-weight: 700;
    text-decoration: none; border-radius: 3px; border: 2px solid #003B6F;
    transition: background .2s, color .2s; white-space: nowrap; flex-shrink: 0;
}
.eg-view-btn:hover { background: #D4A017; color: #1A2B3C; border-color: #D4A017; }
</style>
