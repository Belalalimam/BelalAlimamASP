@model Product
@{
    var cardUnit = UnitHelper.GetShortLabel(Model.UnitPrice);
}

<div class="mg-pcard">

    <div class="mg-pcard-top">
        <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })" class="mg-pcard-imgwrap" tabindex="-1">
            <img src="~/images/@Model.MainImage" alt="@Model.Name"
                 onerror="this.src='https://via.placeholder.com/300x300?text=Fabric'" loading="lazy" />
            <div class="mg-pcard-badges">
                @if (Model.IsOnSale) { <span class="mg-badge mg-sale">SALE</span> }
                @if (Model.IsNew)    { <span class="mg-badge mg-new">NEW</span> }
            </div>
        </a>

        <div class="mg-pcard-actions">
            <button type="button" class="mg-act-btn wishlist-btn" data-pid="@Model.Id"
                    onclick="toggleWishlist(@Model.Id, this); return false;" title="Wishlist">
                <i class="far fa-heart"></i>
            </button>
            <button type="button" class="mg-act-btn compare-btn" data-pid="@Model.Id"
                    onclick="toggleCompare(@Model.Id, this); return false;" title="Compare">
                <i class="ri-arrow-left-right-line"></i>
            </button>
            <button type="button" class="mg-act-btn quickview-btn"
                    onclick="openQuickView(@Model.Id); return false;" title="Quick view">
                <i class="ri-eye-line"></i>
            </button>
            <button type="button" class="mg-act-btn sample-btn"
                    onclick="requestSampleQuick(@Model.Id); return false;" title="Sample">
                <i class="ri-scissors-cut-line"></i>
            </button>
        </div>
    </div>

    <div class="mg-pcard-stripe"></div>

    <div class="mg-pcard-body">
        <p class="mg-pcard-cat">@Model.Category?.Name</p>
        <h3 class="mg-pcard-name">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })">
                @(Model.Name.Length > 46 ? Model.Name.Substring(0, 46) + "…" : Model.Name)
            </a>
        </h3>
        <div class="mg-pcard-foot">
            <div class="mg-pcard-price">
                @if (Model.IsOnSale)
                {
                    <span class="mg-price-sale">$@Model.FinalPrice.ToString("N2")</span>
                    <span class="mg-price-old">$@Model.Price.ToString("N2")</span>
                }
                else
                {
                    <span class="mg-price">$@Model.Price.ToString("N2")</span>
                }
                <span class="mg-unit">/ @cardUnit</span>
            </div>
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })"
               class="mg-pcard-arrow" title="View">
                <i class="ri-arrow-right-line"></i>
            </a>
        </div>
    </div>

</div>

<style>
.mg-pcard {
    display: flex; flex-direction: column;
    background: #FFF8F0;
    border: 1px solid rgba(193,39,45,.12);
    border-radius: 4px; overflow: hidden;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
}
.mg-pcard:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 36px rgba(122,18,24,.13);
    border-color: rgba(193,39,45,.35);
}
.mg-pcard-top { position: relative; }
.mg-pcard-imgwrap {
    display: block; overflow: hidden;
    aspect-ratio: 1 / 1; background: #F2E4D4; text-decoration: none;
}
.mg-pcard-imgwrap img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .45s ease;
}
.mg-pcard:hover .mg-pcard-imgwrap img { transform: scale(1.06); }

.mg-pcard-badges {
    position: absolute; top: 8px; inset-inline-start: 8px;
    display: flex; flex-direction: column; gap: 3px; z-index: 2;
}
.mg-badge { font-size: 9px; font-weight: 800; letter-spacing: 1px; padding: 3px 8px; text-transform: uppercase; border-radius: 2px; }
.mg-sale { background: #C1272D; color: #fff; }
.mg-new  { background: #1B4F8A; color: #fff; }

/* Horizontal action bar slides up on hover */
.mg-pcard-actions {
    position: absolute; bottom: 0; inset-inline-start: 0; inset-inline-end: 0;
    display: flex; justify-content: center; gap: 2px;
    background: rgba(122,18,24,.88); padding: 8px 0;
    transform: translateY(100%); transition: transform .28s ease; z-index: 3;
}
.mg-pcard:hover .mg-pcard-actions { transform: translateY(0); }

.mg-act-btn {
    width: 36px; height: 36px; border-radius: 50%; border: none;
    background: rgba(255,248,240,.9); color: #7A1218;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 15px; cursor: pointer; transition: background .15s, color .15s;
}
.mg-act-btn:hover { background: #C9A000; color: #2D1B1B; }
.mg-act-btn.active { background: #C9A000; color: #2D1B1B; }
.mg-act-btn.compare-btn.active { background: #C1272D; color: #fff; }

/* Mosaic stripe between image and body */
.mg-pcard-stripe {
    height: 4px;
    background: repeating-linear-gradient(90deg, #C1272D 0px, #C1272D 14px, #C9A000 14px, #C9A000 28px, #1B4F8A 28px, #1B4F8A 42px);
}

.mg-pcard-body { padding: 12px 14px 14px; background: #FFF8F0; }
.mg-pcard-cat { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #CC5500; margin: 0 0 4px; }
.mg-pcard-name { font-family: 'Amiri', serif; font-size: 15px; font-weight: 700; margin: 0 0 10px; line-height: 1.4; }
.mg-pcard-name a { color: #2D1B1B; text-decoration: none; }
.mg-pcard-name a:hover { color: #C1272D; }

.mg-pcard-foot { display: flex; align-items: center; justify-content: space-between; }
.mg-pcard-price { display: flex; align-items: baseline; gap: 5px; }
.mg-price, .mg-price-sale { font-size: 15px; font-weight: 700; color: #7A1218; }
.mg-price-old { font-size: 11px; color: #bbb; text-decoration: line-through; }
.mg-unit { font-size: 11px; color: #CC5500; }

.mg-pcard-arrow {
    width: 30px; height: 30px; border-radius: 50%;
    background: #C1272D; color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; text-decoration: none; flex-shrink: 0;
    transition: background .2s, transform .2s;
}
.mg-pcard-arrow:hover { background: #C9A000; color: #2D1B1B; transform: scale(1.1); }
</style>
