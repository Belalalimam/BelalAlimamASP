@model Product
@{
    var cardUnit = UnitHelper.GetShortLabel(Model.UnitPrice);
}

{{!-- ═══════════════════════════════════
     SAUDI CARD — portrait فاخر + overlay ذهبي
     ═══════════════════════════════════ --}}
<div class="sa-pcard">

    <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })" class="sa-pcard-imgwrap" tabindex="-1">
        <img src="~/images/@Model.MainImage" alt="@Model.Name"
             onerror="this.src='https://via.placeholder.com/300x400?text=Fabric'" loading="lazy" />

        <div class="sa-pcard-overlay">
            <span class="sa-pcard-view-btn">View Details</span>
        </div>

        <div class="sa-pcard-badges">
            @if (Model.IsOnSale) { <span class="sa-badge sa-sale">SALE</span> }
            @if (Model.IsNew)    { <span class="sa-badge sa-new">NEW</span>  }
        </div>
    </a>

    <div class="sa-pcard-actions">
        <button type="button" class="sa-act-btn wishlist-btn" data-pid="@Model.Id"
                onclick="toggleWishlist(@Model.Id, this); return false;" title="Wishlist">
            <i class="far fa-heart"></i>
        </button>
        <button type="button" class="sa-act-btn compare-btn" data-pid="@Model.Id"
                onclick="toggleCompare(@Model.Id, this); return false;" title="Compare">
            <i class="ri-arrow-left-right-line"></i>
        </button>
        <button type="button" class="sa-act-btn quickview-btn"
                onclick="openQuickView(@Model.Id); return false;" title="Quick view">
            <i class="ri-eye-line"></i>
        </button>
        <button type="button" class="sa-act-btn sample-btn"
                onclick="requestSampleQuick(@Model.Id); return false;" title="Sample">
            <i class="ri-scissors-cut-line"></i>
        </button>
    </div>

    <div class="sa-pcard-body">
        <p class="sa-pcard-cat">@Model.Category?.Name</p>
        <h3 class="sa-pcard-name">
            <a href="@Url.Action("Details", "Home", new { id = Model.Id, area = "Customer" })">
                @(Model.Name.Length > 46 ? Model.Name.Substring(0, 46) + "…" : Model.Name)
            </a>
        </h3>
        <div class="sa-pcard-rule"></div>
        <div class="sa-pcard-foot">
            @if (Model.IsOnSale)
            {
                <span class="sa-price-sale">$@Model.FinalPrice.ToString("N2")</span>
                <span class="sa-price-old">$@Model.Price.ToString("N2")</span>
            }
            else
            {
                <span class="sa-price">$@Model.Price.ToString("N2")</span>
            }
            <span class="sa-unit">/ @cardUnit</span>
        </div>
    </div>

</div>

<style>
/* ── Saudi Product Card ── */
.sa-pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #FDFAF3;
    transition: transform .32s ease, box-shadow .32s ease;
}
.sa-pcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 42px rgba(0,61,31,.13);
}

/* Image */
.sa-pcard-imgwrap {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #F0EBD8;
    text-decoration: none;
}
.sa-pcard-imgwrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
}
.sa-pcard:hover .sa-pcard-imgwrap img { transform: scale(1.07); }

/* Gold overlay on hover */
.sa-pcard-overlay {
    position: absolute; inset: 0;
    background: rgba(0,61,31,.52);
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: opacity .3s ease;
}
.sa-pcard:hover .sa-pcard-overlay { opacity: 1; }

.sa-pcard-view-btn {
    padding: 11px 30px;
    background: #C9A84C; color: #003D1F;
    font-weight: 700; font-size: 12px;
    letter-spacing: 2px; text-transform: uppercase;
    border: 2px solid #C9A84C;
    transition: all .2s; cursor: pointer;
}
.sa-pcard-view-btn:hover { background: transparent; color: #C9A84C; }

/* Badges */
.sa-pcard-badges {
    position: absolute; top: 10px; inset-inline-start: 10px;
    display: flex; flex-direction: column; gap: 4px; z-index: 2;
}
.sa-badge {
    font-size: 9px; font-weight: 800; letter-spacing: 1.5px;
    padding: 4px 10px; text-transform: uppercase;
}
.sa-sale { background: #C9A84C; color: #003D1F; }
.sa-new  { background: #003D1F; color: #C9A84C; }

/* Action buttons — slide in from side */
.sa-pcard-actions {
    position: absolute; top: 10px; inset-inline-end: 10px;
    display: flex; flex-direction: column; gap: 6px; z-index: 3;
    opacity: 0; transform: translateX(10px);
    transition: opacity .25s ease, transform .25s ease;
}
[dir="rtl"] .sa-pcard-actions { transform: translateX(-10px); }
.sa-pcard:hover .sa-pcard-actions { opacity: 1; transform: translateX(0); }

.sa-act-btn {
    width: 34px; height: 34px; border-radius: 0;
    border: 1px solid rgba(201,168,76,.4);
    background: rgba(253,250,243,.96); color: #003D1F;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 14px; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.1);
    transition: background .15s, color .15s, border-color .15s;
}
.sa-act-btn:hover { background: #C9A84C; color: #003D1F; border-color: #C9A84C; }
.sa-act-btn.active { background: #C9A84C; color: #003D1F; }
.sa-act-btn.compare-btn.active { background: #003D1F; color: #C9A84C; }

/* Card body */
.sa-pcard-body {
    padding: 13px 12px 15px;
    border-bottom: 3px solid #C9A84C;
}
.sa-pcard-cat {
    font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase;
    color: #8B7B4A; margin: 0 0 5px;
}
.sa-pcard-name {
    font-family: 'Playfair Display', serif;
    font-size: 14px; font-weight: 600;
    margin: 0 0 10px; line-height: 1.35;
}
.sa-pcard-name a { color: #1A1A1A; text-decoration: none; }
.sa-pcard-name a:hover { color: #003D1F; }

.sa-pcard-rule {
    height: 1px; margin-bottom: 10px;
    background: linear-gradient(to right, #C9A84C 30%, transparent 100%);
    opacity: .5;
}
.sa-pcard-foot {
    display: flex; align-items: baseline; gap: 5px; flex-wrap: wrap;
}
.sa-price, .sa-price-sale {
    font-size: 15px; font-weight: 700; color: #003D1F;
}
.sa-price-old {
    font-size: 12px; color: #bbb; text-decoration: line-through;
}
.sa-unit { font-size: 11px; color: #8B7B4A; }
</style>
