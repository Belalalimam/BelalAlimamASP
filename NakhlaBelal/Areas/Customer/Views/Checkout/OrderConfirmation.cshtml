@model NakhlaBelal.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">

            <div class="eg-success-icon">
                <i class="ri-check-line"></i>
            </div>

            <h1 class="display-4 fw-bold mb-3">@SharedLocalizer["THANK YOU!"]</h1>
            <p class="lead mb-5">
                @SharedLocalizer["We have successfully received your order. One of our team members will review your information and get back to you within the next 48 hours."]
            </p>

            <div class="eg-success-summary">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="label">@SharedLocalizer["Order Number:"]</div>
                        <div class="value">#@Model.OrderNumber</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="label">@SharedLocalizer["Order Date:"]</div>
                        <div class="value">@Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="label">@SharedLocalizer["Payment Method:"]</div>
                        <div class="value">@Model.PaymentMethod</div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-area="Customer" asp-controller="Tracking" asp-action="Index" asp-route-orderNumber="@Model.OrderNumber"
                   class="btn btn-lg px-5 py-3 eg-btn-primary">
                    <i class="ri-map-pin-line me-2"></i> @SharedLocalizer["TrackOrder"]
                </a>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                   class="btn btn-lg px-5 py-3 eg-btn-outline">
                    @SharedLocalizer["Continue Shopping"]
                </a>
                <button onclick="window.print()" class="btn btn-lg px-4 py-3 eg-btn-ghost">
                    <i class="ri-printer-line me-2"></i> @SharedLocalizer["PRINT RECEIPT"]
                </button>
            </div>

        </div>
    </div>
</div>

<style>
body { background-color: #F4F0E8; }
.display-4 { color: #1A2B3C; font-family:'Cairo',sans-serif; }
.lead { color: #555; }

/* Egypt success icon */
.eg-success-icon {
    width: 90px; height: 90px;
    background: #003B6F;
    border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 44px;
    box-shadow: 0 8px 28px rgba(0,59,111,.3);
    margin-bottom: 24px;
    animation: eg-popIn .5s cubic-bezier(.34,1.56,.64,1);
}
@@keyframes eg-popIn { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }

/* Summary card */
.eg-success-summary {
    background: #fff;
    border: 1px solid rgba(212,160,23,.2);
    border-radius: 12px;
    padding: 24px 32px;
    box-shadow: 0 4px 18px rgba(0,59,111,.07);
    margin-bottom: 32px;
    text-align: left;
}
.eg-success-summary .label { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#B8860B; }
.eg-success-summary .value { font-size:16px; font-weight:700; color:#1A2B3C; font-family:'Cairo',sans-serif; margin-top:4px; }

/* Buttons */
.eg-btn-primary {
    background: #003B6F !important; border: none !important; color: #fff !important;
    border-radius: 8px !important; font-weight: 800 !important;
    font-family: 'Cairo', sans-serif !important;
    transition: all .25s !important; letter-spacing: 1px;
    box-shadow: 0 4px 14px rgba(0,59,111,.25) !important;
}
.eg-btn-primary:hover { background: #D4A017 !important; color: #1A2B3C !important; transform: translateY(-2px) !important; }
.eg-btn-outline {
    background: transparent !important; border: 2px solid #003B6F !important; color: #003B6F !important;
    border-radius: 8px !important; font-weight: 700 !important; font-family: 'Cairo', sans-serif !important;
    transition: all .25s !important;
}
.eg-btn-outline:hover { background: #003B6F !important; color: #fff !important; }
.eg-btn-ghost {
    background: #fff !important; border: 1px solid #ddd !important; color: #555 !important;
    border-radius: 8px !important; font-weight: 600 !important; transition: all .25s !important;
}
.eg-btn-ghost:hover { border-color: #003B6F !important; color: #003B6F !important; }
</style>
