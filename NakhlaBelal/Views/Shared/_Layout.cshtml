@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject ISiteSettingsService SiteSettings
@{
    // الحصول على اللغة الحالية
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var cultureItems = LocOptions.Value.SupportedUICultures
        .Select(c => new SelectListItem { Value = c.Name, Text = c.DisplayName })
        .ToList();
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
    var isArabic = requestCulture?.RequestCulture.UICulture.Name == "ar";
    var siteSettings = SiteSettings.Get();
    var siteDisplayName = isArabic ? siteSettings.SiteNameArabic : siteSettings.SiteName;

    // WhatsApp URL — تنظيف الرقم من المسافات والرموز
    var whatsappDigits = new string((siteSettings.WhatsAppNumber ?? "").Where(char.IsDigit).ToArray());
    var whatsappUrl = $"https://wa.me/{whatsappDigits}";
}
