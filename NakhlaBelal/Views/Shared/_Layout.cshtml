    <!-- ============ Nakhla Features JS (wishlist/compare/quick-view/sample/recently-viewed) ============ -->
    <script>
        (function(){
            const IS_AUTH = "@User.Identity.IsAuthenticated" === "True";
            const RV_KEY = 'recentlyViewedIds';
            const CMP_KEY = 'compareIds';
            const MAX_RV = 12;
            const MAX_CMP = 4;

            function getAfToken(){
                const t = document.querySelector('#__afForm input[name="__RequestVerificationToken"]')
                       || document.querySelector('input[name="__RequestVerificationToken"]');
                return t ? t.value : '';
            }

            function readList(k){ try { return JSON.parse(localStorage.getItem(k) || '[]'); } catch(e){ return []; } }
            function writeList(k,v){ localStorage.setItem(k, JSON.stringify(v)); }

            // ---------- Wishlist ----------
            window.toggleWishlist = function(id, btn){
                if (!IS_AUTH){
                    Swal.fire({ icon:'info', title:'@(isArabic ? "سجّل دخولك أولاً" : "Please log in")',
                                text:'@(isArabic ? "يلزمك تسجيل الدخول لاستخدام قائمة المفضلات." : "Log in to save items to your wishlist.")',
                                confirmButtonColor:'#013220' });
                    return;
                }
                fetch('/Customer/Wishlist/Toggle', {
                    method:'POST',
                    headers:{ 'Content-Type':'application/x-www-form-urlencoded', 'RequestVerificationToken': getAfToken() },
                    body: 'productId=' + encodeURIComponent(id)
                })
                .then(r => r.json())
                .then(d => {
                    if (!d || !d.ok) return;
                    const icon = btn && btn.querySelector('i');
                    if (icon){
                        if (d.added){ icon.classList.remove('far'); icon.classList.add('fas'); btn.classList.add('active'); }
                        else { icon.classList.remove('fas'); icon.classList.add('far'); btn.classList.remove('active'); }
                    }
                    updateWishlistBadge(d.count);
                    if (window.toastr) toastr[d.added?'success':'info'](d.added ? '@(isArabic ? "أُضيف إلى المفضلات" : "Added to wishlist")' : '@(isArabic ? "أُزيل من المفضلات" : "Removed from wishlist")');
                });
            };

            function updateWishlistBadge(n){
                ['wishlistBadgeDesktop','wishlistBadgeMobile'].forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.textContent = n;
                    if (n > 0) el.classList.remove('d-none'); else el.classList.add('d-none');
                });
                ['wishlistBadgeAccount','wishlistBadgeAccountMobile'].forEach(aid => {
                    const acc = document.getElementById(aid);
                    if (!acc) return;
                    acc.textContent = n;
                    acc.setAttribute('data-empty', n > 0 ? '0' : '1');
                    if (n > 0) acc.classList.remove('d-none'); else acc.classList.add('d-none');
                });
            }

            function loadWishlistIds(){
                if (!IS_AUTH) return;
                fetch('/Customer/Wishlist/MyIds').then(r => r.json()).then(ids => {
                    if (!Array.isArray(ids)) return;
                    ids.forEach(id => {
                        document.querySelectorAll('.wishlist-btn[data-pid="'+id+'"]').forEach(btn => {
                            btn.classList.add('active');
                            const i = btn.querySelector('i'); if (i){ i.classList.remove('far'); i.classList.add('fas'); }
                        });
                    });
                    updateWishlistBadge(ids.length);
                }).catch(()=>{});
            }

            // ---------- Compare ----------
            window.toggleCompare = function(id, btn){
                let ids = readList(CMP_KEY);
                const existing = ids.indexOf(id);
                if (existing >= 0){
                    ids.splice(existing, 1);
                    btn && btn.classList.remove('active');
                } else {
                    if (ids.length >= MAX_CMP){
                        Swal.fire({ icon:'warning', title:'@(isArabic ? "الحد 4 منتجات" : "Max 4 products")',
                                    text:'@(isArabic ? "احذف واحدًا لإضافة آخر." : "Remove one to add another.")',
                                    confirmButtonColor:'#013220' });
                        return;
                    }
                    ids.push(id);
                    btn && btn.classList.add('active');
                }
                writeList(CMP_KEY, ids);
                renderCompareBar();
            };

            window.clearAllCompare = function(){ writeList(CMP_KEY, []); renderCompareBar(); document.querySelectorAll('.compare-btn.active').forEach(b => b.classList.remove('active')); };

            function renderCompareBar(){
                const ids = readList(CMP_KEY);
                const bar = document.getElementById('compareBar');
                const wrap = document.getElementById('compareBarItems');
                const go = document.getElementById('compareBarGo');
                ['compareBadgeDesktop','compareBadgeMobile'].forEach(bid => {
                    const el = document.getElementById(bid);
                    if (!el) return;
                    el.textContent = ids.length;
                    if (ids.length > 0) el.classList.remove('d-none'); else el.classList.add('d-none');
                });
                ['compareBadgeAccount','compareBadgeAccountMobile'].forEach(aid => {
                    const accCmp = document.getElementById(aid);
                    if (!accCmp) return;
                    accCmp.textContent = ids.length;
                    accCmp.setAttribute('data-empty', ids.length > 0 ? '0' : '1');
                    if (ids.length > 0) accCmp.classList.remove('d-none'); else accCmp.classList.add('d-none');
                });
                if (!bar || !wrap) return;
                if (ids.length === 0){ bar.style.display='none'; return; }
                bar.style.display='block';
                go.setAttribute('href','/Customer/Compare/Index?ids=' + ids.join(','));
                // fetch thumbnails via mini strip endpoint
                fetch('/Customer/Home/GetProductsByIds?ids=' + ids.join(','))
                    .then(r => r.text())
                    .then(html => {
                        // Parse out the mps cards as thumbs
                        const tmp = document.createElement('div'); tmp.innerHTML = html;
                        wrap.innerHTML = '';
                        tmp.querySelectorAll('.mps-card').forEach((a,i) => {
                            const img = a.querySelector('img')?.getAttribute('src') || '';
                            const pid = ids[i];
                            const cbi = document.createElement('div');
                            cbi.className = 'cbi';
                            cbi.innerHTML = '<img src="'+img+'" /><button title="remove" onclick="toggleCompare('+pid+')">×</button>';
                            wrap.appendChild(cbi);
                        });
                    });
            }

            function applyCompareActiveStates(){
                const ids = readList(CMP_KEY);
                ids.forEach(id => {
                    document.querySelectorAll('.compare-btn[data-pid="'+id+'"]').forEach(b => b.classList.add('active'));
                });
            }

            // ---------- Quick View ----------
            window.openQuickView = function(id){
                const body = document.getElementById('quickViewBody');
                if (body) body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-success"></div></div>';
                const modalEl = document.getElementById('quickViewModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                fetch('/Customer/Home/QuickView?id=' + id)
                    .then(r => r.text())
                    .then(html => { body.innerHTML = html; })
                    .catch(() => { body.innerHTML = '<div class="text-center text-danger py-4">@(isArabic ? "حدث خطأ" : "Error loading")</div>'; });
            };

            // ---------- Request Sample (one-click) ----------
            window.requestSampleQuick = function(id){
                Swal.fire({
                    title:'@(isArabic ? "طلب عيّنة" : "Request Sample")',
                    text:'@(isArabic ? "هل تريد طلب عيّنة من هذا القماش؟" : "Request a sample of this fabric?")',
                    icon:'question', showCancelButton:true,
                    confirmButtonText:'@(isArabic ? "نعم، أكمل الطلب" : "Yes, continue")',
                    cancelButtonText:'@(isArabic ? "إلغاء" : "Cancel")',
                    confirmButtonColor:'#013220'
                }).then(r => {
                    if (r.isConfirmed){
                        // Take user to the sample form pre-filled with this product
                        location.href = '/Customer/Order/RequestSample?productId=' + id;
                    }
                });
            };

            // ---------- Recently Viewed ----------
            function trackRecentlyViewed(){
                const el = document.querySelector('[data-track-product-id]');
                if (!el) return;
                const pid = parseInt(el.getAttribute('data-track-product-id'));
                if (!pid) return;
                let list = readList(RV_KEY).filter(x => x !== pid);
                list.unshift(pid);
                if (list.length > MAX_RV) list = list.slice(0, MAX_RV);
                writeList(RV_KEY, list);
            }

            function renderRecentlyViewed(){
                const wrap = document.getElementById('recentlyViewedWrap');
                const strip = document.getElementById('recentlyViewedStrip');
                if (!wrap || !strip) return;
                const currentId = parseInt(document.querySelector('[data-track-product-id]')?.getAttribute('data-track-product-id') || '0');
                const ids = readList(RV_KEY).filter(x => x !== currentId);
                if (ids.length === 0){ wrap.style.display='none'; return; }
                fetch('/Customer/Home/GetProductsByIds?ids=' + ids.join(','))
                    .then(r => r.text()).then(html => { strip.innerHTML = html; wrap.style.display=''; })
                    .catch(() => {});
            }

            window.clearRecentlyViewed = function(){
                localStorage.removeItem(RV_KEY);
                const wrap = document.getElementById('recentlyViewedWrap');
                if (wrap) wrap.style.display='none';
            };

            // ---------- Boot ----------
            document.addEventListener('DOMContentLoaded', function(){
                try { trackRecentlyViewed(); } catch(e){}
                try { renderRecentlyViewed(); } catch(e){}
                try { renderCompareBar(); applyCompareActiveStates(); } catch(e){}
                try { loadWishlistIds(); } catch(e){}
            });
        })();
    </script>

    <!-- Custom JS -->
    <script>

            // Highlight current page in navigation
            document.addEventListener('DOMContentLoaded', function() {
                const currentPath = window.location.pathname.toLowerCase();

                // Check main navigation
                document.querySelectorAll('.nav-link-custom').forEach(link => {
                    const href = link.getAttribute('href').toLowerCase();
                    if (currentPath.includes(href.split('/').pop())) {
                        link.style.color = 'var(--accent-color)';
                        link.style.fontWeight = '600';
                    }
                });

                // Check footer navigation
                document.querySelectorAll('.nav-list a').forEach(link => {
                    const href = link.getAttribute('href').toLowerCase();
                    if (currentPath.includes(href.split('/').pop())) {
                        link.style.color = 'var(--primary-color)';
                        link.style.fontWeight = '600';
                    }
                });
            });



            // للكارت 
            document.addEventListener('DOMContentLoaded', function() {
                // نتحقق إذا كان المستخدم مسجل دخول
                if ("@User.Identity.IsAuthenticated" === "True") {
                    updateCartCount();
                }

                function updateCartCount() {
                    fetch('/Customer/Cart/GetCartCount')
                        .then(response => response.json())
                        .then(data => {
                            ['cartBadge','cartBadgeMobile'].forEach(id => {
                                const badge = document.getElementById(id);
                                if (!badge) return;
                                badge.textContent = data.count;
                                if (data.count > 0) badge.classList.remove('d-none');
                                else badge.classList.add('d-none');
                            });
                        })
                        .catch(error => console.error('Error fetching cart count:', error));
                }
            });



    </script>
    


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-element-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>

    @* <script src="~/js/Navbar.js" asp-append-version="true"></script>
    <script src="~/js/newFile.js"></script> *@
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
</body>
</html>
