    <style>
        /* ============ Newsletter Strip ============ */
        .newsletter-strip {
            background: linear-gradient(135deg, #013220 0%, #025939 100%);
            color: #fff;
            padding: 40px 0;
            margin-top: 40px;
        }
        .newsletter-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }
        .newsletter-text h3 { margin: 0 0 6px; font-size: 22px; font-weight: 700; }
        .newsletter-text p { margin: 0; opacity: 0.9; font-size: 14px; }
        .newsletter-form {
            display: flex;
            gap: 8px;
            min-width: 360px;
            flex: 1;
            max-width: 500px;
        }
        .newsletter-form input {
            flex: 1;
            padding: 13px 18px;
            border-radius: 8px;
            border: none;
            font-size: 14px;
            background: rgba(255,255,255,0.95);
        }
        .newsletter-form button {
            padding: 13px 24px;
            background: #ffd700;
            color: #013220;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .newsletter-form button:hover { background: #ffeb3b; transform: translateY(-1px); }

        /* ============ Footer Nav ============ */
        .footer-nav {
            background: #0f1f16;
            color: #cbd5d1;
            padding: 60px 0 30px;
        }
        .footer-nav .nav-title {
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            margin: 0 0 18px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .footer-nav .nav-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .footer-nav .nav-list li { margin-bottom: 10px; }
        .footer-nav .nav-list a {
            color: #9ca9a4;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s;
        }
        .footer-nav .nav-list a:hover { color: #ffd700; padding-inline-start: 4px; }

        .footer-brand-col { padding-inline-end: 20px; }
        .footer-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }
        .footer-logo {
            width: 48px; height: 48px;
            border-radius: 10px;
            object-fit: cover;
            background: #fff;
        }
        .footer-brand-name {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
            margin: 0;
        }
        .footer-tagline {
            color: #9ca9a4;
            font-size: 14px;
            line-height: 1.6;
            margin: 0 0 20px;
        }

        .footer-contact-block {
            margin-bottom: 20px;
        }
        .fc-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
            font-size: 13px;
            color: #9ca9a4;
        }
        .fc-item i {
            color: #ffd700;
            font-size: 16px;
            margin-top: 2px;
        }
        .fc-item a {
            color: #9ca9a4;
            text-decoration: none;
            transition: color 0.2s;
        }
        .fc-item a:hover { color: #ffd700; }

        /* Social Icons */
        .social-icons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .social-icon {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 16px;
            transition: all 0.2s;
        }
        .social-icon:hover {
            background: #ffd700;
            color: #013220;
            transform: translateY(-3px);
        }

        /* WhatsApp CTA */
        .whatsapp-cta {
            margin-top: 16px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            background: #25D366;
            color: #fff !important;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.2s;
        }
        .whatsapp-cta i { font-size: 24px; }
        .whatsapp-cta:hover { background: #128C7E; transform: translateY(-2px); color: #fff !important; }

        /* Payment Methods */
        .payment-methods-strip {
            border-top: 1px solid rgba(255,255,255,0.1);
            margin-top: 40px;
            padding-top: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: space-between;
        }
        .payment-label {
            color: #9ca9a4;
            font-size: 13px;
            font-weight: 600;
        }
        .payment-icons { display: flex; gap: 10px; flex-wrap: wrap; }
        .pay-badge {
            background: rgba(255,255,255,0.08);
            color: #cbd5d1;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* ============ Bottom Bar ============ */
        .site-footer {
            background: #081510;
            color: #9ca9a4;
            padding: 20px 0;
            font-size: 13px;
        }
        .site-footer .copyright { padding: 4px 0; }
        .site-footer .legal-links { text-align: end; }
        .site-footer .legal-links a {
            color: #9ca9a4;
            text-decoration: none;
            margin-inline-start: 18px;
            transition: color 0.2s;
        }
        .site-footer .legal-links a:hover { color: #ffd700; }

        @@media (max-width: 768px) {
            .site-footer .legal-links { text-align: start; margin-top: 10px; }
            .site-footer .legal-links a { margin-inline-start: 0; margin-inline-end: 14px; }
            .newsletter-form { min-width: 100%; }
        }

        /* ============ Floating WhatsApp Button ============ */
        .whatsapp-float {
            position: fixed;
            bottom: 25px;
            inset-inline-end: 25px;
            width: 58px; height: 58px;
            background: #25D366;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
            z-index: 999;
            transition: all 0.3s;
            animation: pulse-whatsapp 2s infinite;
        }
        .whatsapp-float:hover {
            transform: scale(1.1);
            color: #fff;
            background: #128C7E;
        }
        @@keyframes pulse-whatsapp {
            0% { box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 0 0 0 rgba(37, 211, 102, 0.7); }
            70% { box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 0 0 15px rgba(37, 211, 102, 0); }
            100% { box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 0 0 0 rgba(37, 211, 102, 0); }
        }
    </style>


    <!-- Custom JS -->
    <script>

            // Highlight current page in navigation
            document.addEventListener('DOMContentLoaded', function() {
                const currentPath = window.location.pathname.toLowerCase();

                // Check main navigation
                document.querySelectorAll('.nav-link-custom').forEach(link => {
                    const href = link.getAttribute('href').toLowerCase();
                    if (currentPath.includes(href.split('/').pop())) {
                        link.style.color = 'var(--accent-color)';
                        link.style.fontWeight = '600';
                    }
                });

                // Check footer navigation
                document.querySelectorAll('.nav-list a').forEach(link => {
                    const href = link.getAttribute('href').toLowerCase();
                    if (currentPath.includes(href.split('/').pop())) {
                        link.style.color = 'var(--primary-color)';
                        link.style.fontWeight = '600';
                    }
                });
            });



            // للكارت 
            document.addEventListener('DOMContentLoaded', function() {
                // نتحقق إذا كان المستخدم مسجل دخول
                if ("@User.Identity.IsAuthenticated" === "True") {
                    updateCartCount();
                }

                function updateCartCount() {
                    fetch('/Customer/Cart/GetCartCount')
                        .then(response => response.json())
                        .then(data => {
                            const badge = document.getElementById('cartBadge');
                            if (badge) {
                                badge.textContent = data.count;
                                // إذا كانت السلة فيها منتجات، نظهر الدائرة، وإذا كانت 0 نخفيها
                                if (data.count > 0) {
                                    badge.classList.remove('d-none');
                                } else {
                                    badge.classList.add('d-none');
                                }
                            }
                        })
                        .catch(error => console.error('Error fetching cart count:', error));
                }
            });



    </script>
    


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

