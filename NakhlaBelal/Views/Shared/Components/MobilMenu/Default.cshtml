@model MobilMenuViewModel
@using Microsoft.Extensions.Localization
@using NakhlaBelal
@inject IStringLocalizer<SharedResource> SharedLocalizer

<li class="has-child">
    <a href="#"><span>@SharedLocalizer["ByType"]</span><i class="ri-arrow-right-s-line"></i></a>
    <ul>
        <li class="back">
            <a href="#"><i class="ri-arrow-left-s-line"></i><span>@SharedLocalizer["ByType"]</span></a>
        </li>
        @foreach (var type in Model.FabricTypes)
        {
            <li><a asp-controller="Home" asp-action="CategroySearch" asp-route-FabricTypeId="@type.Id">@SharedLocalizer[@type.Name]</a></li>
        }
    </ul>
</li>

