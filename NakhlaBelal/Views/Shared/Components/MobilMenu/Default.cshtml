@model MobilMenuViewModel

<li class="has-child">
    <a href="#"><span>By Type</span><i class="ri-arrow-right-s-line"></i></a>
    <ul>
        <li class="back">
            <a href="#"><i class="ri-arrow-left-s-line"></i><span>By Type</span></a>
        </li>
        @foreach (var type in Model.FabricTypes)
        {
            <li><a asp-controller="Home" asp-action="CategroySearch" asp-route-FabricTypeId="@type.Id">@type.Name</a></li>
        }
    </ul>
</li>

<li class="has-child">
    <a href="#"><span>By Project</span><i class="ri-arrow-right-s-line"></i></a>
