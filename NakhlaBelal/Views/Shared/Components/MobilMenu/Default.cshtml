        <li class="back">
            <a href="#"><i class="ri-arrow-left-s-line"></i><span>By Project</span></a>
        </li>
        @foreach (var project in Model.ProjectCategories)
        {
            <li><a asp-controller="Home" asp-action="CategroySearch" asp-route-ProjectCategoryId="@project.Id">@project.Name</a></li>
        }
    </ul>
</li>

<li class="has-child">
    <a href="#"><span>By Color</span><i class="ri-arrow-right-s-line"></i></a>
