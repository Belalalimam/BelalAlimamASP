@using System.Security.Claims
@inject NakhlaBelal.Utitlies.INotificationService NotificationService
@{
    var _currentUserId = User?.FindFirstValue(ClaimTypes.NameIdentifier);
    var _unreadNotifCount = 0;
    IEnumerable<NakhlaBelal.Models.Notification> _recentNotifs = Array.Empty<NakhlaBelal.Models.Notification>();
    if (!string.IsNullOrEmpty(_currentUserId))
    {
        try
        {
            _unreadNotifCount = await NotificationService.GetUnreadCountAsync(_currentUserId);
            _recentNotifs = await NotificationService.GetForUserAsync(_currentUserId, take: 8);
        }
        catch { /* تجاهل — ما نكسر اللايوت */ }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewBag.Title - Ecommerce Dashboard</title>
    <link rel="stylesheet" href="~/css/dashboard.css">
        <link rel="stylesheet" href="~/css/custome.css">
            <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script src="https://kit.fontawesome.com/26ef36b519.js" crossorigin="anonymous"></script>
            <link href="https://cdn.jsdelivr.net/npm/remixicon@4.8.0/fonts/remixicon.css" rel="stylesheet" />

            @RenderSection("Styles", required: false)
        </head>
        <body>
            <!-- Mobile Overlay -->
            <div class="mobile-overlay" id="mobileOverlay"></div>

            <!-- Side Navigation -->
            <nav class="side-nav" id="sideNav">
                <div class="nav-header">
                    <div class="logo">NAKHLA</div>
                    <button class="nav-close" id="navClose">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="nav-section">Dashboard</div>
                <a href="@Url.Action("Index", "Dashboard")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Overview</span>
                </a>                    

                <div class="nav-section">Sales</div>
                <a href="@Url.Action("Index", "Orders")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="fas fa-box"></i>
                    <span>Orders</span>
                    <span class="nav-badge">
                        @if (ViewBag.TotalProducts != null)
                        {
                            <span>@ViewBag.TotalProducts</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </span>
                </a>
                <a href="@Url.Action("Index", "Customers")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")">
                    <i class="fas fa-users"></i>
                    <span>Customers</span>
                </a>

                <div class="nav-section">Catalog</div>
                <a href="@Url.Action("Index", "Products")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                    <i class="fas fa-shopping-bag"></i>
                    <span>Products</span>
                </a>
                <a href="@Url.Action("Index", "Categories")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="fas fa-tags"></i>
                    <span>Categories</span>
                </a>
                <a href="@Url.Action("Index", "Brands")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Brands" ? "active" : "")">
                    <i class="fas fa-copyright"></i>
                    <span>Brands</span>
                </a>
                <a href="@Url.Action("Index", "Inventory")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventory" ? "active" : "")">
                    <i class="fas fa-warehouse"></i>
                    <span>Inventory</span>
                </a>

                <div class="nav-section">Financial</div>
                <a href="@Url.Action("Index", "Payments")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")">
                    <i class="fas fa-credit-card"></i>
                    <span>Payments</span>
                </a>
                <a href="@Url.Action("Index", "Transactions")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Transactions</span>
                </a>

                <div class="nav-section">System</div>
                <a href="@Url.Action("Index", "Users")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="fas fa-user-cog"></i>
                    <span>Users</span>
                </a>
                <a href="@Url.Action("Index", "Notifications")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
                    <i class="fas fa-bell"></i>
                    <span>Notifications</span>
                    @if (_unreadNotifCount > 0)
                    {
                        <span class="nav-badge"><span>@_unreadNotifCount</span></span>
                    }
                </a>
                <a href="@Url.Action("Index", "Settings")" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </nav>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Top Navigation -->
                <header class="top-nav">
                    <div class="top-nav-left">
                        <button class="nav-toggle" id="navToggle">
                            <i class="fas fa-bars"></i>
                        </button>
                        <h1>@ViewBag.PageTitle</h1>
                        @if (!string.IsNullOrEmpty(ViewBag.Subtitle))
                        {
                            <span class="page-subtitle">@ViewBag.Subtitle</span>
                        }
                    </div>
                    <div class="top-nav-right">
                        <div class="search-bar">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Search..." id="globalSearch">
                            <div class="search-loader" style="display: none;">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </div>

                        <div class="notifications" id="notifBell" style="position:relative; cursor:pointer;">
                            <i class="fas fa-bell"></i>
                            <span class="notification-count" id="notifCount" style="@(_unreadNotifCount == 0 ? "display:none;" : "")">@_unreadNotifCount</span>

                            <div id="notifDropdown" style="display:none; position:absolute; right:0; top:40px; width:340px; max-height:420px; overflow:auto; background:#fff; border:1px solid #e5e7eb; border-radius:8px; box-shadow:0 10px 25px rgba(0,0,0,.08); z-index:1050;">
                                <div style="padding:10px 14px; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center;">
                                    <strong>Notifications</strong>
                                    <form asp-area="Admin" asp-controller="Notifications" asp-action="MarkAllRead" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-link p-0">Mark all read</button>
                                    </form>
                                </div>
                                @if (!_recentNotifs.Any())
                                {
                                    <div style="padding:16px; text-align:center; color:#777;">No notifications</div>
                                }
                                else
                                {
                                    foreach (var n in _recentNotifs)
                                    {
                                        <a href="@Url.Action("Open", "Notifications", new { area = "Admin", id = n.Id })"
                                           style="display:block; padding:10px 14px; border-bottom:1px solid #f2f2f2; color:inherit; text-decoration:none; @(n.IsRead ? "" : "background:#f5f9ff;")">
                                            <div style="font-weight:@(n.IsRead ? "400" : "600"); font-size:13px;">@n.Title</div>
                                            <div style="color:#666; font-size:12px; margin-top:2px;">@n.Message</div>
                                            <div style="color:#999; font-size:11px; margin-top:2px;">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                        </a>
                                    }
                                }
                                <div style="padding:8px 14px; border-top:1px solid #eee; text-align:center;">
                                    <a asp-area="Admin" asp-controller="Notifications" asp-action="Index">View all</a>
                                </div>
                            </div>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="user-profile" id="userProfile">
                            <div class="user-avatar">AD</div>
                            <span class="username-text">Admin</span>
                            <i class="fas fa-chevron-down"></i>

                            <div class="user-dropdown" id="userDropdown" style="display: none;">
                                <a href="@Url.Action("Profile", "Account")" class="dropdown-item">
                                    <i class="fas fa-user"></i> My Profile
                                </a>
                                <a href="@Url.Action("Index", "Settings")" class="dropdown-item">
                                    <i class="fas fa-cog"></i> Settings
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="@Url.Action("Logout", "Account", new { area = "Identity" })" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Content Area -->
                <div class="content-area">
                    @RenderBody()
                </div>
            </div>

            <!-- Universal Modal -->
            <div class="modal" id="universalModal" style="display: none;">
                <div class="modal-content" id="modalContent">
                    <!-- Modal content will be loaded here -->
                </div>
            </div>

            <!-- Confirmation Modal -->
            <div class="modal" id="confirmModal" style="display: none;">
                <div class="modal-content" style="max-width: 400px;">
                    <div class="modal-header">
                        <h3 id="confirmTitle">Confirm Action</h3>
                        <button class="modal-close" onclick="closeConfirmModal()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmMessage">Are you sure you want to perform this action?</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
                        <button class="btn btn-danger" id="confirmActionBtn">Confirm</button>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                // نتحقق إذا كان المستخدم مسجل دخول
                if ("@User.Identity.IsAuthenticated" === "True") {
                updateCartCount();
                }

                function updateCartCount() {
                fetch('/Admin/orders/index')
                .then(response => response.json())
                .then(data => {
                const badge = document.getElementById('OrderBadge');
                if (badge) {
                badge.textContent = data.count;
                // إذا كانت السلة فيها منتجات، نظهر الدائرة، وإذا كانت 0 نخفيها
                if (data.count > 0) {
                badge.classList.remove('d-none');
                } else {
                badge.classList.add('d-none');
                }
                }
                })
                .catch(error => console.error('Error fetching cart count:', error));
                }
                });</script>
                <script>
                    (function () {
                        var bell = document.getElementById('notifBell');
                        var dd = document.getElementById('notifDropdown');
                        var countEl = document.getElementById('notifCount');
                        if (!bell || !dd) return;

                        bell.addEventListener('click', function (e) {
                            if (e.target.closest('#notifDropdown')) return;
                            dd.style.display = (dd.style.display === 'none' || !dd.style.display) ? 'block' : 'none';
                            e.stopPropagation();
                        });
                        document.addEventListener('click', function (e) {
                            if (!bell.contains(e.target)) dd.style.display = 'none';
                        });

                        // Poll unread count every 30s
                        function refreshCount() {
                            fetch('/Admin/Notifications/UnreadCount', { credentials: 'same-origin' })
                                .then(r => r.ok ? r.json() : null)
                                .then(d => {
                                    if (!d || !countEl) return;
                                    if (d.count > 0) {
                                        countEl.textContent = d.count;
                                        countEl.style.display = '';
                                    } else {
                                        countEl.style.display = 'none';
                                    }
                                })
                                .catch(() => { });
                        }
                        setInterval(refreshCount, 30000);
                    })();
                </script>
                <script src="~/js/dashboard.js"></script>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                @RenderSection("Scripts", required: false)
            </body>
        </html>